import argparse
import sys
from pathlib import Path

import pandas as pd

import perf
from perf.data import (
    _aliases as _data_aliases,
)
from perf.data import (
    _filter_list_df,
    _list_patterns,
    _resolve_list_columns,
    emit_output,
    format_trace_table,
    has_output,
    metadata_from_frame,
    perfconfig_entries,
    show_table,
    split_after_dashes,
)
from perf.data import (
    _known as _data_known,
)
from perf.data import (
    apply_perfconfig as _data_apply,
)
from perf.prof import _DEFAULT_BUFFER_SIZE, profile

_COMMAND = "profile"
_DOTTED_KEYS = ()


def apply_perfconfig(parser, argv, config_path=None):
    return _data_apply(
        parser,
        argv,
        _COMMAND,
        config_path,
        dotted_keys=_DOTTED_KEYS,
    )


def _config_entries(path=None):
    return perfconfig_entries(_COMMAND, path)


def _known(parser, key):
    return _data_known(parser, key, _DOTTED_KEYS)


def _aliases(parser, key):
    return _data_aliases(parser, key, _DOTTED_KEYS)


def main(args):
    cmd = list(getattr(args, "paths", None) or []) or [
        a for a in (getattr(args, "command", None) or []) if a != "--"
    ]
    if getattr(args, "list_targets", False):
        _list_targets(args, cmd)
        return
    if not cmd:
        raise SystemExit("perf profile needs a command, e.g. `perf profile -- ./a.out`")
    out = getattr(args, "output", None)
    try:
        raw = getattr(args, "buffer_size", 65536)
        slots = 65536 if raw is None else int(raw)
    except (TypeError, ValueError):
        raise SystemExit("--buffer-size must be an integer")
    if slots <= 0:
        raise SystemExit("--buffer-size must be > 0")
    raw_filter = getattr(args, "filter", None)
    if raw_filter is None or not str(raw_filter).strip():
        raise SystemExit(
            "perf profile requires --filter, e.g. "
            "`perf profile --filter main -- ./a.out`"
        )
    try:
        df = profile(
            cmd,
            event=getattr(args, "event", None),
            filter=_filter(raw_filter),
            output=out,
            buffer_size=slots,
            output_template=getattr(args, "_output_template", None),
        )
    except (ValueError, TypeError) as ex:
        raise SystemExit(str(ex))
    except KeyboardInterrupt:
        print("perf profile interrupted (partial results dumped)", file=sys.stderr)
        raise SystemExit(130)
    if show_table(out, bool(getattr(args, "_output_from_config", False))):
        print(format_trace_table(df))
    else:
        saved = list((getattr(df, "attrs", {}) or {}).get("output_paths", []) or [])
        if saved:
            print(
                f"tracked {len(df)} samples -> {saved[-1]}", file=sys.stderr, flush=True
            )


def _is_numeric(df, column):
    try:
        if pd.api.types.is_bool_dtype(df[column]):
            return False
    except Exception:
        pass
    try:
        return bool(pd.api.types.is_numeric_dtype(df[column]))
    except Exception:
        return False


def _filter(targ):
    if targ is None:
        return None
    out = []
    for f in targ if isinstance(targ, (list, tuple)) else [targ]:
        if f is None:
            continue
        if isinstance(f, (list, tuple)):
            parts = [str(x).strip() if x is not None else "" for x in f]
            if len(parts) != 2 or not all(parts):
                raise SystemExit(
                    f"invalid --filter {f!r}; expected 'name' or 'begin..end'"
                )
            out.append((parts[0], parts[1]))
            continue
        s = str(f).strip()
        if not s:
            continue
        if ".." in s:
            begin, _, end = s.partition("..")
            begin, end = begin.strip(), end.strip()
            if not begin or not end:
                raise SystemExit(
                    f"invalid --filter {f!r}; expected 'name' or 'begin..end'"
                )
            out.append((begin, end))
        else:
            out.append(s)
    return out or None


def _list_targets(args, cmd):
    if not cmd:
        raise SystemExit(
            "perf profile --list needs a command, e.g. `perf profile --list -- ./a.out`"
        )
    exe = str(cmd[0])
    if not Path(exe).exists():
        raise SystemExit(f"file {exe!r} does not exist")
    try:
        df = perf.info.metadata(exe)
    except FileNotFoundError:
        raise SystemExit(f"file {exe!r} does not exist")
    except SystemExit:
        raise
    except Exception as ex:
        raise SystemExit(str(ex).splitlines()[0] or f"cannot inspect {exe!r}")
    try:
        raw_targets = _filter(getattr(args, "filter", None))
    except SystemExit:
        raise
    except Exception as ex:
        raise SystemExit(str(ex))
    df = _filter_list_df(df, _list_patterns(raw_targets))
    df = _resolve_list_columns(df, getattr(args, "event", None), strict=False)
    if has_output(getattr(args, "output", None)):
        emit_output(
            args.output,
            df.to_dict(orient="records"),
            values=metadata_from_frame(df, command="profile"),
            template=getattr(args, "_output_template", None),
        )
    if show_table(
        getattr(args, "output", None),
        bool(getattr(args, "_output_from_config", False)),
    ):
        print(format_trace_table(perf.info.hex_addresses(df)))


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf profile",
        description="trace labels/functions with startup-only ptrace + native rdpmc",
    )
    parser.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="events to count via rdpmc, e.g. -e cycles,branch-misses (default: "
        "cycles; duration_time uses rdtsc; a wildcard/regex expands to every "
        "matching event, e.g. 'topdown-*' with the slots leader added "
        "automatically)",
    )
    parser.add_argument(
        "-f",
        "--filter",
        dest="filter",
        action="append",
        default=None,
        help="track these symbols (repeatable, required unless --list): "
        "PERF_LABEL names, function names (entry/exit via return-address "
        "interception, e.g. -f fizz_buzz), hex addresses, or begin..end "
        "regions (sides may mix)",
    )
    parser.add_argument(
        "-o",
        "--output",
        dest="output",
        action="append",
        nargs="?",
        const=True,
        default=None,
        metavar="FILE",
        help="write the JSON envelope to FILE, or to stdout when no FILE is given; "
        "repeat to write several destinations; a directory (or a path ending in /) "
        "uses the output template (default {time}-{command}-{target}-{id}.json, "
        "override in .perfconfig)",
    )
    parser.add_argument(
        "--buffer-size",
        dest="buffer_size",
        type=int,
        default=_DEFAULT_BUFFER_SIZE,
        help="ring-buffer size in slots, rounded up to a power of two "
        f"(default: {_DEFAULT_BUFFER_SIZE})",
    )
    parser.add_argument(
        "--list",
        dest="list_targets",
        action="store_true",
        help="list available symbols instead of profiling: `perf profile --list "
        "-- ./a.out` lists all, `-f foo --list` filters by regex `foo`",
    )
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args, _unknown = _parser.parse_known_args(apply_perfconfig(_parser, _options))
    if _unknown:
        _parser.error(f"unknown argument: {_unknown[0]}")
    _args.paths = _paths
    main(_args)
