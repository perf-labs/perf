import argparse
import configparser
import sys
from pathlib import Path

import pandas as pd

import perf
from perf.core import one_line
from perf.prof import _DEFAULT_OUTPUT, profile

_COMMAND = "profile"
_PERFCONFIG = ".perfconfig"
_PERFCONFIG_COMMENTS = ("#", ";")
_DOTTED_KEYS = ()


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.groupby("name").cycles.describe()
    %notebook session.ipynb""")

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def _is_numeric(df, column):
    try:
        if pd.api.types.is_bool_dtype(df[column]):
            return False
    except Exception:
        pass
    try:
        return bool(pd.api.types.is_numeric_dtype(df[column]))
    except Exception:
        return False


def _cell(value):
    if value is None or (
        not isinstance(value, (list, tuple, dict, set)) and pd.isna(value)
    ):
        return ""
    return one_line(value)


def json_target(args):
    v = getattr(args, "json", False)
    if v is False or v is None:
        return False, None
    if v is True:
        return True, None
    s = str(v).strip()
    if not s:
        return True, None
    low = s.lower()
    if low in ("-", "true", "1", "yes", "on"):
        return True, None
    if low in ("false", "0", "no", "off"):
        return False, None
    return True, s


def want_json(args):
    return bool(json_target(args)[0])


def json_path(args):
    return json_target(args)[1]


def emit_json_text(text, path):
    if path is None:
        print(text, flush=True)
        return
    from pathlib import Path as _P

    dest = _P(str(path))
    try:
        parent = dest.parent
        if str(parent) not in ("", "."):
            parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(text + ("" if text.endswith("\n") else "\n"))
    except OSError as ex:
        raise SystemExit(f"cannot write --json file {path!r}: {ex}")


def format_trace_table(df):
    if df is None or not len(df.columns):
        return ""
    columns = list(df.columns)
    cells = {c: [_cell(v) for v in df[c].tolist()] for c in columns}
    numeric = {c: _is_numeric(df, c) for c in columns}
    widths = {c: max([len(str(c))] + [len(s) for s in cells[c]]) for c in columns}
    lines = [
        "  ".join(
            str(c).rjust(widths[c]) if numeric[c] else str(c).ljust(widths[c])
            for c in columns
        ).rstrip()
    ]
    for i in range(len(df)):
        lines.append(
            "  ".join(
                cells[c][i].rjust(widths[c])
                if numeric[c]
                else cells[c][i].ljust(widths[c])
                for c in columns
            ).rstrip()
        )
    return "\n".join(lines)


def _perfconfig_path():
    try:
        current = Path.cwd().resolve()
        home = Path.home().resolve()
    except OSError:
        return None
    while True:
        candidate = current / _PERFCONFIG
        try:
            if candidate.is_file():
                return candidate
        except OSError:
            pass
        if current == home or current.parent == current:
            return None
        current = current.parent


def _config_entries(path=None):
    path = Path(path) if path is not None else _perfconfig_path()
    if path is None or not path.is_file():
        return {}
    parser = configparser.ConfigParser(
        interpolation=None,
        strict=False,
        comment_prefixes=_PERFCONFIG_COMMENTS,
        inline_comment_prefixes=_PERFCONFIG_COMMENTS,
    )
    try:
        with open(path, encoding="utf-8") as fh:
            parser.read_file(fh, source=str(path))
    except (configparser.Error, UnicodeDecodeError, OSError):
        return {}
    entries = {}
    for section in ("default", _COMMAND):
        if not parser.has_section(section):
            continue
        for key, value in parser.items(section):
            if key.strip() and value.strip():
                entries[key] = value.strip()
    return entries


def _known(parser, key):
    if key.startswith(_DOTTED_KEYS):
        return True
    return any(
        action.dest == key or key in {o.lstrip("-") for o in action.option_strings}
        for action in parser._actions
    )


def _aliases(parser, key):
    if key.startswith(_DOTTED_KEYS):
        return {key}
    aliases = {key}
    for action in parser._actions:
        if action.dest == key:
            aliases |= {o.lstrip("-") for o in action.option_strings}
    return aliases


def _flag_only(parser, key):
    return any(
        action.dest == key
        and isinstance(action, (argparse._StoreTrueAction, argparse._StoreFalseAction))
        for action in parser._actions
    )


def _given(argv):
    given = set()
    for arg in argv:
        if arg == "--":
            break
        if arg.startswith("--"):
            given.add(arg[2:].split("=", 1)[0])
        elif arg.startswith("-") and len(arg) > 1:
            given.add(arg[:2].lstrip("-"))
    return given


def _truthy(value):
    text = str(value).strip().lower()
    if text in ("1", "true", "yes", "on"):
        return True
    if text in ("0", "false", "no", "off"):
        return False
    return None


def apply_perfconfig(parser, argv, config_path=None):
    entries = _config_entries(config_path)
    if not entries:
        return list(argv)
    given = _given(argv)
    pending = []
    for key, value in entries.items():
        if not _known(parser, key) or _aliases(parser, key) & given:
            continue
        if key == "json":
            on = _truthy(value)
            if on is True:
                pending.append("--json")
            elif on is False:
                continue
            else:
                pending.append(f"--json={value}")
            continue
        if _flag_only(parser, key):
            on = _truthy(value)
            if on is None:
                parser.error(
                    f"invalid [{_COMMAND}] {key} = {value!r}; expected a boolean "
                    "(true/false)"
                )
            if on:
                pending.append(f"--{key}")
            continue
        pending.append(f"--{key}={value}")
    return pending + list(argv)


def split_after_dashes(argv):
    if "--" in argv:
        sep = argv.index("--")
        return list(argv[:sep]), list(argv[sep + 1 :])
    return list(argv), []


def _target(targ):
    if targ is None:
        return None
    out = []
    for f in targ if isinstance(targ, (list, tuple)) else [targ]:
        if f is None:
            continue
        if isinstance(f, (list, tuple)):
            parts = [str(x).strip() if x is not None else "" for x in f]
            if len(parts) != 2 or not all(parts):
                raise SystemExit(
                    f"invalid --target {f!r}; expected 'name' or 'begin..end'"
                )
            out.append((parts[0], parts[1]))
            continue
        s = str(f).strip()
        if not s:
            continue
        if ".." in s:
            begin, _, end = s.partition("..")
            begin, end = begin.strip(), end.strip()
            if not begin or not end:
                raise SystemExit(
                    f"invalid --target {f!r}; expected 'name' or 'begin..end'"
                )
            out.append((begin, end))
        else:
            out.append(s)
    return out or None


def _filter(filt):
    return _target(filt)


def main(args):
    cmd = list(getattr(args, "paths", None) or []) or [
        a for a in (getattr(args, "command", None) or []) if a != "--"
    ]
    if not cmd:
        raise SystemExit("perf profile needs a command, e.g. `perf profile -- ./a.out`")
    out = getattr(args, "output", _DEFAULT_OUTPUT)
    if out in ("", "none", "None"):
        out = None
    try:
        raw = getattr(args, "buffer_size", 65536)
        slots = 65536 if raw is None else int(raw)
    except (TypeError, ValueError):
        raise SystemExit("--buffer-size must be an integer")
    if slots <= 0:
        raise SystemExit("--buffer-size must be > 0")
    raw_target = getattr(args, "target", None)
    raw_filter = getattr(args, "filter", None)
    if raw_target is not None and raw_filter is not None:
        raise SystemExit("pass --target, not both --target and --filter")
    if raw_target is None:
        raw_target = raw_filter
    try:
        df = profile(
            cmd,
            event=getattr(args, "event", None),
            target=_target(raw_target),
            output=out,
            buffer_size=slots,
        )
    except ValueError as ex:
        raise SystemExit(str(ex))
    except KeyboardInterrupt:
        print("perf profile interrupted (partial results dumped)", file=sys.stderr)
        raise SystemExit(130)
    if want_json(args):
        import json as _json

        emit_json_text(
            _json.dumps(df.to_dict(orient="records"), indent=4, default=str),
            json_path(args),
        )
    elif out is None:
        print(format_trace_table(df))
    else:
        print(f"tracked {len(df)} samples -> {out}", file=sys.stderr, flush=True)
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf profile",
        description="trace labels/functions with startup-only ptrace + native rdpmc",
    )
    parser.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="events to count via rdpmc, e.g. -e cycles,branch-misses (default: "
        "cycles; duration_time uses rdtsc; a wildcard/regex expands to every "
        "matching event, e.g. 'topdown-*' with the slots leader added "
        "automatically)",
    )
    parser.add_argument(
        "-t",
        "--target",
        dest="target",
        action="append",
        default=None,
        help="only track these targets (repeatable): PERF_LABEL names, "
        "function names (entry/exit via return-address "
        "interception, e.g. -t fizz_buzz), hex addresses, or begin..end "
        "regions (sides may mix); default: main",
    )
    parser.add_argument(
        "-f",
        "--filter",
        dest="filter",
        action="append",
        default=None,
        help="deprecated alias for --target",
    )
    parser.add_argument(
        "-o",
        "--output",
        dest="output",
        default="profile.json",
        help="JSON output path (default: profile.json; pass 'none' to skip saving)",
    )
    parser.add_argument(
        "--buffer-size",
        dest="buffer_size",
        type=int,
        default=65536,
        help="ring-buffer size in slots, rounded up to a power of two (default: 65536)",
    )
    parser.add_argument(
        "--json",
        dest="json",
        nargs="?",
        const=True,
        default=False,
        metavar="FILE",
        help="also emit the trace as JSON records to stdout, or to FILE when a "
        "path is given (e.g. `--json out.json`)",
    )
    parser.add_argument("-i", "--interactive", action="store_true")
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args, _unknown = _parser.parse_known_args(apply_perfconfig(_parser, _options))
    if _unknown:
        _parser.error(f"unknown argument: {_unknown[0]}")
    _args.paths = _paths
    main(_args)
