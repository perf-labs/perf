import argparse
import math
import sys

import pandas as pd

import perf
from perf.comp import _DEFAULT_ALPHA, _detect_variant, compare
from perf.data import (
    _SOURCE_COL,
    apply_filter,
    derived_metrics,
    emit_output,
    eval_events,
    format_duration,
    format_number,
    has_output,
    is_duration_col,
    metadata_from_frame,
    metric_columns,
    parse,
    perfconfig_entries,
    show_table,
    split_after_dashes,
    split_spec,
    stdin_is_pipe,
    to_float,
)
from perf.data import (
    _aliases as _data_aliases,
)
from perf.data import (
    _known as _data_known,
)
from perf.data import (
    apply_perfconfig as _data_apply,
)
from perf.data import (
    load as _data_load,
)
from perf.data import table_to_df as table_to_df

_COMMAND = "compare"
_DOTTED_KEYS = ()


def apply_perfconfig(parser, argv, config_path=None):
    return _data_apply(
        parser,
        argv,
        _COMMAND,
        config_path,
        dotted_keys=_DOTTED_KEYS,
    )


def load(args, stdin=True):
    return _data_load(args, stdin, parse_fn=parse)


def _config_entries(path=None):
    return perfconfig_entries(_COMMAND, path)


def _known(parser, key):
    return _data_known(parser, key, _DOTTED_KEYS)


def _aliases(parser, key):
    return _data_aliases(parser, key, _DOTTED_KEYS)


def embed(ns):
    def help(_line=None):
        print("""
    df
    df[df.significant]
    %notebook session.ipynb""")

    import sys

    if not getattr(sys.stdin, "isatty", lambda: False)():
        try:
            sys.stdin = open("/dev/tty")
        except Exception:
            pass

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def is_finite_number(value):
    return to_float(value) is not None


def main(args):
    args.data = getattr(args, "paths", None) or getattr(args, "data", None) or []
    if not args.data and not stdin_is_pipe():
        args.data = ["."]
    try:
        raw_alpha = getattr(args, "alpha", None)
        alpha = _DEFAULT_ALPHA if raw_alpha is None else float(raw_alpha)
    except (TypeError, ValueError):
        raise SystemExit("--alpha must be a float in (0, 1)")
    if not 0.0 < alpha < 1.0:
        raise SystemExit("--alpha must be in (0, 1)")
    df = perf.bench._as_records(load(args))
    if "name" not in df.columns and "sym" in df.columns:
        df = df.copy()
        df["name"] = df["sym"].astype(str)
        if "mode" not in df.columns:
            df["mode"] = "record"
    df = apply_filter(df, getattr(args, "filter", None))
    if "name" not in df.columns:
        raise SystemExit("cannot compare: no benchmark names ('name'/'sym') in data")
    requested = split_spec(args.event)
    if not requested:
        requested = _per_operation(df)
    if not requested and "sym" in df.columns:
        requested = [c for c in metric_columns(df) if c not in ("pid", "ip")] or None
    df, events = eval_events(df, requested)
    try:
        out = compare(
            df,
            event=events,
            baseline=getattr(args, "baseline", None),
            alpha=alpha,
            variant=_compare_variant(df),
        )
    except ValueError as ex:
        raise SystemExit(str(ex))
    if has_output(getattr(args, "output", None)):
        emit_output(
            args.output,
            out.to_dict(orient="records"),
            values=metadata_from_frame(out, command="compare"),
            template=getattr(args, "_output_template", None),
        )
    if show_table(
        getattr(args, "output", None),
        bool(getattr(args, "_output_from_config", False)),
    ):
        print(_format_cmp_table(out).to_string(index=False))
    if args.interactive:
        embed({"perf": perf, "df": out})


def _format_data_value(value):
    try:
        if pd.isna(value):
            return ""
    except Exception:
        pass
    if value is None:
        return ""
    if isinstance(value, (list, tuple)):
        try:
            return str(list(value))
        except Exception:
            return str(value)
    if isinstance(value, float):
        try:
            if math.isfinite(value) and float(value).is_integer():
                return str(int(value))
        except Exception:
            pass
        return str(value)
    try:
        import numpy as _np

        if isinstance(value, _np.integer):
            return str(int(value))
        if isinstance(value, _np.floating):
            try:
                f = float(value)
                if math.isfinite(f) and f.is_integer():
                    return str(int(f))
            except Exception:
                pass
            return str(value)
    except Exception:
        pass
    return str(value)


def _compare_variant(df):
    return _detect_variant(df, _SOURCE_COL)


def _format_p_value(value):
    number = to_float(value)
    if number is None:
        try:
            float(value)
            return ""
        except (TypeError, ValueError):
            return str(value)
    return f"{number:.2e}" if number < 0.001 else f"{number:.4f}"


def _format_cmp_table(df):
    out = df.copy()
    try:
        sig = (
            [bool(v) for v in out["significant"].tolist()]
            if "significant" in out.columns
            else None
        )
    except Exception:
        sig = None
    try:
        out = out.drop(columns=["significant"])
    except Exception:
        pass
    for c in out.columns:
        if c in ("event", "baseline", "challenger", "name", "mode"):
            continue
        if str(c).startswith("data."):
            out[c] = [_format_data_value(v) for v in out[c]]
            continue
        if c == "p_value":
            out[c] = [_format_p_value(v) for v in out[c]]
        elif c == "diff":
            vals = out[c].tolist()
            shown = []
            for i, v in enumerate(vals):
                try:
                    s = bool(sig[i]) if sig is not None and i < len(sig) else True
                except Exception:
                    s = True
                if not s:
                    shown.append("-")
                elif is_finite_number(v):
                    shown.append(f"{float(v):+.2f}%")
                else:
                    shown.append("")
            out[c] = shown
        elif c in ("ci_low", "ci_high"):
            out[c] = [
                f"{float(v):+.2f}%" if is_finite_number(v) else "" for v in out[c]
            ]
        elif is_duration_col(c):
            out[c] = [format_duration(v) for v in out[c]]
        else:
            try:
                if pd.api.types.is_numeric_dtype(out[c]):
                    out[c] = [format_number(v) for v in out[c]]
            except Exception:
                pass
    try:
        out = out.where(pd.notna(out), "")
    except Exception:
        pass
    return out


def _per_operation(df):
    try:
        derived = derived_metrics(df)
    except Exception:
        return None
    try:
        import pandas as _pd

        if "threads" not in df.columns:
            per_thread = False
        else:
            threads = _pd.to_numeric(df["threads"], errors="coerce")
            clean = threads.dropna()
            per_thread = bool(len(clean) and bool((clean != 1).any()))
    except Exception:
        per_thread = False
    if per_thread:
        threaded = [d for d in derived if str(d).endswith("/operations/threads")]
        if threaded:
            return threaded
        threaded = [d for d in derived if str(d).endswith("/threads")]
        if threaded:
            return threaded
    return [d for d in derived if str(d).endswith("/operations")] or None


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf compare",
        description="compare benchmark names via a CLT null-hypothesis test "
        "(stdin or -- data paths)",
    )
    parser.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="columns/expressions to compare (default: every measured event per "
        "operation, e.g. cycles/operations, as the raw totals of two runs are "
        "always different)",
    )
    parser.add_argument(
        "-f",
        "--filter",
        dest="filter",
        default=None,
        help="pandas query filter for rows, e.g. --filter 'name == \"fizz_buzz\"'",
    )
    parser.add_argument(
        "-b",
        "--baseline",
        dest="baseline",
        default=None,
        help="baseline name others are compared against (default: first sorted)",
    )
    parser.add_argument(
        "--alpha",
        dest="alpha",
        type=float,
        default=_DEFAULT_ALPHA,
        help=f"significance level for H0 rejection (default: {_DEFAULT_ALPHA})",
    )
    parser.add_argument(
        "-o",
        "--output",
        dest="output",
        action="append",
        nargs="?",
        const=True,
        default=None,
        metavar="FILE",
        help="write JSON verdict records to FILE, or to stdout when no FILE is "
        "given; repeat --output to write several destinations; a directory (or a "
        "path ending in /) uses the output template (default "
        "{time}-{command}-{target}-{id}.json, override in .perfconfig)",
    )
    parser.add_argument("-i", "--interactive", action="store_true")
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args, _unknown = _parser.parse_known_args(apply_perfconfig(_parser, _options))
    if _unknown:
        _parser.error(f"unknown argument: {_unknown[0]}")
    _args.paths = _paths
    main(_args)
