import argparse
import configparser
import io
import json
import re
import sys
from pathlib import Path

import pandas as pd

import perf
from perf.bench import data_param_value
from perf.core import _DURATION_TIME, _split_groups, _split_list
from perf.data import (
    _IDENTITY_COLUMNS,
    _NON_METRIC_COLUMNS,
    is_record,
    parse,
    query,
    quote_columns,
    spread,
)
from perf.plot import _canonical_data_col

_COMMAND = "plot"
_PERFCONFIG = ".perfconfig"
_PERFCONFIG_COMMENTS = ("#", ";")
_DOTTED_KEYS = ("config.",)
_WILDCARDS = ("*", "?")
_DURATION_SCALE = {"ns": 1.0, "us": 1e3, "ms": 1e6, "s": 1e9}
_DURATION_RE = re.compile(r"^([-+]?(\d+(?:\.\d*)?|\.\d+))(ns|us|ms|s)$")
_TABLE_EMPTY = frozenset({"", "nan", "none", "nat", "null"})
_TABLE_EXTS = frozenset({".txt", ".tsv", ".csv"})
SOURCE_COL = "__source__"
BASELINE_TMP = "__perf_base"
BASELINE_RE = re.compile(
    r"""(['"])(?P<key>.+?)\1\s*\.\s*(?P<metric>[A-Za-z_][A-Za-z0-9_\-]*)"""
)
DEFAULT_GROUPBY = list(_IDENTITY_COLUMNS)


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.cycles
    df.ecdf()
    %notebook session.ipynb""")

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def is_duration_col(column):
    text = str(column)
    return text == _DURATION_TIME or text.startswith(f"{_DURATION_TIME}/")


def json_target(args):
    v = getattr(args, "json", False)
    if v is False or v is None:
        return False, None
    if v is True:
        return True, None
    s = str(v).strip()
    if not s:
        return True, None
    low = s.lower()
    if low in ("-", "true", "1", "yes", "on"):
        return True, None
    if low in ("false", "0", "no", "off"):
        return False, None
    return True, s


def want_json(args):
    return bool(json_target(args)[0])


def json_path(args):
    return json_target(args)[1]


def emit_json_text(text, path):
    if path is None:
        print(text, flush=True)
        return
    dest = Path(str(path))
    try:
        parent = dest.parent
        if str(parent) not in ("", "."):
            parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(text + ("" if text.endswith("\n") else "\n"))
    except OSError as ex:
        raise SystemExit(f"cannot write --json file {path!r}: {ex}")


def metric_columns(df):
    columns = []
    for column in df.columns:
        if (
            str(column).startswith(("data.", "config."))
            or column in _NON_METRIC_COLUMNS
        ):
            continue
        try:
            if pd.api.types.is_numeric_dtype(df[column]):
                columns.append(column)
        except Exception:
            continue
    return columns


def data_columns(df):
    return [c for c in df.columns if str(c).startswith("data.")]


def groups(value, expand=True):
    return _split_groups(value, [_DURATION_TIME], expand=expand)


def _match(pattern, text):
    return (
        re.fullmatch(
            "".join(
                ".*" if c == "*" else "." if c == "?" else re.escape(c)
                for c in str(pattern)
            ),
            str(text),
        )
        is not None
    )


def expand_names(df, names, pool=None):
    names = [str(n) for n in names or []]
    if not any(any(w in n for w in _WILDCARDS) for n in names):
        return names
    columns = [c for c in df.columns if c != SOURCE_COL] if pool is None else list(pool)
    out = []
    for name in names:
        if any(w in name for w in _WILDCARDS):
            found = [c for c in columns if c not in out and _match(name, c)]
            if found:
                out.extend(found)
                continue
        if name not in out:
            out.append(name)
    return out


def derived_metrics(df):
    try:
        numeric = {c: pd.api.types.is_numeric_dtype(df[c]) for c in df.columns}
    except Exception:
        return []
    derived = []
    if numeric.get("operations"):
        for column in metric_columns(df):
            if numeric.get(column):
                derived.append(f"{column}/operations")
    if numeric.get("cycles") and numeric.get("instructions"):
        derived.append("instructions/cycles")
    return derived


def _find_baseline_rows(df, key):
    for column in ("file", "name"):
        if column in df.columns:
            try:
                hit = df[column].astype(str) == key
            except Exception:
                continue
            if bool(hit.any()):
                return df[hit]
    return None


def _baseline_values(df, key, metric):
    base = _find_baseline_rows(df, key)
    if base is None:
        raise ValueError(f"baseline group {key!r} not found in 'file'/'name'")
    if metric not in df.columns:
        raise ValueError(f"baseline metric {metric!r} not found in data")
    if "samples" in df.columns:
        return df["samples"].map(base.groupby("samples")[metric].mean())
    return float(base[metric].mean())


def _inject_baselines(df, expression, counter):
    temps = []

    def _sub(match):
        metric = match.group("metric")
        values = _baseline_values(df, match.group("key"), metric)
        safe = (
            "".join(c if c.isalnum() or c == "_" else "_" for c in metric) or "metric"
        )
        name = f"{BASELINE_TMP}_{safe}_{counter[0]}"
        counter[0] += 1
        while name in df.columns:
            name = f"{name}_"
        df[name] = values
        temps.append(name)
        return name

    try:
        return BASELINE_RE.sub(_sub, expression), temps
    except ValueError:
        for name in temps:
            if name in df.columns:
                del df[name]
        raise


def eval_events(df, events):
    df = df.copy()
    if any(n in (df.index.names or []) for n in _IDENTITY_COLUMNS):
        df = df.reset_index()
    events = (
        expand_names(
            df,
            _split_list(events, expand=False),
            pool=metric_columns(df) + data_columns(df),
        )
        if events is not None
        else []
    )
    events = _split_list(events) or (metric_columns(df) + derived_metrics(df))
    if not events:
        raise SystemExit("no metric columns found in data")
    out, created, counter = [], [], [0]
    for event in events:
        if event in df.columns:
            out.append(event)
            continue
        try:
            rewritten, temps = _inject_baselines(df, event, counter)
            created.extend(temps)
            rewritten = quote_columns(df, rewritten)
        except ValueError as ex:
            print(
                f"Warning: failed to evaluate expression {event!r}: {ex}",
                file=sys.stderr,
            )
            continue
        try:
            df[event] = df.eval(rewritten, engine="python")
            out.append(event)
        except Exception as ex:
            print(
                f"Warning: failed to evaluate expression {event!r}: {ex}",
                file=sys.stderr,
            )
    for name in created:
        if name in df.columns:
            del df[name]
    if not out:
        raise SystemExit("no metric columns found in data")
    return df, out


def apply_filter(df, filter):
    if not filter:
        return df
    try:
        return query(df, filter)
    except Exception as ex:
        raise SystemExit(f"invalid --filter {filter!r}: {ex}")


def _split_seq(text):
    return [y for y in re.split(r"[,\s]+", text.strip()) if y.strip()]


def _unquote(text):
    s = str(text).strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    return s


def _parse_scalar(text):
    s = _unquote(text)
    if s.lower() == "true":
        return True
    if s.lower() == "false":
        return False
    try:
        return int(s, 0)
    except ValueError:
        pass
    try:
        return float(s)
    except ValueError:
        pass
    return s


def _parse_atom(text):
    text = text.strip()
    if text.startswith("{") and text.endswith("}"):
        return parse_value(text)
    if text.startswith("[") and text.endswith("]"):
        return [_parse_atom(y) for y in _split_seq(text[1:-1])]
    if "," in text:
        return [_parse_atom(y) for y in text.split(",") if y.strip()]
    return _parse_scalar(text)


def parse_value(text):
    v = text.strip()
    if v.startswith("{") and v.endswith("}"):
        body = v[1:-1].strip()
        if not body:
            return {}
        out = {}
        for item in body.split(","):
            if ":" not in item:
                raise ValueError(f"invalid dict item: {item!r}")
            key, value = item.split(":", 1)
            out[_unquote(key)] = parse_value(value.strip())
        return out
    if v.startswith("[") and v.endswith("]"):
        return [_parse_atom(x) for x in _split_seq(v[1:-1])]
    if "," in v:
        return [x.strip() for x in v.split(",") if x.strip()]
    if ":" in v and not v.startswith("["):
        key, value = v.split(":", 1)
        return {key.strip(): parse_value(value.strip())}
    return _parse_scalar(v)


def _table_number(text, duration=False):
    if isinstance(text, str) and text.strip().lower() in _TABLE_EMPTY:
        return float("nan")
    if duration:
        match = _DURATION_RE.match(str(text).strip())
        if match:
            return float(match.group(1)) * _DURATION_SCALE[match.group(3)]
    try:
        return float(text)
    except (TypeError, ValueError):
        return text


def _token_spans(text):
    spans, start = [], None
    for i, c in enumerate(text):
        if c.isspace():
            if start is not None:
                spans.append((start, i))
                start = None
        elif start is None:
            start = i
    if start is not None:
        spans.append((start, len(text)))
    return spans


def table_to_df(text):
    lines = str(text).splitlines()
    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    if not lines:
        return pd.DataFrame()
    header = lines[0]
    if "," in header or "\t" in header:
        sep = "\t" if "\t" in header else ","
        try:
            return pd.read_csv(io.StringIO("\n".join(lines)), sep=sep, engine="python")
        except Exception as ex:
            raise ValueError(f"unrecognized perf result table ({ex})")
    tokens = _token_spans(header)
    if not tokens:
        return pd.DataFrame()
    ends = [e for _, e in tokens]
    starts = [0] + [ends[i - 1] + 1 for i in range(1, len(ends))]
    columns = [header[s:e].strip() for s, e in zip(starts, ends)]
    if any(not c for c in columns):
        raise ValueError("unrecognized perf result table")
    rows = [
        [line[s:e].strip() if s < len(line) else "" for s, e in zip(starts, ends)]
        for line in lines[1:]
    ]
    if not rows:
        raise ValueError("perf result table has no rows")
    df = pd.DataFrame({c: [r[i] for r in rows] for i, c in enumerate(columns)})
    for column in df.columns:
        duration = is_duration_col(column)
        df[column] = [_table_number(v, duration) for v in df[column].tolist()]
        try:
            df[column] = pd.to_numeric(df[column], errors="ignore")
        except Exception:
            pass
    return df


def envelope_frame(payload):
    return pd.DataFrame([spread(row) for row in (payload.get("output") or [])])


def merge_envelope_data(payload, df):
    for key in (*_IDENTITY_COLUMNS, "time"):
        if key in payload and key not in df.columns:
            df[key] = payload[key]
    for key in ("data", "config", "info", "id"):
        if payload.get(key) is not None and key not in df.attrs:
            df.attrs[key] = payload[key]
    return perf.bench._order_bench_columns(df)


def restore_attrs(frames, df):
    for frame in frames:
        for key in ("data", "config", "info", "id"):
            value = (getattr(frame, "attrs", {}) or {}).get(key)
            if value is not None and key not in df.attrs:
                try:
                    df.attrs[key] = value
                except Exception:
                    pass


def _tag_source(df, path):
    try:
        df[SOURCE_COL] = Path(path).name if path is not None else "<stdin>"
    except Exception:
        pass
    return df


def _collect_lists(node, out):
    if isinstance(node, dict):
        for value in node.values():
            _collect_lists(value, out)
    elif isinstance(node, list):
        if node and all(isinstance(item, dict) for item in node):
            out.append(node)
            for item in node:
                _collect_lists(item, out)
        else:
            for value in node:
                if isinstance(value, (dict, list)):
                    _collect_lists(value, out)


def _has_numeric(df):
    try:
        for column in df.columns:
            try:
                if pd.api.types.is_numeric_dtype(df[column]):
                    return True
            except Exception:
                continue
    except Exception:
        return False
    return False


def generic_frame(payload):
    if isinstance(payload, list):
        if payload and all(isinstance(item, dict) for item in payload):
            try:
                return pd.DataFrame(payload)
            except Exception:
                pass
        found = []
        _collect_lists(payload, found)
        for table in found:
            try:
                df = pd.DataFrame(table)
            except Exception:
                continue
            if not df.empty and _has_numeric(df):
                return df
        try:
            return pd.DataFrame(payload)
        except Exception:
            return pd.DataFrame()
    if isinstance(payload, dict):
        found = []
        _collect_lists(payload, found)
        for table in found:
            try:
                df = pd.DataFrame(table)
            except Exception:
                continue
            if not df.empty and _has_numeric(df):
                return df
        try:
            flat = pd.json_normalize(payload)
            if not flat.empty and _has_numeric(flat):
                return flat
        except Exception:
            pass
        try:
            return pd.DataFrame([payload])
        except Exception:
            return pd.DataFrame()
    try:
        return pd.DataFrame(payload)
    except Exception:
        return pd.DataFrame()


def _read_table_text(text, path, strict=True):
    if str(text).lstrip()[:1] in ("{", "["):
        if not strict:
            return None
        raise SystemExit(
            f"invalid envelope JSON in {path!r}: missing 'output' "
            "(expected a perf envelope or a result table)"
        )
    try:
        df = table_to_df(text)
    except ValueError as ex:
        if not strict:
            return None
        raise SystemExit(f"cannot read {path!r} as a perf result table: {ex}")
    if df is None or df.empty:
        if not strict:
            return None
        raise SystemExit(f"no data rows in {path!r}")
    return _tag_source(df, path)


def _read_envelope_json(path, strict=True):
    with open(path) as fh:
        text = fh.read()
    try:
        payload = json.loads(text)
    except ValueError:
        return _read_table_text(text, path, strict)
    if isinstance(payload, dict) and "output" in payload:
        return _tag_source(merge_envelope_data(payload, envelope_frame(payload)), path)
    if str(text).lstrip()[:1] in ("{", "["):
        try:
            frame = generic_frame(payload)
        except Exception:
            frame = None
        if frame is not None and not frame.empty and _has_numeric(frame):
            return _tag_source(frame, path)
    return _read_table_text(text, path, strict)


def _read_result_paths(paths):
    def _is_data(name):
        return name.startswith("perf.data") or name.endswith(".data")

    def _is_table(name):
        return Path(name).suffix.lower() in _TABLE_EXTS

    data = []
    for p in map(Path, paths):
        if p.is_file():
            data.append((p, True))
            continue
        for f in p.rglob("*"):
            try:
                if not f.is_file():
                    continue
            except OSError:
                continue
            if f.name.endswith(".json") or _is_data(f.name) or _is_table(f.name):
                data.append((f, False))
    return data


def load(args, stdin=True):
    if stdin and not sys.stdin.isatty():
        try:
            raw = sys.stdin.read()
        except Exception:
            raw = ""
        if raw and raw.strip():
            try:
                payload = json.loads(raw)
            except ValueError as ex:
                try:
                    return table_to_df(raw)
                except Exception:
                    raise SystemExit(
                        f"failed to parse piped data "
                        f"(expected a JSON envelope or a perf result table): {ex}"
                    )
            if isinstance(payload, dict) and "output" in payload:
                frame = merge_envelope_data(payload, envelope_frame(payload))
                return _tag_source(frame, None)
            try:
                frame = generic_frame(payload)
            except Exception as ex:
                raise SystemExit(
                    f"failed to parse piped data "
                    f"(expected a JSON envelope or a perf result table): {ex}"
                )
            if frame is None or frame.empty:
                raise SystemExit(
                    "piped JSON must be an envelope with 'output' "
                    "or a plottable JSON document"
                )
            return _tag_source(frame, None)
    if not args.data:
        raise SystemExit("no data paths; use '-- data/' or pipe JSON via stdin")
    files = _read_result_paths(args.data)
    if not files:
        raise SystemExit(f"no data files found in {args.data!r}")
    records, envelopes = [], []
    for path, explicit in files:
        try:
            is_record_file = is_record(path)
        except Exception:
            is_record_file = False
        (records if is_record_file else envelopes).append((path, explicit))
    frames = []
    if envelopes:
        loaded = []
        for path, explicit in envelopes:
            frame = _read_envelope_json(path, strict=explicit)
            if frame is None:
                print(
                    f"skipping {path}: not a perf envelope or result table",
                    file=sys.stderr,
                )
                continue
            loaded.append(frame)
        if not loaded:
            raise SystemExit(f"no readable data in {args.data!r}")
        merged = pd.concat(loaded, ignore_index=True)
        restore_attrs(loaded, merged)
        frames.append(merged)
    if records:
        frames.append(parse([p for p, _ in records]))
    if not frames:
        raise SystemExit(f"no readable data in {args.data!r}")
    out = pd.concat(frames, ignore_index=True)
    restore_attrs(frames, out)
    return out


def resolve_groupby(df, groupby):
    rec = perf.bench._as_records(df)
    return [
        c
        for c in _split_list(
            groupby if groupby is not None else ",".join(DEFAULT_GROUPBY)
        )
        if c in rec.columns
    ]


def _resolve_plot_config(args, unknown):
    config = {}
    if getattr(args, "config", None):
        with open(args.config) as f:
            loaded = json.load(f)
        if isinstance(loaded, dict):
            config.update(loaded)
    for arg in unknown or ():
        if "=" not in arg or not arg.startswith("--config."):
            raise SystemExit(f"unknown argument: {arg}")
        key, value = arg[len("--config.") :].split("=", 1)
        try:
            parsed = parse_value(value)
        except ValueError as ex:
            raise SystemExit(str(ex))
        node = config
        parts = key.split(".")
        for part in parts[:-1]:
            nxt = node.get(part)
            if not isinstance(nxt, dict):
                nxt = {}
                node[part] = nxt
            node = nxt
        node[parts[-1]] = parsed
    return config


def _resolve_axis(df, axis):
    if not axis:
        return df, None
    if isinstance(axis, (list, tuple)):
        axis = axis[0] if axis else None
    if not axis:
        return df, None
    if axis not in df.columns and isinstance(axis, str):
        if axis.startswith("data."):
            try:
                canonical = _canonical_data_col(axis)
                for column in df.columns:
                    try:
                        if (
                            column == canonical
                            or _canonical_data_col(column) == canonical
                        ):
                            df = df.copy()
                            df[axis] = df[column].values
                            break
                    except Exception:
                        continue
            except Exception:
                pass
    if axis not in df.columns:
        try:
            df, _ = eval_events(df, [axis])
        except SystemExit:
            value = data_param_value((getattr(df, "attrs", {}) or {}).get("data"), axis)
            if value is None:
                raise SystemExit(f"axis column not found in data: {axis!r}")
            df = df.copy()
            df[axis] = value
        if axis not in df.columns:
            raise SystemExit(f"axis column not found in data: {axis!r}")
    return df, axis


def main(args):
    config = _resolve_plot_config(args, getattr(args, "unknown", None) or [])
    config["logx"] = bool(config.get("logx")) or bool(getattr(args, "logx", False))
    config["logy"] = bool(config.get("logy")) or bool(getattr(args, "logy", False))
    perf.plot.config = config
    args.data = getattr(args, "data", None) or getattr(args, "paths", None) or []
    df = apply_filter(perf.bench._as_records(load(args)), getattr(args, "filter", None))
    groupby = resolve_groupby(df, args.groupby)
    type_groups = groups(args.type) if args.type else [["ecdf"]]
    if args.event:
        event_groups = groups(args.event, expand=False)
        event_groups = [
            expand_names(df, g, pool=metric_columns(df) + data_columns(df))
            for g in event_groups
        ]
        event_groups = groups(event_groups)
        requested = [e for g in event_groups for e in g]
    else:
        event_groups = None
        measured = [c for c in metric_columns(df) if "/" not in str(c)]
        requested = (
            [f"{m}/operations" for m in measured]
            if "operations" in df.columns and measured
            else None
        )
    df, metrics = eval_events(df, requested)
    if event_groups is None:
        if not metrics:
            raise SystemExit("no metric columns found in data")
        perop = [m for m in metrics if str(m).endswith("/operations")]
        event_groups = [[m] for m in (perop or metrics)]
    event_groups = [[e for e in g if e in df.columns] for g in event_groups]
    event_groups = [g for g in event_groups if g]
    if not event_groups:
        raise SystemExit("no metric columns found in data")
    df, xaxis = _resolve_axis(df, getattr(args, "xaxis", None))
    df, yaxis = _resolve_axis(df, getattr(args, "yaxis", None))
    if want_json(args):
        emit_json_text(df.to_json(orient="records", indent=4), json_path(args))
    try:
        perf.plot(
            df,
            type_groups,
            event_groups,
            xaxis,
            yaxis,
            groupby,
            config,
            getattr(args, "output", None),
        )
    except KeyError as e:
        raise SystemExit(e.args[0] if e.args else e)
    if args.interactive:
        try:
            import matplotlib.pyplot as plt
        except Exception:
            plt = None
        embed({"perf": perf, "df": df, "plt": plt})


def _perfconfig_path():
    try:
        current = Path.cwd().resolve()
        home = Path.home().resolve()
    except OSError:
        return None
    while True:
        candidate = current / _PERFCONFIG
        try:
            if candidate.is_file():
                return candidate
        except OSError:
            pass
        if current == home or current.parent == current:
            return None
        current = current.parent


def _config_entries(path=None):
    path = Path(path) if path is not None else _perfconfig_path()
    if path is None or not path.is_file():
        return {}
    parser = configparser.ConfigParser(
        interpolation=None,
        strict=False,
        comment_prefixes=_PERFCONFIG_COMMENTS,
        inline_comment_prefixes=_PERFCONFIG_COMMENTS,
    )
    try:
        with open(path, encoding="utf-8") as fh:
            parser.read_file(fh, source=str(path))
    except (configparser.Error, UnicodeDecodeError, OSError):
        return {}
    entries = {}
    for section in ("default", _COMMAND):
        if not parser.has_section(section):
            continue
        for key, value in parser.items(section):
            if key.strip() and value.strip():
                entries[key] = value.strip()
    return entries


def _known(parser, key):
    if key.startswith(_DOTTED_KEYS):
        return True
    return any(
        action.dest == key or key in {o.lstrip("-") for o in action.option_strings}
        for action in parser._actions
    )


def _aliases(parser, key):
    if key.startswith(_DOTTED_KEYS):
        return {key}
    aliases = {key}
    for action in parser._actions:
        if action.dest == key:
            aliases |= {o.lstrip("-") for o in action.option_strings}
    return aliases


def _flag_only(parser, key):
    return any(
        action.dest == key
        and isinstance(action, (argparse._StoreTrueAction, argparse._StoreFalseAction))
        for action in parser._actions
    )


def _given(argv):
    given = set()
    for arg in argv:
        if arg == "--":
            break
        if arg.startswith("--"):
            given.add(arg[2:].split("=", 1)[0])
        elif arg.startswith("-") and len(arg) > 1:
            given.add(arg[:2].lstrip("-"))
    return given


def _truthy(value):
    text = str(value).strip().lower()
    if text in ("1", "true", "yes", "on"):
        return True
    if text in ("0", "false", "no", "off"):
        return False
    return None


def apply_perfconfig(parser, argv, config_path=None):
    entries = _config_entries(config_path)
    if not entries:
        return list(argv)
    given = _given(argv)
    pending = []
    for key, value in entries.items():
        if not _known(parser, key) or _aliases(parser, key) & given:
            continue
        if key == "json":
            on = _truthy(value)
            if on is True:
                pending.append("--json")
            elif on is False:
                continue
            else:
                pending.append(f"--json={value}")
            continue
        if _flag_only(parser, key):
            on = _truthy(value)
            if on is None:
                parser.error(
                    f"invalid [{_COMMAND}] {key} = {value!r}; expected a boolean "
                    "(true/false)"
                )
            if on:
                pending.append(f"--{key}")
            continue
        pending.append(f"--{key}={value}")
    return pending + list(argv)


def split_after_dashes(argv):
    if "--" in argv:
        sep = argv.index("--")
        return list(argv[:sep]), list(argv[sep + 1 :])
    return list(argv), []


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf plot", description="plot benchmark data (stdin or -- data paths)"
    )
    parser.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="event metric/expression to plot; comma in one -e overlays on the same "
        "chart, repeated -e adds a new column (default: one column per measured "
        "event as <event>/operations)",
    )
    parser.add_argument(
        "-x",
        "--xaxis",
        dest="xaxis",
        default=None,
        help="x-axis column, e.g. -x data.rsi to plot scaling over a parameter "
        "(default: samples/time; data.* and config.* columns are available per run)",
    )
    parser.add_argument(
        "-y",
        "--yaxis",
        dest="yaxis",
        default=None,
        help="y-axis column, overriding the event (default: the event itself; "
        "data.* and config.* columns are available per run)",
    )
    parser.add_argument(
        "-t",
        "--type",
        dest="type",
        action="append",
        default=None,
        help="chart types; comma in one -t overlays on the same chart, repeated -t "
        "starts a new chart (default: ecdf)",
    )
    parser.add_argument(
        "--logx", dest="logx", action="store_true", help="log scale on x-axis"
    )
    parser.add_argument(
        "--logy", dest="logy", action="store_true", help="log scale on y-axis"
    )
    parser.add_argument(
        "-g",
        "--group-by",
        dest="groupby",
        default=",".join(DEFAULT_GROUPBY),
        help="grouping for hues (default: file,name,mode; pass e.g. -g file,mode or -g "
        "'' for a single scaling line over data.*)",
    )
    parser.add_argument(
        "-f",
        "--filter",
        dest="filter",
        default=None,
        help="pandas query filter for rows, e.g. --filter 'name == \"fizz_buzz\"'",
    )
    parser.add_argument(
        "--config",
        dest="config",
        default=None,
        help="plot config JSON file (matplotlib style/rcParams; --config.* overrides "
        "win)",
    )
    parser.add_argument(
        "-o",
        "--output",
        dest="output",
        default=None,
        help="save charts to file(s) instead of displaying (e.g. -o chart.png, -o "
        "chart.pdf, or -o out/ for one file per chart type)",
    )
    parser.add_argument(
        "--json",
        dest="json",
        nargs="?",
        const=True,
        default=False,
        metavar="FILE",
        help="also emit the plotted data as JSON records to stdout, or to FILE "
        "when a path is given (e.g. `--json out.json`)",
    )
    parser.add_argument("-i", "--interactive", action="store_true")
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args, _unknown = _parser.parse_known_args(apply_perfconfig(_parser, _options))
    if _unknown and not all(u.startswith("--config.") for u in _unknown):
        _parser.error(f"unknown argument: {_unknown[0]}")
    _args.unknown = _unknown
    _args.paths = _paths
    main(_args)
