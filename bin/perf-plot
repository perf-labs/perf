import argparse
import os
import sys

import pandas as pd

import perf
from perf.cfg import data_param_value
from perf.core import _DURATION_TIME, _split_groups
from perf.data import (
    _DEFAULT_GROUPBY,
    apply_filter,
    data_columns,
    emit_output,
    eval_events,
    expand_names,
    load,
    loads_json,
    metadata_from_frame,
    metric_columns,
    output_targets,
    parse_value,
    perfconfig_entries,
    resolve_groupby,
    split_after_dashes,
    stdin_is_pipe,
)
from perf.data import (
    _aliases as _data_aliases,
)
from perf.data import _flag_only as _flag_only
from perf.data import (
    _known as _data_known,
)
from perf.data import _truthy as _truthy
from perf.data import (
    apply_perfconfig as _data_apply,
)
from perf.data import generic_frame as generic_frame
from perf.data import table_to_df as table_to_df
from perf.plot import (
    _canonical_data_col,
    _expand_types,
    _flow_for,
    _flow_mode,
    flow_graph,
)

_COMMAND = "plot"
_DOTTED_KEYS = ("config.",)


def apply_perfconfig(parser, argv, config_path=None):
    return _data_apply(
        parser,
        argv,
        _COMMAND,
        config_path,
        dotted_keys=_DOTTED_KEYS,
    )


def _config_entries(path=None):
    return perfconfig_entries(_COMMAND, path)


def _known(parser, key):
    return _data_known(parser, key, _DOTTED_KEYS)


def _aliases(parser, key):
    return _data_aliases(parser, key, _DOTTED_KEYS)


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.cycles
    df.ecdf()
    %notebook session.ipynb""")

    import sys

    if not getattr(sys.stdin, "isatty", lambda: False)():
        try:
            sys.stdin = open("/dev/tty")
        except Exception:
            pass

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def groups(value, expand=True):
    return _split_groups(value, [_DURATION_TIME], expand=expand)


def main(args):
    config = _resolve_plot_config(args, getattr(args, "unknown", None) or [])
    config["logx"] = bool(config.get("logx")) or bool(getattr(args, "logx", False))
    config["logy"] = bool(config.get("logy")) or bool(getattr(args, "logy", False))
    perf.plot.config = config
    args.data = getattr(args, "data", None) or getattr(args, "paths", None) or []
    if not args.data and not stdin_is_pipe():
        args.data = ["."]
    type_value = getattr(args, "type", None)
    type_groups = (
        _split_groups(type_value, ["auto"], expand=True) if type_value else [["auto"]]
    )
    loaded = None
    if _has_auto(type_groups):
        loaded = _load_flow_frame(args, config)
        type_groups = _expand_types(type_groups, loaded, getattr(args, "xaxis", None))
    if _flow_only(type_groups):
        _main_flow(args, config, type_groups, loaded)
        return
    df = (
        loaded
        if loaded is not None
        else apply_filter(
            perf.bench._as_records(load(args)), getattr(args, "filter", None)
        )
    )
    groupby = resolve_groupby(df, args.groupby)
    if args.event:
        event_groups = groups(args.event, expand=False)
        event_groups = [
            expand_names(df, g, pool=metric_columns(df) + data_columns(df))
            for g in event_groups
        ]
        event_groups = groups(event_groups)
        requested = [e for g in event_groups for e in g]
    else:
        event_groups = None
        measured = [c for c in metric_columns(df) if "/" not in str(c)]
        requested = (
            [f"{m}/operations" for m in measured]
            if "operations" in df.columns and measured
            else None
        )
    df, metrics = eval_events(df, requested)
    if event_groups is None:
        if not metrics:
            raise SystemExit("no metric columns found in data")
        perop = [m for m in metrics if str(m).endswith("/operations")]
        event_groups = [[m] for m in (perop or metrics)]
    event_groups = [[e for e in g if e in df.columns] for g in event_groups]
    event_groups = [g for g in event_groups if g]
    if not event_groups:
        raise SystemExit("no metric columns found in data")
    df, xaxis = _resolve_axis(df, getattr(args, "xaxis", None))
    df, yaxis = _resolve_axis(df, getattr(args, "yaxis", None))
    targets = output_targets(getattr(args, "output", None))
    json_targets = []
    image_targets = []
    for target in targets:
        if target is True or (
            isinstance(target, str) and target.lower().endswith(".json")
        ):
            json_targets.append(target)
        else:
            image_targets.append(target)
    if json_targets:
        emit_output(
            json_targets,
            df.to_dict(orient="records"),
            values=metadata_from_frame(df, command="plot"),
            template=getattr(args, "_output_template", None),
        )
    try:
        if not targets:
            perf.plot(
                df,
                type_groups,
                event_groups,
                xaxis,
                yaxis,
                groupby,
                config,
                None,
            )
        for target in image_targets:
            perf.plot(
                df,
                type_groups,
                event_groups,
                xaxis,
                yaxis,
                groupby,
                config,
                str(target),
            )
    except KeyError as e:
        raise SystemExit(e.args[0] if e.args else e)
    except ValueError as e:
        raise SystemExit(str(e))
    if args.interactive:
        try:
            import matplotlib.pyplot as plt
        except Exception:
            plt = None
        embed({"perf": perf, "df": df, "plt": plt})


def _has_auto(type_groups):
    return any(
        str(name).strip().lower() == "auto" for group in type_groups for name in group
    )


def _flow_only(type_groups):
    return bool(type_groups) and all(
        group and set(group) == {"cfg"} for group in type_groups
    )


def _flow_binary_path(value):
    path = str(value)
    if not os.path.isfile(path):
        return None
    try:
        with open(path, "rb") as fh:
            magic = fh.read(4)
    except OSError:
        return None
    return path if magic == b"\x7fELF" else None


def _load_flow_frame(args, config):
    data = getattr(args, "data", None) or []
    if not isinstance(data, (list, tuple)):
        data = [data]
    binaries = []
    others = []
    for value in data:
        binary = _flow_binary_path(value)
        if binary is not None:
            binaries.append(binary)
        else:
            others.append(value)
    if binaries and not others and not stdin_is_pipe():
        graphs = [flow_graph(path, _flow_mode(config)) for path in binaries]
        graph = graphs[0] if len(graphs) == 1 else _merge_graphs(graphs)
        df = pd.DataFrame()
        df.attrs["flow_graph"] = graph
        return df
    return apply_filter(
        perf.bench._as_records(load(args)), getattr(args, "filter", None)
    )


def _merge_graphs(graphs):
    nodes = []
    edges = []
    seen = set()
    for graph in graphs:
        for node in graph.get("nodes") or []:
            key = (graph.get("name"), node.get("id"))
            if key not in seen:
                seen.add(key)
                nodes.append(dict(node))
        edges.extend(dict(edge) for edge in graph.get("edges") or [])
    return {
        "nodes": nodes,
        "edges": edges,
        "entry": graphs[0].get("entry") if graphs else None,
        "name": ", ".join(str(graph.get("name") or "") for graph in graphs),
    }


def _flow_records(df):
    graph = _flow_for(df)
    labels = {
        node.get("id"): node.get("label", "") for node in graph.get("nodes") or []
    }
    return [
        {
            "source": edge.get("source"),
            "target": edge.get("target"),
            "kind": edge.get("kind"),
            "source_label": labels.get(edge.get("source"), ""),
            "target_label": labels.get(edge.get("target"), ""),
        }
        for edge in graph.get("edges") or []
    ]


def _main_flow(args, config, type_groups, df=None):
    if df is None:
        df = _load_flow_frame(args, config)
    targets = output_targets(getattr(args, "output", None))
    json_targets = []
    image_targets = []
    for target in targets:
        if target is True or (
            isinstance(target, str) and target.lower().endswith(".json")
        ):
            json_targets.append(target)
        else:
            image_targets.append(target)
    if json_targets:
        emit_output(
            json_targets,
            _flow_records(df),
            values=metadata_from_frame(df, command="plot"),
            template=getattr(args, "_output_template", None),
        )
    try:
        if not targets:
            perf.plot(
                df,
                type_groups,
                None,
                None,
                None,
                getattr(args, "groupby", None),
                config,
                None,
            )
        for target in image_targets:
            perf.plot(
                df,
                type_groups,
                None,
                None,
                None,
                getattr(args, "groupby", None),
                config,
                str(target),
            )
    except KeyError as e:
        raise SystemExit(e.args[0] if e.args else e)
    except ValueError as e:
        raise SystemExit(str(e))
    if args.interactive:
        try:
            import matplotlib.pyplot as plt
        except Exception:
            plt = None
        embed({"perf": perf, "df": df, "plt": plt})


def _resolve_plot_config(args, unknown):
    config = {}
    if getattr(args, "config", None):
        try:
            with open(args.config) as f:
                loaded = loads_json(f.read())
        except OSError as ex:
            raise SystemExit(f"cannot read --config {args.config!r}: {ex}")
        except ValueError as ex:
            raise SystemExit(f"invalid JSON in --config {args.config!r}: {ex}")
        if not isinstance(loaded, dict):
            raise SystemExit("--config file must contain a JSON object")
        config.update(loaded)
    for arg in unknown or ():
        if "=" not in arg or not arg.startswith("--config."):
            raise SystemExit(f"unknown argument: {arg}")
        key, value = arg[len("--config.") :].split("=", 1)
        try:
            parsed = parse_value(value)
        except ValueError as ex:
            raise SystemExit(str(ex))
        node = config
        parts = key.split(".")
        for part in parts[:-1]:
            nxt = node.get(part)
            if not isinstance(nxt, dict):
                nxt = {}
                node[part] = nxt
            node = nxt
        node[parts[-1]] = parsed
    _reject_unknown_plot_keys(config)
    return config


def _reject_unknown_plot_keys(config):
    try:
        from matplotlib import rcParams
    except Exception:
        return

    def walk(node, prefix=""):
        for key, value in dict(node or {}).items():
            full = f"{prefix}.{key}" if prefix else str(key)
            if isinstance(value, dict):
                walk(value, full)
            elif full.split(".", 1)[0] == "cfg":
                continue
            elif full not in ("style", "backend", "logx", "logy") and (
                full not in rcParams
            ):
                raise SystemExit(f"unknown plot config: {full!r}")

    walk(config)


def _resolve_axis(df, axis):
    if not axis:
        return df, None
    if isinstance(axis, (list, tuple)):
        axis = axis[0] if axis else None
    if not axis:
        return df, None
    if axis not in df.columns and isinstance(axis, str):
        if axis.startswith("data."):
            try:
                canonical = _canonical_data_col(axis)
                for column in df.columns:
                    try:
                        if (
                            column == canonical
                            or _canonical_data_col(column) == canonical
                        ):
                            df = df.copy()
                            df[axis] = df[column].values
                            break
                    except Exception:
                        continue
            except Exception:
                pass
        elif axis.startswith("config."):
            try:
                cols = perf.cfg.config_param_columns(
                    (getattr(df, "attrs", {}) or {}).get("config")
                )
            except Exception:
                cols = {}
            if axis in cols:
                df = df.copy()
                df[axis] = [cols[axis]] * len(df)
    if axis not in df.columns:
        try:
            df, _ = eval_events(df, [axis])
        except SystemExit:
            value = data_param_value((getattr(df, "attrs", {}) or {}).get("data"), axis)
            if value is None:
                raise SystemExit(f"axis column not found in data: {axis!r}")
            df = df.copy()
            df[axis] = value
        if axis not in df.columns:
            raise SystemExit(f"axis column not found in data: {axis!r}")
    return df, axis


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf plot", description="plot benchmark data (stdin or -- data paths)"
    )
    parser.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="event metric/expression to plot; comma in one -e overlays on the same "
        "chart, repeated -e adds a new column (default: one column per measured "
        "event as <event>/operations)",
    )
    parser.add_argument(
        "-x",
        "--xaxis",
        dest="xaxis",
        default=None,
        help="x-axis column, e.g. -x data.rsi to plot scaling over a parameter "
        "(default: time; data.* and config.* columns are available per run)",
    )
    parser.add_argument(
        "-y",
        "--yaxis",
        dest="yaxis",
        default=None,
        help="y-axis column, overriding the event (default: the event itself; "
        "data.* and config.* columns are available per run)",
    )
    parser.add_argument(
        "-t",
        "--type",
        dest="type",
        action="append",
        default=None,
        help="chart types; comma in one -t overlays on the same chart, repeated -t "
        "starts a new chart; `auto` picks cfg for analyze/disassembly data, line "
        "for scaling over an x-axis parameter, and ecdf otherwise (default: "
        "auto)",
    )
    parser.add_argument(
        "--logx", dest="logx", action="store_true", help="log scale on x-axis"
    )
    parser.add_argument(
        "--logy", dest="logy", action="store_true", help="log scale on y-axis"
    )
    parser.add_argument(
        "-g",
        "--group-by",
        dest="groupby",
        default=",".join(_DEFAULT_GROUPBY),
        help="grouping for hues (default: file,name,mode,data.*; `data.*` expands "
        "to every data column; pass e.g. -g file,mode or -g '' for a single scaling "
        "line over data.*)",
    )
    parser.add_argument(
        "-f",
        "--filter",
        dest="filter",
        default=None,
        help="pandas query filter for rows, e.g. --filter 'name == \"fizz_buzz\"'",
    )
    parser.add_argument(
        "--config",
        dest="config",
        default=None,
        help="plot config JSON file (matplotlib style/rcParams; --config.* overrides "
        "win, e.g. --config.backend=sixel)",
    )
    parser.add_argument(
        "-o",
        "--output",
        dest="output",
        action="append",
        nargs="?",
        const=True,
        default=None,
        metavar="PATH",
        help="save a chart to PATH (e.g. chart.png, chart.pdf, or out/ for one "
        "file per chart type); write plotted JSON records when PATH ends in .json, "
        "or to stdout when no PATH is given; repeat --output to write several "
        "destinations; a directory gets one image per chart type; a .json path "
        "writes plotted JSON records",
    )
    parser.add_argument("-i", "--interactive", action="store_true")
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args, _unknown = _parser.parse_known_args(apply_perfconfig(_parser, _options))
    if _unknown and not all(u.startswith("--config.") for u in _unknown):
        _parser.error(f"unknown argument: {_unknown[0]}")
    _args.unknown = _unknown
    _args.paths = _paths
    main(_args)
