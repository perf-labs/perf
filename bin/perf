            "combination via cartesian product, e.g. "
            "--config.cache.L1d=[{hit_rate:100},{hit_rate:50}] runs both hit rates; "
            "single values run once (--config.cache.L1d=hit_rate:100, "
            "--config.samples=100, "
            "--config.branch=predictable|unpredictable|unpredictable.uniform|"
            "unpredictable.exponential, "
            "--config.func.align=32, --config.stack.size=2097152); "
