try:
    import matplotlib_backend_sixel  # noqa: F401

    matplotlib.use("module://matplotlib_backend_sixel")
except ImportError:
    matplotlib.use("Agg")

import perf
from perf.arch import x86_64 as _x86_arch
from perf.bench import (
    _DEFAULT_BENCH,
    _as_records,
    _canonical_data_reg_key,
    _deep_merge,
    _mem_entries,
    _merge_data,
    _order_bench_columns,
    _record_envelope,
)
from perf.core import _is_mem_addr_key
from perf.core import (
    _split_groups as _core_split_groups,
)
from perf.core import (
    _split_list as _core_split_list,
)

_DEFAULT_GROUPBY = ["file", "name", "mode"]
_DEFAULT_COLUMNS = ["time", "file", "name", "mode", "samples"]
_SOURCE_COL = "__source__"
_DEFAULT_STATS = ["min", "median", "p10", "p50", "p90", "p99", "max"]
_BASELINE_TMP = "__perf_base"
_BASELINE_RE = re.compile(
    r"""(['"])(?P<key>.+?)\1\s*\.\s*(?P<metric>[A-Za-z_][A-Za-z0-9_\-]*)"""
)
_DURATION_RE = re.compile(r"^([-+]?(\d+(?:\.\d*)?|\.\d+))(ns|us|ms|s)$")
_DURATION_SCALE = {"ns": 1.0, "us": 1e3, "ms": 1e6, "s": 1e9}
_TABLE_EMPTY = frozenset({"", "nan", "none", "nat", "null"})


def _is_duration_col(c):
    return c == "duration_time" or str(c).startswith("duration_time/")


def _to_float(v):
    try:
        f = float(v)
    except (TypeError, ValueError):
        return None
    import math

    return f if math.isfinite(f) else None


def _format_duration(v):
    try:
        import pandas as _pd

        if _pd.isna(v):
            return ""
    except Exception:
        pass
    ns = _to_float(v)
    if ns is None:
        try:
            float(v)
            return ""
        except (TypeError, ValueError):
            return str(v)
    if ns < 0:
        return f"{ns:.2f}"
    if ns < 1e3:
        return f"{ns:.2f}ns"
    if ns < 1e6:
        return f"{ns / 1e3:.2f}us"
    if ns < 1e9:
        return f"{ns / 1e6:.2f}ms"
    return f"{ns / 1e9:.2f}s"


def _format_number(v):
    try:
        import pandas as _pd

        if _pd.isna(v):
            return ""
    except Exception:
        pass
    f = _to_float(v)
    if f is None:
        try:
            float(v)
            return ""
        except (TypeError, ValueError):
            return str(v)
    return f"{f:.2f}"


def _wrapper_path():
    try:
        return os.path.realpath(__file__)
    except Exception:
        return sys.argv[0]


def _perf(argv):
    out = list(argv)
    wrapper = _wrapper_path()
    if "--" in out:
        i = out.index("--")
        if i + 1 < len(out) and out[i + 1] == "perf":
            out[i + 1] = wrapper
    return out


def _exec_system_perf(argv):
    bin_path = perf.bin(skip=[os.path.realpath(__file__)])
    if bin_path is None:
        raise SystemExit(
            "system perf not found; install linux-tools or use a supported subcommand"
        )
    argv = _perf(argv)
    os.execv(bin_path, [bin_path] + argv)


def _metric_columns(df):
    cols = []
    for c in df.columns:
        if str(c).startswith("data.") or str(c).startswith("config."):
            continue
        if c in (
            "file",
            "name",
            "mode",
            "samples",
            "iterations",
            "operations",
            "time",
            "address",
            "size",
            "pid",
            "ip",
        ):
            continue
        try:
            if pd.api.types.is_numeric_dtype(df[c]):
                cols.append(c)
        except Exception:
            continue
    return cols


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.cycles
    df.groupby(["name", "mode"]).cycles.describe()
    df.ecdf()
    %notebook session.ipynb""")

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def _groups(value):
    return _core_split_groups(value, ["duration_time"])


def _flat_events(value):
    flat = _core_split_list(value)
    return flat or None


def _single_output(args):
    out = getattr(args, "output", None)
    if isinstance(out, (list, tuple)):
        if len(out) > 1:
            raise SystemExit("only a single -o/--output is supported")
        out = out[0] if out else None
    return out


def _resolve_output(args, stage=None):
    out = _single_output(args)
    if stage == "S":
        if out is None:
            return None, True
        if out == "-":
            return None, True
        return out, False
    if stage == "c":
        if out is None:
            return None, False
        if out == "-":
            raise SystemExit("-c (object) cannot write to stdout; give -o a.o")
        return out, False
    if out is None or out == "-":
        return None, False
    return out, False


def _bench_file_output(args):
    out = _single_output(args)
    if out is None or out == "-":
        return None
    return out


def _want_json(args):
    return bool(getattr(args, "json", False))


def _is_trace_numeric(df, col):
    try:
        if pd.api.types.is_bool_dtype(df[col]):
            return False
    except Exception:
        pass
    try:
        return bool(pd.api.types.is_numeric_dtype(df[col]))
    except Exception:
        return False


def _format_trace_table(df):
    if df is None or df.empty:
        try:
            return df.to_string(index=False)
        except Exception:
            return ""

    def _cell(v):
        if v is None:
            return ""
        try:
            s = str(v)
        except Exception:
            return ""
        return s.replace("\r", " ").replace("\n", " ")

    cols = list(df.columns)
    strs = {c: [_cell(v) for v in df[c].tolist()] for c in cols}
    numeric = {c: _is_trace_numeric(df, c) for c in cols}
    widths = {}
    for c in cols:
        w = len(str(c))
        for s in strs[c]:
            if len(s) > w:
                w = len(s)
        widths[c] = w
    lines = []
    header = []
    for c in cols:
        h = str(c)
        header.append(h.rjust(widths[c]) if numeric[c] else h.ljust(widths[c]))
    lines.append("  ".join(header))
    for i in range(len(df)):
        row = []
        for c in cols:
            s = strs[c][i]
            row.append(s.rjust(widths[c]) if numeric[c] else s.ljust(widths[c]))
        lines.append("  ".join(row))
    return "\n".join(lines)


def _out_dirname(_args, name, file_label):
    outer = file_label or name
    return Path(outer) / name


def _write_envelope(_args, df, _groups, file_output, to_stdout):
    text = perf.to_json(df)
    if to_stdout:
        print(text, flush=True)
    if file_output is not None:
        try:
            payload = json.loads(text)
        except Exception:
            payload = {}
        rec = _as_records(df)
        try:
            file_label = (
                str(rec["file"].iloc[0]) if len(rec) else payload.get("name", "")
            )
        except Exception:
            file_label = payload.get("name", "")
        now = datetime.now()
        root = Path(str(file_output))
        dname = _out_dirname(_args, payload.get("name", ""), file_label)
        path = root / dname / f"{now.strftime('%Y%m%d_%H%M%S_%f')}.json"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text + "\n")


def _require_mode_arg(args):
    if not args.mode:
        raise SystemExit("--mode latency|throughput is required for measurement")
    raw = args.mode if isinstance(args.mode, (list, tuple)) else [args.mode]
    modes = [m for v in raw for m in str(v).replace(",", " ").split() if m]
    unknown = [m for m in modes if m not in ("latency", "throughput")]
    if unknown:
        raise SystemExit(
            f"unknown mode {unknown[0]!r}; expected 'latency' or 'throughput'"
        )
    args.mode = modes or ["latency", "throughput"]
    return args.mode


def _event_groups(args):
    return _groups(args.event)


def _bench_measure(args):
    groups = _event_groups(args)
    kwargs = dict(
        file=args.file,
        target=getattr(args, "target", None),
        name=getattr(args, "bench_name", None),
        config=args.config,
        data=getattr(args, "data", None),
        event=groups,
        setup=getattr(args, "setup", None),
        teardown=getattr(args, "teardown", None),
        backend=getattr(args, "backend", None),
        mode=args.mode,
        debug=bool(getattr(args, "debug", False)),
    )
    return perf.bench(**kwargs), groups


def _resolve_bench_targets(args):
    file = getattr(args, "file", None)
    target = getattr(args, "target", None)
    if file == "asm":
        if not target or not str(target).strip():
            raise SystemExit("asm code is required, e.g. `perf bench asm 'rdtsc'`")
        args.asm = target
        args.file = None
        args.target = None
        return args
    return args


def bench_asm_cmd_measure(args):
    _require_mode_arg(args)
    groups = _event_groups(args)
    snippet = getattr(args, "asm", "") or ""
    if not str(snippet).strip():
        raise SystemExit("asm code is required, e.g. `perf bench asm 'rdtsc'`")
    setup = getattr(args, "setup", None)
    teardown = getattr(args, "teardown", None)
    df = perf.bench(
        asm=snippet,
        name=getattr(args, "bench_name", None) or snippet,
        mode=args.mode,
        config=args.config,
        data=getattr(args, "data", None),
        event=groups,
        setup=[setup] if setup else None,
        teardown=[teardown] if teardown else None,
        backend=getattr(args, "backend", None),
        debug=bool(getattr(args, "debug", False)),
    )
    _run_measure(args, df, groups)
    return df, groups


def _sanitize_name(name):
    from perf.exec import _sym_id as _exec_sym_id

    return _exec_sym_id(name or "bench")


def _emit_text(args, text):
    file_output, to_stdout = _resolve_output(args, stage="S")
    if text.endswith("\n"):
        out = text
    else:
        out = text + "\n"
    if to_stdout and file_output is None:
        sys.stdout.write(out)
        return
    path = Path(str(file_output))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(out)


def _stage_S(args, is_asm=False):
    if is_asm:
        text = perf.disassemble(asm=getattr(args, "asm", "") or "")
    else:
        text = perf.disassemble(
            file=args.file,
            target=getattr(args, "target", None),
            config=args.config,
            data=getattr(args, "data", None),
            setup=getattr(args, "setup", None),
        )
    _emit_text(args, text)


def _stage_c(args, is_asm=False):
    if is_asm:
        raise SystemExit(
            "-c (object) needs a binary target, e.g. `perf bench a.out foo`"
        )
    file_output, _ = _resolve_output(args, stage="c")
    if file_output is None:
        default_name = getattr(args, "bench_name", None) or getattr(
            args, "target", None
        )
        file_output = f"{_sanitize_name(default_name)}.o"
    path = Path(str(file_output))
    path.parent.mkdir(parents=True, exist_ok=True)
    perf.to_object(
        file=args.file,
        target=getattr(args, "target", None),
        path=str(path),
    )


def _run_measure(args, df, groups):
    _output_or_default(args, df, groups)
    if args.interactive:
        embed({"perf": perf, "df": _interactive_bench_df(df, groups)})


def _bench_dispatch(args, is_asm=False):
    try:
        if getattr(args, "emit_asm", False):
            _stage_S(args, is_asm=is_asm)
            return
        if getattr(args, "emit_obj", False):
            _stage_c(args, is_asm=is_asm)
            return
    except ValueError as ex:
        raise SystemExit(str(ex).splitlines()[0] if str(ex) else "no matching target")
    if is_asm:
        bench_asm_cmd_measure(args)
    else:
        _bench_file(args)


def _bench_file(args):
    _require_mode_arg(args)
    try:
        df, groups = _bench_measure(args)
    except ValueError as ex:
        short = str(ex).splitlines()[0] if str(ex) else f"no target for {args.file!r}"
        raise SystemExit(f"{short}\navailable targets for {args.file!r} listed above")
    _run_measure(args, df, groups)


def _output_or_default(args, df, groups):
    file_output = _bench_file_output(args)
    if _want_json(args):
        _write_envelope(args, df, groups, file_output, True)
        return
    if file_output is not None:
        _write_envelope(args, df, groups, file_output, False)
        return
    try:
        rec = _as_records(df)
    except Exception:
        rec = df
    try:
        flat = [e for g in (groups or []) for e in (g or [])]
        rec = _order_bench_columns(rec, flat or None)
    except Exception:
        pass
    try:
        text = _format_table(rec).to_string(index=False)
    except Exception:
        try:
            text = rec.to_string(index=False)
        except Exception:
            text = str(rec)
    print(text, flush=True)


def _interactive_bench_df(df, groups=None):
    try:
        rec = _as_records(df)
    except Exception:
        return df
    try:
        flat = [e for g in (groups or []) for e in (g or [])] or None
    except Exception:
        flat = None
    try:
        rec = _order_bench_columns(rec, flat)
    except Exception:
        pass
    try:
        _attrs = dict(getattr(df, "attrs", {}) or {})
    except Exception:
        _attrs = {}
    try:
        for _k, _v in _attrs.items():
            try:
                rec.attrs[_k] = _v
            except Exception:
                pass
    except Exception:
        pass
    return rec


def _print_available(file, kind, df=None):
    if df is None:
        df = perf.metadata(file, kind)
    if df.empty:
        print(_format_trace_table(df))
        return
    df = df.copy()
    df["start"] = df["start"].apply(lambda x: f"0x{int(x):x}")
    df["end"] = df["end"].apply(lambda x: f"0x{int(x):x}")
    print(_format_trace_table(df))


def bench_asm_cmd(args):
    _resolve_bench_targets(args)
    snippet = getattr(args, "asm", None)
    if not snippet or not str(snippet).strip():
        raise SystemExit("asm code is required, e.g. `perf bench asm 'rdtsc'`")
    _bench_dispatch(args, is_asm=True)


def bench_cmd(args):
    _resolve_bench_targets(args)
    if getattr(args, "list", False):
        _bench_list(args)
        return
    t = getattr(args, "target", None)
    code = getattr(args, "asm", None)
    if not getattr(args, "file", None):
        if not code or not str(code).strip():
            raise SystemExit(
                "expected `perf bench asm 'rdtsc'`, "
                "`perf bench <file> <target>` or `perf bench <file> --list`"
            )
        bench_asm_cmd(args)
        return
    if not t or not str(t).strip():
        raise SystemExit(
            "a target is required, e.g. `perf bench a.out foo`, "
            "`perf bench a.out hot_begin..hot_end` or `perf bench a.out --list`"
        )
    _bench_dispatch(args, is_asm=False)


def _bench_list(args):
    _resolve_bench_targets(args)
    if not getattr(args, "file", None):
        raise SystemExit("a binary is required, e.g. `perf bench /tmp/a.out --list`")
    df = perf.metadata(args.file, None)
    _print_available(args.file, None, df)


def _resolve_info_columns(df, columns):
    if columns is None:
        return df
    cols = _core_split_list(columns)
    if not cols:
        return df
    unknown = [c for c in cols if c not in df.columns]
    if unknown:
        raise SystemExit(
            f"unknown columns: {', '.join(unknown)}; "
            f"available: {', '.join(str(c) for c in df.columns)}"
        )
    return df[[c for c in cols]]


def info_cpu_cmd(args):
    df = perf.cpuinfo()
    df = _resolve_info_columns(df, getattr(args, "column", None))
    if _want_json(args):
        print(
            json.dumps(df.to_dict(orient="records"), indent=4, default=str), flush=True
        )
    else:
        print(_format_trace_table(df))
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def info_file_cmd(args):
    file = getattr(args, "file", None)
    if not file:
        raise SystemExit("perf info needs a target, e.g. `perf info cpu` or `perf info a.out`")
    df = perf.metadata(file, getattr(args, "kind", None))
    df = _resolve_info_columns(df, getattr(args, "column", None))
    if _want_json(args):
        print(
            json.dumps(df.to_dict(orient="records"), indent=4, default=str), flush=True
        )
    else:
        out = df.copy()
        for col in ("start", "end"):
            if col in out.columns:
                try:
                    out[col] = out[col].apply(lambda x: f"0x{int(x):x}")
                except Exception:
                    pass
        print(_format_trace_table(out))
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def _data_columns(df, exclude=()):
    try:
        skip = set(exclude or ())
    except Exception:
        skip = set()
    try:
        return [c for c in df.columns if str(c).startswith("data.") and c not in skip]
    except Exception:
        return []


def _merge_envelope_data(payload, df):
    for key in ("file", "name", "mode", "time"):
        if key in payload and key not in df.columns:
            df[key] = payload[key]
    from perf.bench import config_param_columns as _cfg_cols
    from perf.bench import data_param_columns as _data_cols

    new_cols = {}
    for cols_fn, section in ((_data_cols, "data"), (_cfg_cols, "config")):
        try:
            for col, val in cols_fn(payload.get(section)).items():
                if col not in df.columns and col not in new_cols:
                    new_cols[col] = val
        except Exception:
            pass
    try:
        alias_cols = {}
        for col, _ in list(new_cols.items()) + [
            (c, None) for c in list(df.columns) if c not in new_cols
        ]:
            if not isinstance(col, str) or not col.startswith("data."):
                continue
            rest = col[len("data.") :]
            if rest.startswith(("regs.", "mem.", "memory.")):
                continue
            try:
                int(str(rest).strip(), 0)
                continue
            except (TypeError, ValueError):
                pass
            try:
                from perf.arch import arch as _get_arch

                arch = _get_arch()
                keys = set(arch.data_reg_keys(rest))
            except Exception:
                keys = set()
            try:
                from perf.bench import _canonical_data_reg_key as _canon

                canon = _canon(rest)
                keys.add(f"data.{canon}")
                try:
                    alias = arch.arg_alias(canon)
                except Exception:
                    alias = None
                if alias:
                    keys.add(f"data.{alias}")
                    keys.add(f"data.{str(alias).lower()}")
            except Exception:
                pass
            v = new_cols.get(col, None)
            if v is None and col in df.columns:
                try:
                    v = df[col].iloc[0] if len(df) else None
                except Exception:
                    v = None
                if isinstance(v, (list, tuple)):
                    v = list(v)
            for k in keys:
                if (
                    k
                    and k not in df.columns
                    and k not in new_cols
                    and k not in alias_cols
                ):
                    alias_cols[k] = new_cols.get(col, v) if col in new_cols else v
        for k, v in alias_cols.items():
            if v is not None and k not in new_cols and k not in df.columns:
                new_cols[k] = v
    except Exception:
        pass
    if new_cols:
        try:
            const = pd.DataFrame(
                {
                    c: pd.Series([v] * len(df), index=df.index)
                    for c, v in new_cols.items()
                }
            )
            try:
                _attrs = dict(getattr(df, "attrs", {}) or {})
            except Exception:
                _attrs = {}
            df = pd.concat([df, const], axis=1)
            try:
                for _k, _v in _attrs.items():
                    try:
                        df.attrs[_k] = _v
                    except Exception:
                        pass
            except Exception:
                pass
        except Exception:
            for col, val in new_cols.items():
                try:
                    df[col] = val
                except Exception:
                    continue
    try:
        if isinstance(payload, dict):
            if payload.get("data") is not None:
                df.attrs["data"] = payload.get("data")
            if payload.get("config") is not None:
                df.attrs["config"] = payload.get("config")
            if payload.get("info") is not None and "info" not in df.attrs:
                df.attrs["info"] = payload.get("info")
            if payload.get("id") is not None:
                df.attrs["id"] = payload.get("id")
    except Exception:
        pass
    try:
        df = _order_bench_columns(df)
    except Exception:
        pass
    return df


def _restore_attrs(frames, df):
    try:
        for _fr in frames:
            try:
                _a = getattr(_fr, "attrs", {}) or {}
            except Exception:
                _a = {}
            for _k in ("data", "config", "info", "id"):
                if _k in _a and _k not in getattr(df, "attrs", {}):
                    try:
                        df.attrs[_k] = _a[_k]
                    except Exception:
                        pass
    except Exception:
        pass


def _table_number(text, duration=False):
    if isinstance(text, str) and text.strip().lower() in _TABLE_EMPTY:
        return float("nan")
    if duration:
        m = _DURATION_RE.match(str(text).strip())
        if m:
            return float(m.group(1)) * _DURATION_SCALE[m.group(3)]
    try:
        return float(text)
    except (TypeError, ValueError):
        return text


def _token_spans(text):
    spans = []
    start = None
    for i, c in enumerate(text):
        if c.isspace():
            if start is not None:
                spans.append((start, i))
                start = None
        elif start is None:
            start = i
    if start is not None:
        spans.append((start, len(text)))
    return spans


def _table_to_df(text):
    lines = str(text).splitlines()
    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    if not lines:
        return pd.DataFrame()
    header = lines[0]
    tokens = _token_spans(header)
    if not tokens:
        return pd.DataFrame()
    ends = [e for _, e in tokens]
    starts = [0] + [ends[i - 1] + 1 for i in range(1, len(ends))]
    columns = [header[s:e].strip() for s, e in zip(starts, ends)]
    if any(not c for c in columns):
        raise ValueError("unrecognized perf result table")
    rows = [
        [ln[s:e].strip() if s < len(ln) else "" for s, e in zip(starts, ends)]
        for ln in lines[1:]
    ]
    if not rows:
        raise ValueError("perf result table has no rows")
    data = {c: [r[i] for r in rows] for i, c in enumerate(columns)}
    df = pd.DataFrame(data, columns=columns)
    for col in df.columns:
        is_duration = _is_duration_col(col)
        df[col] = [_table_number(v, is_duration) for v in df[col].tolist()]
        try:
            df[col] = pd.to_numeric(df[col], errors="ignore")
        except Exception:
            pass
    return df


def _load(args):
    def read(paths):
        def _is_data(name):
            return name.startswith("perf.data") or name.endswith(".data")

        data = []
        for p in map(Path, paths):
            if p.is_file():
                data.append(p)
            else:
                for f in p.rglob("*"):
                    try:
                        if not f.is_file():
                            continue
                    except OSError:
                        continue
                    name = f.name
                    if name.endswith(".json") or _is_data(name):
                        data.append(f)
        return data

    def _tag_source(df, path):
        try:
            df[_SOURCE_COL] = Path(path).name if path is not None else "<stdin>"
        except Exception:
            pass
        return df

    def _read_envelope_json(path):
        with open(path) as fh:
            payload = json.load(fh)
        if not isinstance(payload, dict) or "output" not in payload:
            raise SystemExit(f"invalid envelope JSON in {path!r}: missing 'output'")
        df = pd.DataFrame(payload.get("output") or [])
        return _tag_source(_merge_envelope_data(payload, df), path)

    if not sys.stdin.isatty():
        try:
            raw = sys.stdin.read()
        except Exception:
            raw = ""
        if raw and raw.strip():
            try:
                payload = json.loads(raw)
            except Exception as ex:
                try:
                    return _table_to_df(raw)
                except Exception:
                    raise SystemExit(
                        f"failed to parse piped data "
                        f"(expected a JSON envelope or a perf result table): {ex}"
                    )
            if not isinstance(payload, dict) or "output" not in payload:
                raise SystemExit("piped JSON must be an envelope with 'output'")
            df = pd.DataFrame(payload.get("output") or [])
            return _tag_source(_merge_envelope_data(payload, df), None)
    if not args.data:
        raise SystemExit("no data paths; use '-- data/' or pipe JSON via stdin")
    files = read(args.data)
    if not files:
        raise SystemExit(f"no data files found in {args.data!r}")
    records, bench_json = [], []
    for f in files:
        try:
            is_rec = perf.is_record(f)
        except Exception:
            is_rec = False
        (records if is_rec else bench_json).append(f)
    frames = []
    if bench_json:
        _env_frames = [_read_envelope_json(f) for f in bench_json]
        _merged = pd.concat(_env_frames, ignore_index=True)
        _restore_attrs(_env_frames, _merged)
        frames.append(_merged)
    if records:
        frames.append(perf.parse(records))
    if not frames:
        raise SystemExit(f"no readable data in {args.data!r}")
    _out = pd.concat(frames, ignore_index=True)
    _restore_attrs(frames, _out)
    return _out


def _resolve_groupby(df, groupby):
    if groupby is None:
        groupby = ",".join(_DEFAULT_GROUPBY)
    keys = _core_split_list(groupby)
    rec = _as_records(df)
    return [c for c in keys if c in rec.columns]


def _resolve_columns(df, columns):
    if columns is None:
        columns = ",".join(_DEFAULT_COLUMNS)
    cols = _core_split_list(columns)
    rec = _as_records(df)
    return [c for c in cols if c in rec.columns]


def _find_baseline_rows(df, key):
    for col in ("file", "name"):
        if col in df.columns:
            try:
                hit = df[col].astype(str) == key
            except Exception:
                continue
            if bool(hit.any()):
                return df[hit], col
    return None, None


def _baseline_values(df, key, metric):
    base, _ = _find_baseline_rows(df, key)
    if base is None:
        raise ValueError(f"baseline group {key!r} not found in 'file'/'name'")
    if metric not in df.columns:
        raise ValueError(f"baseline metric {metric!r} not found in data")
    if "samples" in df.columns and "samples" in base.columns:
        mapping = base.groupby("samples")[metric].mean()
        return df["samples"].map(mapping)
    return float(base[metric].mean())


def _inject_baselines(df, expr, counter):

    temps = []

    def _sub(m):
        key, metric = m.group("key"), m.group("metric")
        values = _baseline_values(df, key, metric)
        safe = (
            "".join(c if c.isalnum() or c == "_" else "_" for c in metric) or "metric"
        )
        tmp = f"{_BASELINE_TMP}_{safe}_{counter[0]}"
        counter[0] += 1
        while tmp in df.columns:
            tmp = f"{tmp}_"
        df[tmp] = values
        temps.append(tmp)
        return tmp

    try:
        rewritten = _BASELINE_RE.sub(_sub, expr)
    except ValueError:
        for t in temps:
            if t in df.columns:
                del df[t]
        raise
    return rewritten, temps


def _derived_metrics(df):
    try:
        is_num = {c: pd.api.types.is_numeric_dtype(df[c]) for c in df.columns}
    except Exception:
        return []
    derived = []
    if is_num.get("operations"):
        for c in _metric_columns(df):
            if is_num.get(c):
                derived.append(f"{c}/operations")
    if is_num.get("cycles") and is_num.get("instructions"):
        derived.append("instructions/cycles")
    return derived


def _quote_hyphenated_columns(df, expr):
    try:
        names = [
            str(c)
            for c in df.columns
            if isinstance(c, str)
            and c
            and not c.isidentifier()
            and c in expr
        ]
    except Exception:
        return expr
    names.sort(key=len, reverse=True)
    for c in names:
        if not c.isidentifier():
            expr = expr.replace(c, f"`{c}`")
    return expr


def _eval_events(df, events):
    df = df.copy()
    if df.index.name in ("file", "name", "mode") or any(
        n in (df.index.names or []) for n in ("file", "name", "mode")
    ):
        df = df.reset_index()
    events = _flat_events(events) or (_metric_columns(df) + _derived_metrics(df))
    if not events:
        raise SystemExit("no metric columns found in data")
    out = []
    counter = [0]
    created = []
    for e in events:
        if e in df.columns:
            out.append(e)
            continue
        try:
            rewritten, temps = _inject_baselines(df, e, counter)
            created.extend(temps)
            rewritten = _quote_hyphenated_columns(df, rewritten)
        except ValueError as ex:
            print(
                f"Warning: failed to evaluate expression {e!r}: {ex}", file=sys.stderr
            )
            continue
        try:
            df[e] = df.eval(rewritten, engine="python")
            out.append(e)
        except Exception as ex:
            print(
                f"Warning: failed to evaluate expression {e!r}: {ex}", file=sys.stderr
            )
    for t in created:
        if t in df.columns:
            del df[t]
    if not out:
        raise SystemExit("no metric columns found in data")
    return df, out


def _apply_filter(df, filter):
    if filter:
        try:
            return df.query(filter, engine="python")
        except Exception as ex:
            raise SystemExit(f"invalid --filter {filter!r}: {ex}")
    return df


def _stat_func(stat):
    s = stat.strip()
    m = re.fullmatch(r"[pP](\d+(?:\.\d+)?)", s)
    if m:
        q = float(m.group(1)) / 100.0
        if not 0 <= q <= 1:
            raise SystemExit(f"invalid percentile {stat!r}; expected p0..p100")

        def _q(x, q=q):
            return float(x.quantile(q))

        _q.__name__ = s.lower()
        return s.lower(), _q
    return s, s


def _aggregate(df, groupby, events, stats):
    rec = df if isinstance(df, pd.DataFrame) else pd.DataFrame(df)
    keys = [c for c in groupby if c in rec.columns]
    if "mode" in rec.columns and "mode" not in keys:
        keys = keys + ["mode"]
    missing_ev = [e for e in events if e not in rec.columns]
    if missing_ev:
        raise SystemExit(f"events not found in data: {', '.join(missing_ev)}")
    if not keys:
        raise SystemExit("no groupby columns found in data")
    grouped = rec.groupby(keys, dropna=False)
    pairs = []
    for stat in stats:
        try:
            pairs.append(_stat_func(stat))
        except SystemExit:
            raise
        except Exception as ex:
            raise SystemExit(f"invalid --stat {stat!r}: {ex}")
    try:
        agg = grouped[events].agg([func for _, func in pairs])
    except Exception:
        rows = []
        for name, func in pairs:
            try:
                part = grouped[events].agg(func)
            except Exception as ex:
                raise SystemExit(f"invalid --stat {name!r}: {ex}")
            part = part.reset_index()
            part.insert(len(keys), "stat", name)
            rows.append(part)
        out = pd.concat(rows, ignore_index=True)
        return out[keys + ["stat"] + list(events)]
    names = [name for name, _ in pairs]
    if isinstance(agg.columns, pd.MultiIndex):
        rows = []
        for i, name in enumerate(names):
            try:
                part = agg.xs(i, axis=1, level=-1)
            except Exception:
                part = agg.iloc[:, i :: len(names)]
                try:
                    part.columns = events
                except Exception:
                    pass
            part = part.reset_index()
            part.insert(len(keys), "stat", name)
            rows.append(part)
        out = pd.concat(rows, ignore_index=True)
        return out[keys + ["stat"] + list(events)]
    agg = agg.reset_index()
    agg.insert(len(keys), "stat", names[0] if names else "")
    return agg[keys + ["stat"] + list(events)]


def _format_table(df):
    out = df.copy()
    for c in out.columns:
        if c in (
            "stat",
            "file",
            "name",
            "mode",
            "time",
            "samples",
            "iterations",
            "operations",
            "address",
            "size",
        ):
            continue
        if c == "duration_time" or str(c).startswith("duration_time/"):
            out[c] = [_format_duration(v) for v in out[c]]
        else:
            try:
                if pd.api.types.is_numeric_dtype(out[c]):
                    out[c] = [_format_number(v) for v in out[c]]
            except Exception:
                pass
    try:
        out = out.where(pd.notna(out), "")
    except Exception:
        pass
    return out


def view_cmd(args):
    df = _load(args)
    df = _apply_filter(_as_records(df), getattr(args, "filter", None))
    df, events = _eval_events(df, args.event)
    stats = (
        _core_split_list(args.stat) if args.stat is not None else list(_DEFAULT_STATS)
    )
    groupby = _resolve_groupby(df, args.groupby)
    columns = _resolve_columns(df, args.column)

    if args.groupby is not None and not _core_split_list(args.groupby):
        data_cols = _data_columns(df, columns + events)
        raw_cols = columns + data_cols + [e for e in events if e not in columns]
        print(_format_table(df[raw_cols]).to_string(index=False))
    elif not stats:
        data_cols = _data_columns(df, columns + events)
        raw_cols = columns + data_cols + [e for e in events if e not in columns]
        print(_format_table(df[raw_cols]).to_string(index=False))
    else:
        out = _aggregate(df, groupby, events, stats)
        show = [c for c in columns if c in out.columns]
        show += [
            c
            for c in _data_columns(out, show + ["stat"] + events)
            if c in out.columns and c not in show
        ]
        show += [c for c in (["stat"] + events) if c in out.columns and c not in show]
        print(_format_table(out[show]).to_string(index=False))

    if args.interactive:
        embed({"perf": perf, "df": df})


def plot_cmd(args):
    plot_config = getattr(args, "plot_config", None) or {}
    perf.plot.config = plot_config
    df = _load(args)
    df = _apply_filter(_as_records(df), getattr(args, "filter", None))
    groupby = _resolve_groupby(df, args.groupby)
    type_groups = _groups(args.type) if args.type else [["ecdf"]]
    if args.event:
        event_groups = _groups(args.event)
        requested = [e for g in event_groups for e in g]
    else:
        event_groups = None
        measured = [c for c in _metric_columns(df) if "/" not in str(c)]
        if "operations" in df.columns and measured:
            requested = [f"{m}/operations" for m in measured]
        else:
            requested = None
    df, metrics = _eval_events(df, requested)
    if event_groups is None:
        if not metrics:
            raise SystemExit("no metric columns found in data")
        perop = [m for m in metrics if str(m).endswith("/operations")]
        picked = perop or metrics
        event_groups = [[m] for m in picked]
    event_groups = [[e for e in g if e in df.columns] for g in event_groups]
    event_groups = [g for g in event_groups if g]
    if not event_groups:
        raise SystemExit("no metric columns found in data")
    xaxis = getattr(args, "xaxis", None)
    if isinstance(xaxis, (list, tuple)):
        xaxis = xaxis[0] if xaxis else None
    if xaxis:
        if (
            xaxis not in df.columns
            and isinstance(xaxis, str)
            and xaxis.startswith("data.")
        ):
            try:
                from perf.plot import _canonical_data_col as _canon_col

                _canon = _canon_col(xaxis)
                if _canon in df.columns:
                    df = df.copy()
                    df[xaxis] = df[_canon].values
                else:
                    for _c in list(df.columns):
                        try:
                            if _canon_col(_c) == _canon:
                                df = df.copy()
                                df[xaxis] = df[_c].values
                                break
                        except Exception:
                            continue
            except Exception:
                pass
        if xaxis not in df.columns:
            try:
                df, _xcols = _eval_events(df, [xaxis])
            except SystemExit:
                try:
                    from perf.bench import data_param_value as _data_val

                    _attrs = getattr(df, "attrs", {}) or {}
                    _v = _data_val(_attrs.get("data"), xaxis)
                    if _v is not None:
                        df = df.copy()
                        df[xaxis] = _v
                    else:
                        raise SystemExit(f"x column not found in data: {xaxis!r}")
                except SystemExit:
                    raise SystemExit(f"x column not found in data: {xaxis!r}")
                except Exception:
                    raise SystemExit(f"x column not found in data: {xaxis!r}")
            if xaxis not in df.columns:
                raise SystemExit(f"x column not found in data: {xaxis!r}")
    output = getattr(args, "output", None)
    logx = bool(getattr(args, "logx", False))
    logy = bool(getattr(args, "logy", False))
    try:
        perf.plot(
            df,
            type_groups,
            event_groups,
            groupby=groupby,
            x=xaxis,
            output=output,
            logx=logx,
            logy=logy,
        )
    except KeyError as e:
        raise SystemExit(e.args[0] if e.args else e)

    if args.interactive:
        try:
            import matplotlib.pyplot as plt
        except Exception:
            plt = None
        embed({"perf": perf, "df": df, "plt": plt})


def _compare_variant(df):
    try:
        n_names = df["name"].nunique(dropna=False) if "name" in df.columns else 0
    except Exception:
        n_names = 0
    try:
        n_files = df["file"].nunique(dropna=False) if "file" in df.columns else 0
    except Exception:
        n_files = 0
    try:
        n_src = (
            df[_SOURCE_COL].nunique(dropna=False) if _SOURCE_COL in df.columns else 1
        )
    except Exception:
        n_src = 1
    if n_names >= 2:
        try:
            key = df["name"].astype(str)
            run = key.copy()
            if "file" in df.columns:
                run = run + "\x00" + df["file"].astype(str)
            if _SOURCE_COL in df.columns:
                run = run + "\x00" + df[_SOURCE_COL].astype(str)
            nested = run.groupby(key, dropna=False).nunique(dropna=False) <= 1
            if bool(nested.all()):
                return "name"
        except Exception:
            pass
    if n_files >= 2:
        return "file"
    if n_src >= 2:
        return _SOURCE_COL
    return "name"


def compare_cmd(args):
    from perf.compare import DEFAULT_ALPHA, compare

    try:
        alpha = float(getattr(args, "alpha", DEFAULT_ALPHA) or DEFAULT_ALPHA)
    except (TypeError, ValueError):
        raise SystemExit("--alpha must be a float in (0, 1)")
    if not 0.0 < alpha < 1.0:
        raise SystemExit("--alpha must be in (0, 1)")
    df = _load(args)
    df = _apply_filter(_as_records(df), getattr(args, "filter", None))
    if "name" not in df.columns and "sym" in df.columns:
        df = df.copy()
        df["name"] = df["sym"].astype(str)
        if "mode" not in df.columns:
            df["mode"] = "record"
    if "name" not in df.columns:
        raise SystemExit("cannot compare: no benchmark names ('name'/'sym') in data")
    requested = _flat_events(args.event)
    if not requested and "sym" in df.columns:
        requested = [c for c in _metric_columns(df) if c not in ("pid", "ip")] or None
    df, events = _eval_events(df, requested)
    variant = _compare_variant(df)
    try:
        out = compare(
            df,
            events=events,
            baseline=getattr(args, "baseline", None),
            alpha=alpha,
            variant=variant,
        )
    except ValueError as ex:
        raise SystemExit(str(ex))
    if _want_json(args):
        print(out.to_json(orient="records", indent=4), flush=True)
    else:
        print(_format_cmp_table(out).to_string(index=False))
    if args.interactive:
        embed({"perf": perf, "df": out})


def _track_filter(filt):
    if filt is None:
        return None
    if isinstance(filt, str):
        filt = [filt]
    out = []
    for f in filt:
        if f is None:
            continue
        if isinstance(f, (list, tuple)):
            parts = [str(x).strip() if x is not None else "" for x in f]
            if len(parts) != 2 or not all(parts):
                raise SystemExit(
                    f"invalid --filter {f!r}; expected 'name' or 'begin..end'"
                )
            out.append((parts[0], parts[1]))
            continue
        s = str(f).strip()
        if not s:
            continue
        if ".." in s:
            b, _, e = s.partition("..")
            b, e = b.strip(), e.strip()
            if not b or not e:
                raise SystemExit(
                    f"invalid --filter {f!r}; expected 'name' or 'begin..end'"
                )
            out.append((b, e))
        else:
            out.append(s)
    return out or None


def track_cmd(args):
    from perf.track import DEFAULT_OUTPUT, track

    cmd = list(getattr(args, "command", None) or [])
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if getattr(args, "list", False):
        if not cmd:
            raise SystemExit("perf track --list needs a binary, e.g. `perf track --list -- ./a.out`")
        from perf.exec import resolve_exec as _resolve

        try:
            target = _resolve(cmd[0])
        except Exception as ex:
            raise SystemExit(str(ex))
        _print_available(target, None)
        return
    if not cmd:
        raise SystemExit("perf track needs a command, e.g. `perf track -- ./a.out`")
    out = getattr(args, "output", DEFAULT_OUTPUT)
    if out in ("", "none", "None"):
        out = None
    try:
        raw_size = getattr(args, "buffer_size", 65536)
        slots = 65536 if raw_size is None else int(raw_size)
    except (TypeError, ValueError):
        raise SystemExit("--buffer-size must be an integer")
    if slots <= 0:
        raise SystemExit("--buffer-size must be > 0")
    filt = _track_filter(getattr(args, "filter", None))
    try:
        df = track(
            cmd,
            event=getattr(args, "event", None),
            filter=filt,
            output=out,
            buffer_size=slots,
        )
    except ValueError as ex:
        raise SystemExit(str(ex))
    except KeyboardInterrupt:
        print("perf track interrupted (partial results dumped)", file=sys.stderr)
        raise SystemExit(130)
    if out is None:
        print(_format_trace_table(df))
    else:
        print(f"tracked {len(df)} samples -> {out}", file=sys.stderr, flush=True)
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def _format_cmp_table(df):
    out = df.copy()
    if "result" in out.columns and "significant" in out.columns:
        try:
            out = out.drop(columns=["significant"])
        except Exception:
            pass
    for c in out.columns:
        if c in ("event", "baseline", "challenger", "name", "mode", "result"):
            continue
        if c == "p_value":
            out[c] = [_format_p_value(v) for v in out[c]]
        elif c == "significant":
            out[c] = ["yes" if bool(v) else "no" for v in out[c]]
        elif c in ("diff", "ci_low", "ci_high"):
            out[c] = [
                f"{float(v):+.2f}%" if _is_finite_number(v) else "" for v in out[c]
            ]
        elif _is_duration_col(c):
            out[c] = [_format_duration(v) for v in out[c]]
        else:
            try:
                if pd.api.types.is_numeric_dtype(out[c]):
                    out[c] = [_format_number(v) for v in out[c]]
            except Exception:
                pass
    try:
        out = out.where(pd.notna(out), "")
    except Exception:
        pass
    return out


def _is_finite_number(v):
    f = _to_float(v)
    if f is None:
        return False
    try:
        import math as _math

        return bool(_math.isfinite(f))
    except Exception:
        return False


def _format_p_value(v):
    f = _to_float(v)
    if f is None:
        try:
            float(v)
            return ""
        except (TypeError, ValueError):
            return str(v)
    if f < 0.001:
        return f"{f:.2e}"
    return f"{f:.4f}"


def _split_seq(text):

    return [y for y in re.split(r"[,\s]+", text.strip()) if y.strip()]


def _parse_scalar(text):
    s = text.strip()
    if s.lower() == "true":
        return True
    if s.lower() == "false":
        return False
    try:
        return int(s, 0)
    except ValueError:
        pass
    try:
        return float(s)
    except ValueError:
        pass
    return s


def _parse_atom(text):
    text = text.strip()
    if text.startswith("{") and text.endswith("}"):
        return _parse_value(text)
    if text.startswith("[") and text.endswith("]"):
        return [_parse_atom(y) for y in _split_seq(text[1:-1])]
    if "," in text:
        return [_parse_atom(y) for y in text.split(",") if y.strip()]
    return _parse_scalar(text)


def _parse_value(text):
    v = text.strip()
    if v.startswith("{") and v.endswith("}"):
        body = v[1:-1].strip()
        if not body:
            return {}
        d = {}
        for item in body.split(","):
            if ":" not in item:
                raise ValueError(f"invalid dict item: {item!r}")
            k, val = item.split(":", 1)
            d[k.strip()] = _parse_value(val.strip())
        return d
    if v.startswith("[") and v.endswith("]"):
        return [_parse_atom(x) for x in _split_seq(v[1:-1])]
    if "," in v:
        return [x.strip() for x in v.split(",") if x.strip()]
    if ":" in v and not v.startswith("[") and "," not in v:
        k, val = v.split(":", 1)
        return {k.strip(): _parse_value(val.strip())}
    return _parse_scalar(v)


def _resolve_plot_config(args, unknown):
    config = {}
    if getattr(args, "config", None):
        with open(args.config) as f:
            loaded = json.load(f)
        if isinstance(loaded, dict):
            config.update(loaded)
    for arg in unknown or ():
        if "=" not in arg or not arg.startswith("--config."):
            raise SystemExit(f"unknown argument: {arg}")
        key, value = arg[len("--config.") :].split("=", 1)
        try:
            val = _parse_value(value)
        except ValueError as ex:
            raise SystemExit(str(ex))
        d = config
        parts = key.split(".")
        for p in parts[:-1]:
            nxt = d.get(p)
            if not isinstance(nxt, dict):
                nxt = {}
                d[p] = nxt
            d = nxt
        d[parts[-1]] = val
    return config


def parse(parser):
    raw = sys.argv[1:]
    args, unknown = parser.parse_known_args(raw)

    config = json.loads(json.dumps(_DEFAULT_BENCH))

    def _parse_cli_value(v):
        try:
            return _parse_value(v)
        except ValueError as ex:
            parser.error(str(ex))

    def _store_mem_range(base_str, val, rest_hint=""):
        entries = list(_mem_entries(base_str, val))
        if not entries:
            parser.error(f"unknown data key: --data{rest_hint or base_str}")
            return
        for k, v in entries:
            data["mem"][k] = v

    def _apply_data_override(rest, val):

        bracket = rest.find("[")
        if bracket != -1 and rest.endswith("]"):
            ns = rest[:bracket]
            inner = rest[bracket + 1 : -1]
            if ns == "":
                if _is_mem_addr_key(inner):
                    _store_mem_range(inner, val, rest)
                else:
                    data["regs"][_canonical_data_reg_key(inner)] = val
                return
            parser.error(
                f"unknown data key: --data{rest} "
                "(use --data.rdi=.., --data.0x1000=.., --data[0x1000]=..)"
            )
            return
        if "." in rest:
            parser.error(
                f"unknown data key: --data.{rest} "
                "(use --data.rdi=.., --data.0x1000=.., --data[0x1000]=..)"
            )
            return

        if _is_mem_addr_key(rest):
            _store_mem_range(rest, val, rest)
            return
        data["regs"][_canonical_data_reg_key(rest)] = val

    def _preset_config(loaded):
        if "data" in loaded:
            parser.error(
                "config file must not contain 'data'; use --data instead (e.g. "
                "--data.rdi=15 or --data '{\"rdi\": 15}')"
            )
        from perf.bench import _normalize_spec as _norm_spec

        return _norm_spec(_deep_merge(config, loaded))

    def _expand_intermediate(top, cur):
        if top == "cache" and isinstance(cur, str):
            sc = _x86_arch._MEMORY_SHORTCUTS.get(cur.strip().lower())
            if sc is None:
                parser.error(
                    f"unknown cache shortcut {cur!r}; expected one of "
                    "'hot', 'warm', 'cool', 'cold'"
                )
            return dict(sc)
        if top == "branch" and isinstance(cur, (str, bool)):
            if isinstance(cur, bool):
                pred = "predictable" if cur else "unpredictable"
            else:
                from perf.bench import _BRANCH_ALIASES as _BA
                from perf.bench import _BRANCH_CHOICES as _BC
                from perf.bench import _branch_value as _bv

                pred = _bv(cur)
                if pred is None:
                    parser.error(
                        f"branch prediction must be one of "
                        f"{', '.join(_BC + tuple(_BA))}, "
                        f"got {cur!r}"
                    )
            return {"prediction": pred}
        if top == "func" and isinstance(cur, str):
            return {"order": cur}
        if top == "code" and isinstance(cur, (int, str)) and not isinstance(cur, bool):
            return {"align": cur}
        return {}

    def _check_top(top):
        from perf.bench import _VALID_TOP_KEYS as _TOP

        if top not in _TOP:
            parser.error(
                f"unknown argument: --config.{top} "
                f"(expected one of {', '.join(sorted(_TOP))})"
            )

    def _check_nested(top, leaf):
        if top == "thread" and leaf not in ("affinity", "priority"):
            parser.error(
                f"unknown argument: --config.thread.{leaf} "
                "(expected 'affinity' or 'priority')"
            )
        if top == "func" and leaf not in ("align", "order"):
            parser.error(
                f"unknown argument: --config.func.{leaf} (expected 'align' or 'order')"
            )
        if top == "code" and leaf not in ("align",):
            parser.error(f"unknown argument: --config.code.{leaf} (expected 'align')")
        if top == "stack" and leaf not in ("size", "align"):
            parser.error(
                f"unknown argument: --config.stack.{leaf} (expected 'size' or 'align')"
            )

    def _apply_config_override(rest, value):
        bracket = rest.find("[")
        if bracket != -1 and rest.endswith("]"):
            key = rest[:bracket]
            addr = rest[bracket + 1 : -1]
            parts = [p for p in key.split(".") if p]
            if not parts:
                parser.error(f"unknown argument: --config.{rest}")
            _check_top(parts[0])
            if len(parts) >= 2:
                _check_nested(parts[0], parts[1])
            top = parts[0]
            leaf = parts[-1]
            if top not in ("branch", "cache"):
                parser.error(
                    f"per-address overrides --config.{rest} are only supported "
                    "for branch/cache (e.g. --config.cache.L1d[0x1000]=hot)"
                )
            d = config
            for p in parts[:-1]:
                nxt = d.get(p)
                if not isinstance(nxt, dict):
                    if p == parts[0] and nxt is not None:
                        nxt = _expand_intermediate(p, nxt)
                    else:
                        nxt = {} if nxt is None else _expand_intermediate(top, nxt)
                        if not isinstance(nxt, dict):
                            nxt = {}
                    d[p] = nxt
                d = nxt
            cur = d.get(leaf)
            base = dict(cur) if isinstance(cur, dict) else {}
            base[addr] = value
            d[leaf] = base
            return
        d = config
        parts = [p for p in rest.split(".") if p]
        if not parts:
            parser.error(f"unknown argument: --config.{rest}")
        _check_top(parts[0])
        if len(parts) >= 2:
            if parts[0] in ("thread", "func", "code", "stack"):
                _check_nested(parts[0], parts[1])
        for p in parts[:-1]:
            nxt = d.get(p)
            if not isinstance(nxt, dict):
                if nxt is None:
                    nxt = {}
                else:
                    nxt = _expand_intermediate(parts[0], nxt)
                d[p] = nxt
            d = nxt
        d[parts[-1]] = value

    data = {"regs": {}, "mem": {}}
    if getattr(args, "config", None):
        with open(args.config) as f:
            config = _preset_config(json.load(f))

    for arg in unknown:
        if "=" not in arg:
            parser.error(f"unknown argument: {arg}")

        if arg.startswith("--data["):
            key, value = arg[len("--data") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_data_override(key, _parse_cli_value(value))
            continue
        if arg.startswith("--data."):
            key, value = arg[len("--data.") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_data_override(key, _parse_cli_value(value))
            continue
        if arg.startswith("--config."):
            key, value = arg[9:].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_config_override(key, _parse_cli_value(value))
        else:
            parser.error(f"unknown argument: {arg}")

    flag_data = None
    if getattr(args, "data", None):
        raw_data = args.data
        if os.path.isfile(raw_data):
            with open(raw_data) as f:
                flag_data = json.load(f)
        else:
            try:
                flag_data = json.loads(raw_data)
            except json.JSONDecodeError as ex:
                parser.error(f"invalid --data JSON: {ex}")
    try:
        from perf.bench import validate_spec as _validate_cfg

        _validate_cfg(config)
    except ValueError as ex:
        parser.error(str(ex))
    args.config = config
    has_data = bool((data.get("regs") or data.get("mem")) or flag_data)
    args.data = _merge_data(data, flag_data) if has_data else None

    return args


def _bench_subcommand(argv):
    for a in argv:
        if not a.startswith("-"):
            return a
    return None


_PERFCONFIG_PATH = "~/.perfconfig"
_PERFCONFIG_COMMANDS = frozenset({"bench", "view", "plot", "compare", "info", "track"})


def _load_perfconfig(path=None):
    p = Path(
        os.path.expanduser(path or os.environ.get("PERF_CONFIG") or _PERFCONFIG_PATH)
    )
    if not p.is_file():
        return {}
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        cp.read(p)
    except configparser.Error:
        return {}
    return {sec: dict(cp.items(sec)) for sec in cp.sections()}


def _find_subparser(parser, command):
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for name, sub in action.choices.items():
                if name == command:
                    return sub
    return None


def _present_options(argv):
    present = set()
    for a in argv:
        if a == "--":
            break
        if a.startswith("--"):
            present.add(a[2:].split("=", 1)[0])
        elif a.startswith("-") and len(a) > 1:
            present.add(a[:2].lstrip("-"))
    return present


def _subparsers_of(sub):
    if sub is None:
        return []
    out = []
    for action in getattr(sub, "_actions", ()):
        if isinstance(action, argparse._SubParsersAction):
            out.extend(action.choices.values())
    return out


def _option_aliases(sub, key):
    if key.startswith(("config.", "data.")):
        return {key}
    aliases = {key}
    queue = [sub] if sub is not None else []
    seen = set()
    while queue:
        cur = queue.pop()
        if cur is None or id(cur) in seen:
            continue
        seen.add(id(cur))
        for action in getattr(cur, "_actions", ()):
            if action.dest == key:
                aliases |= {o.lstrip("-") for o in action.option_strings}
        queue.extend(_subparsers_of(cur))
    return aliases


def _key_applies(sub, command, key):
    if key.startswith(("config.", "data.")):
        return command in ("bench", "plot")
    if sub is None:
        return False
    queue = [sub]
    seen = set()
    while queue:
        cur = queue.pop()
        if cur is None or id(cur) in seen:
            continue
        seen.add(id(cur))
        for action in getattr(cur, "_actions", ()):
            if action.dest == key:
                return True
            if any(o.lstrip("-") == key for o in action.option_strings):
                return True
        queue.extend(_subparsers_of(cur))
    return False


def _apply_perfconfig(parser, command, argv, config_path=None):
    cfg = _load_perfconfig(config_path)
    if not cfg:
        return argv
    entries = {}
    order = []
    for sec in ("default", command):
        if sec not in cfg:
            continue
        for key, value in cfg[sec].items():
            if key not in entries:
                order.append(key)
            entries[key] = value
    if not entries:
        return argv
    present = _present_options(argv)
    sub = _find_subparser(parser, command)
    pending = []
    for key in order:
        if key in present:
            continue
        if any(a in present for a in _option_aliases(sub, key)):
            continue
        if not _key_applies(sub, command, key):
            continue
        pending.append(f"--{key}={entries[key]}")
    if not pending:
        return argv
    return [argv[0]] + pending + list(argv[1:])


if __name__ == "__main__":
    pd.set_option("display.width", None)
    pd.set_option("display.max_rows", None)
    pd.set_option("display.max_columns", None)

