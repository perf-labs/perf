        help="emit JSON records to stdout",
    )
    info.add_argument(
        "-c",
        "--column",
        dest="column",
        default=None,
        help="columns to show, e.g. -c cpu,core,platform,L1d (default: all)",
    )
    info.add_argument("-i", "--interactive", action="store_true")
    info.set_defaults(func=None)

    track_p = subparsers.add_parser(
        "track",
        help="trace labels/functions with startup-only ptrace + native rdpmc",
    )
    track_p.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="events to count via rdpmc, e.g. -e cycles,branch-misses (default: "
        "cycles; duration_time uses rdtsc; topdown expands to the four level-1 "
        "topdown events with the slots leader added automatically)",
    )
    track_p.add_argument(
        "-f",
        "--filter",
        dest="filter",
        action="append",
        default=None,
        help="only track these targets (repeatable): PERF_LABEL names, "
        "function names (entry/exit via return-address "
        "interception, e.g. -f fizz_buzz), hex addresses, or begin..end "
        "regions (sides may mix); default tracks all functions and labels",
    )
    track_p.add_argument(
        "--list",
        dest="list",
        action="store_true",
        help="list trackable funcs/regions/labels of the binary instead of measuring",
    )
    track_p.add_argument(
        "-o",
        "--output",
        dest="output",
        default="track.json",
        help="JSON output path (default: track.json; pass 'none' to skip saving)",
    )
    track_p.add_argument(
        "--buffer-size",
        dest="buffer_size",
        type=int,
        default=65536,
        help="ring-buffer size in slots, rounded up to a power of two (default: 65536)",
    )
    track_p.add_argument("-i", "--interactive", action="store_true")
    track_p.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="binary and args to run, e.g. `-- ./a.out`",
    )
    track_p.set_defaults(func=track_cmd)

    argv = sys.argv[1:]
    command = _bench_subcommand(argv)

    if command in _PERFCONFIG_COMMANDS:
        applied = _apply_perfconfig(parser, command, argv)
        if applied is not argv:
            argv = applied
            sys.argv = [sys.argv[0]] + applied

    if command == "track":
        if "--" in argv:
            sep = argv.index("--")
            opt_argv, cmd = argv[:sep], argv[sep + 1 :]
        else:
            opt_argv, cmd = argv, []
        args = parser.parse_args(opt_argv)
        if not cmd and getattr(args, "command", None):
            cmd = list(args.command)
            if cmd and cmd[0] == "--":
                cmd = cmd[1:]
        args.command = cmd
        args.func(args)
    elif command in ("view", "plot", "compare"):
        data_argv = argv
        data_paths = []
        if "--" in data_argv:
            separator = data_argv.index("--")
            data_argv = data_argv[:separator]
            data_paths = argv[separator + 1 :]
        args, unknown = parser.parse_known_args(data_argv)
        args.data = data_paths
        if command == "plot":
            args.plot_config = _resolve_plot_config(args, unknown)
        elif unknown:
            parser.error(f"unknown argument: {unknown[0]}")
        args.func(args)
    elif command == "info":
        args = parser.parse_args(argv)
        target = (getattr(args, "file", None) or "").strip()
        if target == "" or target == "cpu":
            if target == "":
                parser.error("perf info needs a target, e.g. `perf info cpu` or `perf info a.out`")
            info_cpu_cmd(args)
        else:
            info_file_cmd(args)
    elif command == "bench":
        bench_argv = argv[1:]
        if "--" in bench_argv:
            parser.error(
                "remove `--`: use `perf bench asm 'rdtsc'`, "
                "`perf bench <file> <target>` or "
                "`perf bench <file> --list`"
            )
        probe, _ = parser.parse_known_args(argv)
        file = getattr(probe, "file", None)
        if file is not None and file != "asm" and "--list" not in argv:
            from perf.exec import is_bench_file as _is_bench_file

            if not _is_bench_file(file):
                _exec_system_perf(argv)
        sys.argv = [sys.argv[0], "bench"] + bench_argv
        args = parse(parser)
        if not hasattr(args, "asm") or args.asm is None:
            args.asm = None
        args.func(args)
    else:
        _exec_system_perf(argv)
