arch = get_arch()

_COMMAND = "benchmark"
_DOTTED_KEYS = ("config.", "data.")


def apply_perfconfig(parser, argv, config_path=None):
    return _data_apply(
        parser,
        argv,
        _COMMAND,
        config_path,
        dotted_keys=_DOTTED_KEYS,
    )


def print_table(df, max_rows=None, chunk_rows=1000):
    return _data_print_table(
        df,
        max_rows=max_rows,
        chunk_rows=chunk_rows,
        formatter=format_table,
    )


def _config_entries(path=None):
    return perfconfig_entries(_COMMAND, path)


def _known(parser, key):
    return _data_known(parser, key, _DOTTED_KEYS)


def _aliases(parser, key):
    return _data_aliases(parser, key, _DOTTED_KEYS)


_DEFAULT_MODES = list(_MODES)
_ASM_MODE_BACKENDS = {"latency": "unroll", "throughput": "loop"}
_USAGE = (
    "expected `perf benchmark a.out:func`, "
    "`perf benchmark a.out:hot_begin..hot_end`, "
    "`perf benchmark a.s:label` or `perf benchmark 'mov eax, 42'`"
)
_ARGV_HELP = (
    "arguments after `--` are the benchmarked program's own (argv[0] defaults to "
    "the file, so `perf benchmark /usr/bin/tree:main -- /path/to/folder` runs "
    '`main(2, ["/usr/bin/tree", "/path/to/folder"])`); argc/argv/envp go in '
    "rdi/rsi/rdx and the strings, the vectors and the auxiliary vector are "
    "written into the harness's own stack, so options for perf benchmark come "
    "before the `--` and need no escaping"
)


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.cycles
    df.groupby(["name", "mode"]).cycles.describe()
    df.ecdf()
    %notebook session.ipynb""")

    import sys

    if not getattr(sys.stdin, "isatty", lambda: False)():
        try:
            sys.stdin = open("/dev/tty")
        except Exception:
            pass

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def groups(value, expand=True):
    return _split_groups(value, [_DURATION_TIME], expand=expand)


def label(value):
    text = "" if value is None else str(value)
    if not text.strip() or text.strip().lower() in ("nan", "none", "nat"):
        return ""
    return text


def bench_snippet(raw, file=None, what="setup"):
    if raw is None:
        return None
    values = raw if isinstance(raw, (list, tuple)) else [raw]
    names = []
    for value in values:
        other, target, asm = bench_code(value)
        if other is not None:
            if file is None:
                raise SystemExit(
                    f"{what} {value!r} names a file, but the benchmark is a snippet"
                )
            if other != file:
                raise SystemExit(f"{what} {value!r} must be a symbol of {file!r}")
        name = target if target is not None else asm
        if name is not None:
            names.append(name)
    return names or None


def parse_target_args(parser, argv):
    args, unknown = parser.parse_known_args(argv)
    config = copy.deepcopy(_DEFAULT_BENCH)
    explicit = set()

    def _cli_value(value):
        try:
            return parse_value(value)
        except ValueError as ex:
            parser.error(str(ex))

    def _store_mem_range(base_str, value, rest_hint=""):
        try:
            entries = list(_mem_entries(base_str, value))
        except ValueError as ex:
            parser.error(str(ex))
            return
        if not entries:
            parser.error(f"unknown data key: --data{rest_hint or base_str}")
            return
        for k, v in entries:
            data["mem"][k] = v

    def _apply_data_override(rest, value):
        bracket = rest.find("[")
        if bracket != -1 and rest.endswith("]"):
            ns = rest[:bracket]
            inner = rest[bracket + 1 : -1]
            if ns:
                parser.error(
                    f"unknown data key: --data{rest} "
                    "(use --data.rdi=.., --data.0x1000=.., --data[0x1000]=..)"
                )
                return
            if _is_mem_addr_key(inner):
                _store_mem_range(inner, value, rest)
            else:
                data["regs"][_canonical_data_reg_key(inner)] = value
            return
        if "." in rest:
            parser.error(
                f"unknown data key: --data.{rest} "
                "(use --data.rdi=.., --data.0x1000=.., --data[0x1000]=..)"
            )
            return
        if _is_mem_addr_key(rest):
            _store_mem_range(rest, value, rest)
            return
        data["regs"][_canonical_data_reg_key(rest)] = value

    def _expand_intermediate(top, cur):
        if top in _CACHE_KEYS:
            if isinstance(cur, (int, float)) and not isinstance(cur, bool):
                return {"hit_rate": int(cur)}
            if isinstance(cur, str):
                table = (
                    arch._MEMORY_SHORTCUTS if top == "dcache" else arch._TIER_SHORTCUTS
                )
                shortcut = table.get(cur.strip().lower())
                if shortcut is None:
                    parser.error(
                        f"unknown cache shortcut {cur!r}; expected one of "
                        "'hot', 'warm', 'cool', 'cold'"
                    )
                if top == "dcache":
                    return {
                        ("L1" if tier == "L1d" else tier): rate
                        for tier, rate in shortcut.items()
                    }
                tier = {"icache": "L1i", "dtlb": "TLBd", "itlb": "TLBi"}[top]
                return {"hit_rate": shortcut[tier]}
        if top == "branch" and isinstance(cur, (str, bool)):
            if isinstance(cur, bool):
                prediction = "predictable" if cur else "unpredictable"
            else:
                prediction = _branch_value(cur)
                if prediction is None:
                    parser.error(
                        "branch prediction must be one of "
                        f"{', '.join(_BRANCH_CHOICES)}, got {cur!r}"
                    )
            return {"prediction": prediction}
        return {}

    def _container_alternatives(key):
        entries = normalize_container(key, config.get(key))
        if not isinstance(entries, list):
            entries = [entries]
        return [
            copy.deepcopy(entry)
            if isinstance(entry, dict)
            else {"value": copy.deepcopy(entry)}
            for entry in entries
        ] or [{}]

    def _base_alternative(top, current):
        if isinstance(current, dict):
            return copy.deepcopy(current)
        if isinstance(current, (str, bool, int, float)):
            return dict(_expand_intermediate(top, current))
        return {}

    def _rate_dict(value):
        if isinstance(value, dict):
            return dict(value)
        if isinstance(value, (int, float)) and not isinstance(value, bool):
            return {"hit_rate": int(value)}
        return {}

    def _address_alternative(top, parts, current, addr, value):
        base = _base_alternative(top, current)
        if top == "branch" and len(parts) == 2:
            nest = base.get(parts[1])
            nest = dict(nest) if isinstance(nest, dict) else {}
            nest[addr] = value
            base[parts[1]] = nest
            return base
        if top == "dcache" and len(parts) == 2:
            inner = _rate_dict(base.get(parts[-1]))
            inner[addr] = value
            base[parts[-1]] = inner
            return base
        base[addr] = value
        return base

    def _apply_container_sweep(parts, value):
        key, leaf, path = parts[0], parts[-1], parts[1:-1]
        out = []
        seen = set()
        for base in _container_alternatives(key):
            node = base
            for part in path:
                nxt = node.get(part)
                if not isinstance(nxt, dict):
                    nxt = {}
                    node[part] = nxt
                node = nxt
            node.pop(leaf, None)
            signature = _stable(base)
            if signature in seen:
                continue
            seen.add(signature)
            for item in value:
                concrete = copy.deepcopy(base)
                target = concrete
                for part in path:
                    target = target[part]
                target[leaf] = item
                out.append(concrete)
        config[key] = out

    def _pin_container(key):
        cur = config.get(key)
        if not isinstance(cur, list):
            return cur if isinstance(cur, dict) else {}
        first = cur[0] if cur else None
        while isinstance(first, list) and first:
            first = first[0]
        entry = dict(first) if isinstance(first, dict) else {}
        config[key] = [[entry]] if key == "thread" else [entry]
        return entry

    def _check_top(top):
        if top not in _VALID_TOP_KEYS:
            parser.error(
                f"unknown argument: --config.{top} "
                f"(expected one of {', '.join(sorted(_VALID_TOP_KEYS))})"
            )

    def _check_nested(top, leaf, parts=()):
        expected = {
            "thread": ("affinity", "priority", "numa"),
            "func": ("align", "order"),
            "code": ("align",),
            "stack": ("size", "align", "mode"),
            "heap": ("size", "mode"),
            "iterations": ("min", "max"),
            "external": ("lib", "stdout", "stderr"),
        }.get(top)
        if expected is not None and leaf not in expected:
            parser.error(
                f"unknown argument: --config.{top}.{leaf} "
                f"(expected {', '.join(repr(e) for e in expected)})"
            )
        if top == "backend":
            name = leaf
            if name not in _BACKENDS:
                parser.error(
                    f"unknown argument: --config.backend.{name} (expected "
                    f"{' or '.join(_BACKENDS)}, or one of "
                    f"{', '.join(sorted(_BACKEND_OPTION_KEYS))})"
                )
            if len(parts) >= 3 and parts[2] not in _BACKEND_OPTION_KEYS:
                parser.error(
                    f"unknown argument: --config.backend.{name}.{parts[2]} "
                    f"(expected one of {', '.join(sorted(_BACKEND_OPTION_KEYS))})"
                )
            if len(parts) > 3:
                parser.error(f"unknown argument: --config.{'.'.join(parts)}")

    def _apply_config_override(rest, value):
        bracket = rest.find("[")
        if bracket != -1 and rest.endswith("]"):
            key = rest[:bracket]
            addr = rest[bracket + 1 : -1]
            parts = [p for p in key.split(".") if p]
            if not parts:
                parser.error(f"unknown argument: --config.{rest}")
            _check_top(parts[0])
            explicit.add(parts[0])
            if len(parts) >= 2:
                _check_nested(parts[0], parts[1], parts)
            top = parts[0]
            if top not in ("branch",) + _CACHE_KEYS:
                parser.error(
                    f"per-address overrides --config.{rest} are only supported "
                    "for branch and the cache/tlb keys "
                    "(e.g. --config.dcache.L1[0x1000]=hot)"
                )
            if top == "branch":
                if len(parts) > 2:
                    parser.error(f"unknown argument: --config.{rest}")
                if len(parts) == 2 and parts[1] not in ("mem", "regs"):
                    parser.error(
                        f"unknown argument: --config.branch.{parts[1]} "
                        "(expected 'mem' or 'regs')"
                    )
            elif top == "dcache":
                if len(parts) > 2:
                    parser.error(f"unknown argument: --config.{rest}")
                if len(parts) == 2 and parts[1] not in ("L1", "L2", "L3"):
                    parser.error(
                        f"unknown argument: --config.dcache.{parts[1]} "
                        "(expected 'L1', 'L2' or 'L3')"
                    )
            elif len(parts) > 1:
                parser.error(f"unknown argument: --config.{rest}")
            current = config.get(top)
            alternatives = current if isinstance(current, list) else [current]
            out = [
                _address_alternative(top, parts, alt, addr, value)
                for alt in alternatives
            ]
            config[top] = out if isinstance(current, list) else (out[0] if out else {})
            return
        parts = [p for p in rest.split(".") if p]
        if not parts:
            parser.error(f"unknown argument: --config.{rest}")
        _check_top(parts[0])
        explicit.add(parts[0])
        if len(parts) >= 2:
            _check_nested(parts[0], parts[1], parts)
        if parts[0] in (*_LIST_TOPS, "thread"):
            if len(parts) == 1:
                config[parts[0]] = normalize_container(parts[0], value)
                return
            if isinstance(value, list) and parts[0] in (
                "code",
                "stack",
                "heap",
                "func",
            ):
                _apply_container_sweep(parts, value)
                return
            node = _pin_container(parts[0])
            for p in parts[1:-1]:
                nxt = node.get(p)
                if not isinstance(nxt, dict):
                    nxt = {}
                    node[p] = nxt
                node = nxt
            node[parts[-1]] = value
            return
        node = config
        for p in parts[:-1]:
            nxt = node.get(p)
            if not isinstance(nxt, dict):
                nxt = {} if nxt is None else _expand_intermediate(parts[0], nxt)
                node[p] = nxt
            node = nxt
        if (
            parts[0] == "dcache"
            and len(parts) == 2
            and parts[-1] == "hit_rate"
            and isinstance(node, dict)
        ):
            for tier in ("L1", "L2", "L3"):
                node.pop(tier, None)
        node[parts[-1]] = value

    data = {"regs": {}, "mem": {}}
    if getattr(args, "config", None):
        try:
            with open(args.config) as f:
                loaded = loads_json(f.read())
        except OSError as ex:
            parser.error(f"cannot read --config {args.config!r}: {ex}")
        except ValueError as ex:
            parser.error(f"invalid JSON in --config {args.config!r}: {ex}")
        if not isinstance(loaded, dict):
            parser.error("config file must contain a JSON object")
        if "data" in loaded:
            parser.error(
                "config file must not contain 'data'; use --data instead (e.g. "
                "--data.rdi=15 or --data '{\"rdi\": 15}')"
            )
        explicit.update(loaded.keys())
        merged = _deep_merge(config, loaded)
        if _backend_mode_map(loaded.get("backend")):
            merged["backend"] = copy.deepcopy(loaded["backend"])
        config = _normalize_spec(merged)

    for arg in unknown:
        if "=" not in arg:
            parser.error(f"unknown argument: {arg}")
        if arg.startswith("--data["):
            key, value = arg[len("--data") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_data_override(key, _cli_value(value))
            continue
        if arg.startswith("--data."):
            key, value = arg[len("--data.") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_data_override(key, _cli_value(value))
            continue
        if arg.startswith("--config."):
            key, value = arg[len("--config.") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_config_override(key, _cli_value(value))
            continue
        parser.error(f"unknown argument: {arg}")

    flag_data = None
    if getattr(args, "data", None):
        raw_data = args.data
        if os.path.isfile(raw_data):
            try:
                with open(raw_data) as f:
                    flag_data = loads_json(f.read())
            except OSError as ex:
                parser.error(f"cannot read --data {raw_data!r}: {ex}")
            except ValueError as ex:
                parser.error(f"invalid --data JSON in {raw_data!r}: {ex}")
        else:
            try:
                flag_data = loads_json(raw_data)
            except ValueError as ex:
                parser.error(f"invalid --data JSON: {ex}")
    try:
        validate_spec(config)
    except ValueError as ex:
        parser.error(str(ex))
    args.config = config
    args.config_explicit = tuple(sorted(explicit))
    has_data = bool((data.get("regs") or data.get("mem")) or flag_data)
    try:
        args.data = _merge_data(flag_data, data) if has_data else None
    except ValueError as ex:
        parser.error(str(ex))
    return args


def main(args):
    args = _fix_output_code_ambiguity(args)
    _resolve_targets(args)
    if getattr(args, "list_targets", False):
        _list_targets(args)
        return
    if not getattr(args, "file", None):
        if not str(getattr(args, "asm", None) or "").strip():
            raise SystemExit(_USAGE)
    elif not target_text(getattr(args, "target", None)).strip():
        raise SystemExit(
            "a symbol or region is required, e.g. `perf benchmark a.out:func` or "
            "`perf benchmark a.out:hot_begin..hot_end`"
        )
    if not getattr(args, "file", None):
        _bench_asm(args)
    else:
        _bench_file(args)


def _ensure_perop(df):
    try:
        cols = list(df.columns)
    except Exception:
        return df
    duration = next(
        (
            column
            for column in cols
            if is_duration_col(column) and not str(column).endswith("/operations")
        ),
        None,
    )
    if duration is None or "operations" not in cols:
        return df
    perop = f"{duration}/operations"
    if perop in cols:
        return df
    try:
        ops = pd.to_numeric(df["operations"], errors="coerce")
    except Exception:
        return df
    try:
        vals = pd.to_numeric(df[duration], errors="coerce") / ops.where(ops != 0)
    except Exception:
        return df
    try:
        out = df.copy()
    except Exception:
        return df
    try:
        out[perop] = vals
    except Exception:
        return df
    return out


def _list_targets(args):
    code = getattr(args, "code", None)
    file = getattr(args, "file", None)
    target = getattr(args, "target", None)
    asm = getattr(args, "asm", None)
    if not file:
        raw = "" if code is None else str(code).strip()
        if raw and not asm:
            file = raw.partition(":")[0].strip() or None
            rest = raw.partition(":")[2] if ":" in raw else ""
            if file and not rest:
                target = None
        if not file:
            if asm and str(asm).strip():
                raise SystemExit(
                    "--list needs a file, e.g. `perf benchmark a.out --list`; "
                    "snippets have no symbols to list"
                )
            raise SystemExit(
                "a file is required, e.g. `perf benchmark a.out --list` or "
                "`perf benchmark a.out:func --list`"
            )
    if _is_asm_source_file(file):
        if not Path(file).exists():
            raise SystemExit(f"file {file!r} does not exist")
        try:
            labels = perf.info.asm_labels(file)
        except FileNotFoundError:
            raise SystemExit(f"file {file!r} does not exist")
        except Exception as ex:
            raise SystemExit(str(ex).splitlines()[0] or f"cannot inspect {file!r}")
        pats = _list_patterns(target)
        df = pd.DataFrame(
            [{"name": n, "position": p, "size": s} for n, p, s in labels],
            columns=["name", "position", "size"],
        )
        df = _filter_list_df(df, pats)
        df = _resolve_list_columns(df, getattr(args, "event", None), strict=False)
        if has_output(getattr(args, "output", None)):
            rows = df.to_dict(orient="records")
            emit_output(
                args.output,
                rows,
                values=metadata_from_frame(df, command="benchmark"),
                template=getattr(args, "_output_template", None),
            )
        if show_table(
            getattr(args, "output", None),
            bool(getattr(args, "_output_from_config", False)),
        ):
            print(_format_list_table(df))
    else:
        if not Path(file).exists():
            raise SystemExit(f"file {file!r} does not exist")
        try:
            df = perf.info.metadata(file)
        except FileNotFoundError:
            raise SystemExit(f"file {file!r} does not exist")
        except SystemExit:
            raise
        except Exception as ex:
            raise SystemExit(str(ex).splitlines()[0] or f"cannot inspect {file!r}")
        df = _filter_list_df(df, _list_patterns(target))
        df = _resolve_list_columns(df, getattr(args, "event", None), strict=False)
        if has_output(getattr(args, "output", None)):
            rows = df.to_dict(orient="records")
            emit_output(
                args.output,
                rows,
                values=metadata_from_frame(df, command="benchmark"),
                template=getattr(args, "_output_template", None),
            )
        if show_table(
            getattr(args, "output", None),
            bool(getattr(args, "_output_from_config", False)),
        ):
            print(_format_list_table(perf.info.hex_addresses(df)))
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


class _ModeAction(argparse.Action):
    def __call__(self, _parser, namespace, values, _option_string=None):
        modes = getattr(namespace, self.dest, None)
        if modes is self.default:
            modes = []
        setattr(namespace, self.dest, list(modes or []) + [values])


def _require_mode_arg(args):
    if args.mode is None:
        raise SystemExit(f"--mode {'|'.join(_MODES)} is required for measurement")
    raw = args.mode if isinstance(args.mode, (list, tuple)) else [args.mode]
    modes = []
    for value in raw:
        for m in (part.strip() for part in str(value).split(",")):
            if not m:
                continue
            if m not in _MODES:
                raise SystemExit(
                    f"unknown mode {m!r}; expected "
                    f"{' or '.join(repr(x) for x in _MODES)}"
                )
            if m not in modes:
                modes.append(m)
    if not modes:
        raise SystemExit(f"--mode {'|'.join(_MODES)} is required for measurement")
    args.mode = modes
    return args.mode


def _asm_explicit_backend(args):
    if getattr(args, "backend", None):
        return True
    config = getattr(args, "config", None)
    if isinstance(config, dict):
        configured = config.get("backend")
        if isinstance(configured, (str, list, tuple)):
            return True
        if isinstance(configured, dict) and any(
            key in ("latency", "throughput") for key in configured
        ):
            return True
    return False


def _asm_auto_backend_keys(args):
    explicit = getattr(args, "config_explicit", None)
    if explicit is None:
        return tuple(_CACHE_KEYS)
    keys = ["dcache", "dtlb"]
    keys.extend(key for key in ("icache", "itlb") if key in explicit)
    return tuple(keys)


def _asm_default_backend(args):
    if getattr(args, "backend", None):
        return None
    config = getattr(args, "config", None)
    if isinstance(config, dict):
        configured = config.get("backend")
        if isinstance(configured, (str, list, tuple)):
            return None
        if isinstance(configured, dict) and any(
            key in ("latency", "throughput") for key in configured
        ):
            return configured
    modes = [m for m in (getattr(args, "mode", None) or []) if m]
    if not modes:
        return None
    return {m: _ASM_MODE_BACKENDS[m] for m in modes if m in _ASM_MODE_BACKENDS}


def _event_groups(args):
    return groups(args.event)


def _output_or_default(args, df, event_groups):
    outputs = getattr(args, "output", None)
    if has_output(outputs):
        payload = _record_envelope(df)
        emit_output(
            args.output,
            payload,
            values=metadata(payload, command="benchmark"),
            template=getattr(args, "_output_template", None),
        )
    if not show_table(outputs, bool(getattr(args, "_output_from_config", False))):
        return
    try:
        rec = _as_records(df)
    except Exception:
        rec = df
    try:
        flat = [e for g in (event_groups or []) for e in (g or [])]
        rec = _order_bench_columns(rec, flat or None)
    except Exception:
        pass
    rec = _ensure_perop(rec)
    print_table(rec)


def _interactive_df(df, event_groups=None):
    try:
        rec = _as_records(df)
    except Exception:
        return df
    try:
        flat = [e for g in (event_groups or []) for e in (g or [])] or None
    except Exception:
        flat = None
    try:
        rec = _order_bench_columns(rec, flat)
    except Exception:
        pass
    rec = _ensure_perop(rec)
    for key, value in (getattr(df, "attrs", {}) or {}).items():
        try:
            rec.attrs[key] = value
        except Exception:
            pass
    return rec


def _measure(args, run, event_groups):
    try:
        df = run()
    except MemoryError as ex:
        raise SystemExit(str(ex).splitlines()[0] if str(ex) else "out of memory")
    except ValueError as ex:
        short = str(ex).splitlines()[0] if str(ex) else f"no symbol for {args.file!r}"
        raise SystemExit(short)
    except SystemExit:
        raise
    _output_or_default(args, df, event_groups)
    if args.interactive:
        embed({"perf": perf, "df": _interactive_df(df, event_groups)})
    return df


def _resolve_targets(args):
    file, target, asm = bench_code(getattr(args, "code", None))
    args.file, args.target, args.asm = file, target, asm
    args.setup = bench_snippet(getattr(args, "setup", None), file, "--setup")
    args.teardown = bench_snippet(getattr(args, "teardown", None), file, "--teardown")
    return args


def _bench_asm(args):
    _require_mode_arg(args)
    event_groups = _event_groups(args)
    snippet = getattr(args, "asm", "") or ""
    if not str(snippet).strip():
        raise SystemExit("asm code is required, e.g. `perf benchmark 'mov eax, 42'`")
    backend = getattr(args, "backend", None) or _asm_default_backend(args)
    auto_backend = (
        False if _asm_explicit_backend(args) else _asm_auto_backend_keys(args)
    )
    return _measure(
        args,
        lambda: perf.benchmark(
            target={"asm": snippet},
            name=getattr(args, "bench_name", None) or snippet,
            mode=args.mode,
            config=args.config,
            data=getattr(args, "data", None),
            event=event_groups,
            setup=getattr(args, "setup", None),
            teardown=getattr(args, "teardown", None),
            argv=list(args.argv) if getattr(args, "argv", None) else None,
            env=list(args.env) if getattr(args, "env", None) else None,
            backend=backend,
            auto_backend=auto_backend,
            debug=bool(getattr(args, "debug", False)),
        ),
        event_groups,
    )


def _bench_file(args):
    _require_mode_arg(args)
    event_groups = _event_groups(args)
    raw_argv = getattr(args, "argv", None)
    if raw_argv:
        argv = list(raw_argv)
    elif getattr(args, "dashes", False):
        argv = []
    else:
        argv = None
    if argv:
        prog = str(getattr(args, "file", None) or "")
        if prog and argv[0] != prog:
            argv = [prog, *argv]
    return _measure(
        args,
        lambda: perf.benchmark(
            target=getattr(args, "code", None),
            name=getattr(args, "bench_name", None),
            config=args.config,
            data=getattr(args, "data", None),
            event=event_groups,
            setup=getattr(args, "setup", None),
            teardown=getattr(args, "teardown", None),
            argv=argv,
            env=list(args.env) if getattr(args, "env", None) else None,
            backend=getattr(args, "backend", None),
            mode=args.mode,
            debug=bool(getattr(args, "debug", False)),
        ),
        event_groups,
    )


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf benchmark",
        description=(
            "benchmark an asm snippet, a symbol, or a region of a binary; "
            "everything after -- is the benchmarked program's own arguments"
        ),
        epilog=_ARGV_HELP,
    )
    _event_help = (
        "events to count; comma-separated events are read together in one "
        "measurement (multiple rdpmc), a repeated -e is a separate measurement "
        "combined with the others (default: duration_time via rdtsc; other events via "
        "rdpmc; a wildcard/regex expands to every matching event, e.g. 'topdown-*' "
        "expands to topdown-retiring,topdown-bad-spec,topdown-fe-bound,"
        "topdown-be-bound with the slots leader added automatically; quote it so the "
        "shell does not expand it)"
    )
    _mode_help = (
        f"measurement mode(s): {', '.join(_MODES)}, or both (comma-separated or a "
        f"repeated -m; default: {','.join(_DEFAULT_MODES)}); like config "
        "alternatives, each mode is combined with every config combination and run "
        "separately"
    )
    _output_help = (
        "write the JSON envelope to FILE, or to stdout when no FILE is given; "
        "repeat --output to write every destination (e.g. --output a.json "
        "--output b.json); a directory (or a path ending in /) uses the output "
        "template (default {time}-{command}-{target}-{id}.json, override in "
        ".perfconfig)"
    )
    parser.add_argument(
        "code",
        nargs="?",
        default=None,
        help="what to benchmark: `FILE:SYMBOL` for a symbol or a `begin..end` region "
        "of a binary (e.g. `a.out:func`, `a.out:hot_begin..hot_end`, "
        "`a.out:0x401000..0x401020`), `FILE:LABEL` for an assembly source (e.g. "
        "`a.s:label`, `a.s:foo..bar`), or a raw snippet with no file (e.g. "
        "`perf benchmark 'mov eax, 42'`); for idiv/div use "
        "the single-operand form, e.g. `perf benchmark 'idiv ecx'` with --backend loop "
        "--data.eax=100 --data.edx=0 --data.ecx=42; `--list` lists its symbols",
    )
    parser.add_argument(
        "--list",
        dest="list_targets",
        action="store_true",
        help="list available symbols instead of measuring: `perf benchmark a.out "
        "--list` lists all, `perf benchmark a.out:foo --list` filters by regex `foo`",
    )
    parser.add_argument(
        "-n",
        "--name",
        dest="bench_name",
        default=None,
        help="benchmark name; labels the result 'name' column and supplies "
        "{name} in the output template",
    )
    parser.add_argument(
        "-m",
        "--mode",
        action=_ModeAction,
        default=list(_DEFAULT_MODES),
        help=_mode_help,
    )
    parser.add_argument(
        "--backend",
        dest="backend",
        default=None,
        choices=["loop", "unroll"],
        help="measurement backend: loop (latency: one snippet/call per loop "
        "iteration; throughput: --config.backend.loop.count copies per trip; "
        "required for stateful idiv/div) or unroll (latency differential: "
        "snippets measure N vs 2N copies, binary targets N calls against N "
        "zero-cost calls; factor via --config.backend.unroll.count=N)",
    )
    parser.add_argument(
        "--config",
        dest="config",
        default=None,
        help="config JSON file (merged over defaults; list leaves sweep every "
        "combination via cartesian product, e.g. "
        "--config.dcache.L1=[{hit_rate:100},{hit_rate:50}] runs both hit rates; "
        "single values run once (--config.dcache.L1=hit_rate:100, "
        "--config.samples=100, "
        "--config.branch=predictable|unpredictable, "
        "--config.func.align=32, "
        "--config.stack.size=auto|<size-in-bytes>, "
        "--config.stack.align=auto|<power-of-two>, "
        "--config.stack.mode=random|zero|fixed, "
        "--config.iterations=100, "
        "--config.iterations.max=10000, "
        "--config.backend=loop|unroll, --config.backend.unroll.count=4, "
        "--config.backend.loop.count=16, --config.backend.loop.runs=20, "
        "--config.external.lib=true, "
        "--config.external.stdout=true, --config.external.stderr=true, "
        "--config.seed=123 (or random), "
        "--config.heap.size=auto|<size-in-bytes>, "
        "--config.heap.mode=random|zero|fixed); "
        "per-address overrides --config.branch[0x401234]=predictable, "
        "--config.dcache.L1[0x1000]=hot apply inside every alternative; "
        "--config.dcache|icache|dtlb|itlb=hot|warm|cool|cold, "
        "--config.dcache.L1=hit_rate:100 for a level, "
        "--config.icache|dtlb|itlb.hit_rate=100 for a single-tier key)",
    )
    parser.add_argument(
        "--data",
        dest="data",
        default=None,
        help="input data as a JSON string or path to a JSON file, kept "
        "separate from config (data gets its own hash); --data.* overrides "
        "win (e.g. --data.rdi=15, --data.arg0=15, --data[0x1000]=1, "
        "--data[0x1000]=[1,2,3] for values, --data[0x1000:]=[1,2,3] for a "
        "byte range)",
    )
    parser.add_argument(
        "-e", "--event", action="append", default=None, help=_event_help
    )
    parser.add_argument(
        "-o",
        "--output",
        dest="output",
        action="append",
        nargs="?",
        const=True,
        default=None,
        metavar="FILE",
        help=_output_help,
    )
    parser.add_argument(
        "--env",
        dest="env",
        action="append",
        default=None,
        metavar="KEY=VALUE",
        help="environment variable for the benchmarked program, repeated per "
        "variable; goes into envp next to argv (default: an empty "
        "environment)",
    )
    parser.add_argument("-i", "--interactive", action="store_true")
    parser.add_argument(
        "--debug",
        dest="debug",
        action="store_true",
        help="print config, found solutions, synthesised data, full assembly "
        "and per-run results to stderr",
    )
    parser.add_argument(
        "--setup",
        dest="setup",
        default=None,
        help="run once before the measurement loop: `FILE:SYMBOL` of the "
        "benchmarked file (e.g. `a.out:init`), or an asm snippet for a snippet "
        "benchmark",
    )
    parser.add_argument(
        "--teardown",
        dest="teardown",
        default=None,
        help="run once after the measurement loop, same forms as `--setup`",
    )
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args = parse_target_args(_parser, apply_perfconfig(_parser, _options))
    _args = _fix_output_code_ambiguity(_args)
    _args.argv = _paths
    _args.dashes = "--" in sys.argv[1:]
    main(_args)
