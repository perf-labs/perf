import argparse
import re
import sys

import pandas as pd

import perf
from perf.core import _split_list
from perf.data import _BASELINE_RE as _BASELINE_RE
from perf.data import (
    _DEFAULT_GROUPBY,
    apply_filter,
    derived_metrics,
    emit_output,
    eval_events,
    expand_names,
    format_table,
    has_output,
    load,
    metadata_from_frame,
    metric_columns,
    perfconfig_entries,
    resolve_groupby,
    show_table,
    split_after_dashes,
    split_spec,
    stdin_is_pipe,
)
from perf.data import _SOURCE_COL as _SOURCE_COL
from perf.data import (
    _aliases as _data_aliases,
)
from perf.data import _baseline_values as _baseline_values
from perf.data import _find_baseline_rows as _find_baseline_rows
from perf.data import _given as _given
from perf.data import _inject_baselines as _inject_baselines
from perf.data import (
    _known as _data_known,
)
from perf.data import (
    apply_perfconfig as _data_apply,
)
from perf.data import format_duration as format_duration
from perf.data import format_number as format_number
from perf.data import table_to_df as table_to_df
from perf.plot import _group_series

_COMMAND = "view"
_DOTTED_KEYS = ()


def apply_perfconfig(parser, argv, config_path=None):
    return _data_apply(
        parser,
        argv,
        _COMMAND,
        config_path,
        dotted_keys=_DOTTED_KEYS,
    )


def _config_entries(path=None):
    return perfconfig_entries(_COMMAND, path)


def _known(parser, key):
    return _data_known(parser, key, _DOTTED_KEYS)


def _aliases(parser, key):
    return _data_aliases(parser, key, _DOTTED_KEYS)


_DEFAULT_EVENTS = [
    "time",
    "file",
    "name",
    "mode",
    "operations",
    "duration_time/operations",
]
_DEFAULT_STATS = ["min", "median", "p10", "p50", "p90", "p99", "max"]


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.cycles
    df.groupby(["name", "mode"]).cycles.describe()
    df.ecdf()
    %notebook session.ipynb""")

    import sys

    if not getattr(sys.stdin, "isatty", lambda: False)():
        try:
            sys.stdin = open("/dev/tty")
        except Exception:
            pass

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def split_list(value):
    return _split_list(value)


def main(args):
    args.data = getattr(args, "paths", None) or getattr(args, "data", None) or []
    if not args.data and not stdin_is_pipe():
        args.data = ["."]
    df = perf.bench._as_records(load(args))
    df = apply_filter(df, getattr(args, "filter", None))
    spec = split_spec(getattr(args, "event", None))
    given = bool(spec)
    if given:
        spec = expand_names(df, spec)
    else:
        spec = _present(df, expand_names(df, list(_DEFAULT_EVENTS)))
    columns, events = _select(df, spec)
    default_groupby = ",".join(_DEFAULT_GROUPBY)
    explicit_groupby = args.groupby is not None and args.groupby != default_groupby
    groupby = resolve_groupby(df, args.groupby)
    shown_groupby = (
        groupby
        if explicit_groupby
        else [c for c in groupby if str(c).startswith("data.")]
    )
    if given and not events:
        frame = df[[c for c in spec if c in df.columns]]
        if has_output(getattr(args, "output", None)):
            emit_output(
                args.output,
                frame.to_dict(orient="records"),
                values=metadata_from_frame(frame, command="view"),
                template=getattr(args, "_output_template", None),
            )
        if show_table(
            getattr(args, "output", None),
            bool(getattr(args, "_output_from_config", False)),
        ):
            print_table(frame)
        if args.interactive:
            embed({"perf": perf, "df": df})
        return
    df, evaluated = eval_events(df, events)
    if given:
        missing = [n for n in events if n not in evaluated]
        if missing:
            raise SystemExit(
                f"events not found in data: {', '.join(missing)}; available: "
                f"{', '.join(str(c) for c in df.columns)}"
            )
    events = evaluated
    stats = split_list(args.stat) if args.stat is not None else list(_DEFAULT_STATS)
    raw = [c for c in spec if c in df.columns]
    if has_output(getattr(args, "output", None)):
        if args.groupby is not None and not split_list(args.groupby):
            _frame = df[raw]
        elif not stats:
            _frame = df[raw]
        else:
            out = _aggregate(df, groupby, events, stats, auto_mode=False)
            _frame = out[_show_columns(columns, shown_groupby, out, events)]
        emit_output(
            args.output,
            _frame.to_dict(orient="records"),
            values=metadata_from_frame(_frame, command="view"),
            template=getattr(args, "_output_template", None),
        )
        if not show_table(
            getattr(args, "output", None),
            bool(getattr(args, "_output_from_config", False)),
        ):
            if args.interactive:
                embed({"perf": perf, "df": df})
            return
    if args.groupby is not None and not split_list(args.groupby):
        print_table(df[raw])
    elif not stats:
        print_table(df[raw])
    else:
        out = _aggregate(df, groupby, events, stats, auto_mode=False)
        print_table(out[_show_columns(columns, shown_groupby, out, events)])
    if args.interactive:
        embed({"perf": perf, "df": df})


def print_table(df, chunk_rows=5000):
    try:
        ctx = pd.option_context(
            "display.max_rows",
            None,
            "display.max_columns",
            None,
            "display.max_colwidth",
            None,
            "display.width",
            None,
            "display.expand_frame_repr",
            False,
        )
        ctx.__enter__()
    except Exception:
        ctx = None
    try:
        try:
            formatted = format_table(df)
        except Exception:
            try:
                formatted = df
            except Exception:
                try:
                    print(str(df), flush=True)
                except Exception:
                    pass
                return
        try:
            total = len(formatted)
            ncols = len(formatted.columns)
        except Exception:
            try:
                print(formatted.to_string(index=False), flush=True)
            except Exception:
                try:
                    print(str(formatted), flush=True)
                except Exception:
                    pass
            return
        if not total or not ncols:
            try:
                print(
                    formatted.to_string(
                        index=False,
                        max_rows=max(1, total or 0),
                        max_cols=max(1, ncols or 0),
                        max_colwidth=None,
                        line_width=None,
                    ),
                    flush=True,
                )
            except Exception:
                try:
                    print(str(formatted), flush=True)
                except Exception:
                    pass
            return
        try:
            widths = []
            for col in formatted.columns:
                hlen = len(str(col))
                try:
                    m = formatted[col].astype(str).str.len().max()
                    try:
                        if pd.isna(m):
                            m = 0
                        else:
                            m = int(m)
                    except Exception:
                        m = 0
                except Exception:
                    m = hlen
                    try:
                        for v in formatted[col].tolist():
                            try:
                                m = max(m, len(str(v)))
                            except Exception:
                                continue
                    except Exception:
                        pass
                try:
                    widths.append(max(hlen, int(m)))
                except Exception:
                    widths.append(hlen)
        except Exception:
            widths = None
        try:
            chunk = int(chunk_rows) if chunk_rows else 5000
        except Exception:
            chunk = 5000
        if chunk <= 0:
            chunk = 5000
        try:
            first = True
            out = sys.stdout
            for start in range(0, total, chunk):
                try:
                    part = formatted.iloc[start : start + chunk]
                except Exception:
                    part = formatted
                    first = True
                try:
                    if widths is not None:
                        text = part.to_string(
                            index=False,
                            header=first,
                            col_space=widths,
                            max_rows=max(1, len(part)),
                            max_cols=ncols,
                            max_colwidth=None,
                            line_width=None,
                        )
                    else:
                        text = part.to_string(
                            index=False,
                            header=first,
                            max_rows=max(1, len(part)),
                            max_cols=ncols,
                            max_colwidth=None,
                            line_width=None,
                        )
                except Exception:
                    try:
                        text = part.to_string(index=False, header=first)
                    except Exception:
                        text = str(part)
                try:
                    out.write(text + "\n")
                    out.flush()
                except Exception:
                    print(text, flush=True)
                first = False
                if start + chunk >= total:
                    break
        except Exception:
            try:
                print(formatted.to_string(index=False), flush=True)
            except Exception:
                try:
                    print(str(formatted), flush=True)
                except Exception:
                    pass
    finally:
        try:
            if ctx is not None:
                ctx.__exit__(None, None, None)
        except Exception:
            pass


def _hashable_groups(rec, keys):
    for key in keys:
        try:
            if rec[key].dtype != object:
                continue
        except Exception:
            pass
        try:
            values = pd.unique(rec[key])
        except (TypeError, ValueError):
            return False
        except Exception:
            continue
        try:
            for value in values:
                hash(value)
        except (TypeError, ValueError):
            return False
        except Exception:
            continue
    return True


def _stat_func(stat):
    s = stat.strip()
    m = re.fullmatch(r"[pP](\d+(?:\.\d+)?)", s)
    if m:
        q = float(m.group(1)) / 100.0
        if not 0 <= q <= 1:
            raise SystemExit(f"invalid percentile {stat!r}; expected p0..p100")

        def _q(x, q=q):
            return float(x.quantile(q))

        _q.__name__ = s.lower()
        return s.lower(), _q
    return s, s


def _aggregate(df, groupby, events, stats, auto_mode=True):
    rec = df if isinstance(df, pd.DataFrame) else pd.DataFrame(df)
    try:
        if len(rec) > 20000:
            try:
                ng = 1
                _keys_probe = [c for c in groupby if c in rec.columns]
                if _keys_probe:
                    ng = max(1, int(rec.groupby(_keys_probe, dropna=False).ngroups))
                else:
                    ng = 1
            except Exception:
                ng = 1
            quota = max(1, 20000 // max(1, ng))
            try:
                if _keys_probe and ng > 20000:
                    rec = rec.sample(n=20000, random_state=0).reset_index(drop=True)
                elif _keys_probe and ng > 1:
                    parts = []
                    for _, part in rec.groupby(_keys_probe, dropna=False):
                        if len(part) > quota:
                            part = part.sample(n=quota, random_state=0)
                        parts.append(part)
                    rec = pd.concat(parts, ignore_index=True)
                else:
                    rec = rec.sample(n=20000, random_state=0)
            except Exception:
                try:
                    rec = rec.sample(n=min(20000, len(rec)), random_state=0)
                except Exception:
                    pass
    except Exception:
        pass
    keys = [c for c in groupby if c in rec.columns]
    if auto_mode and "mode" in rec.columns and "mode" not in keys:
        keys = keys + ["mode"]
    missing = [e for e in events if e not in rec.columns]
    if missing:
        raise SystemExit(f"events not found in data: {', '.join(missing)}")
    if not keys:
        raise SystemExit("no groupby columns found in data")
    if not _hashable_groups(rec, keys):
        rec = rec.copy(deep=False)
        for key in keys:
            try:
                rec[key] = _group_series(rec[key])
            except Exception:
                pass
    grouped = rec.groupby(keys, dropna=False)
    pairs = []
    for stat in stats:
        try:
            pairs.append(_stat_func(stat))
        except SystemExit:
            raise
        except Exception as ex:
            raise SystemExit(f"invalid --stat {stat!r}: {ex}")
    try:
        agg = grouped[events].agg([func for _, func in pairs])
    except Exception:
        rows = []
        for name, func in pairs:
            try:
                part = grouped[events].agg(func)
            except Exception as ex:
                raise SystemExit(f"invalid --stat {name!r}: {ex}")
            part = part.reset_index()
            part.insert(len(keys), "stat", name)
            rows.append(part)
        return pd.concat(rows, ignore_index=True)[keys + ["stat"] + list(events)]
    names = [name for name, _ in pairs]
    if isinstance(agg.columns, pd.MultiIndex):
        rows = []
        for i, name in enumerate(names):
            try:
                part = agg.xs(name, axis=1, level=-1)
            except Exception:
                part = agg.iloc[:, i :: len(names)]
                try:
                    part.columns = events
                except Exception:
                    pass
            part = part.reset_index()
            part.insert(len(keys), "stat", name)
            rows.append(part)
        return pd.concat(rows, ignore_index=True)[keys + ["stat"] + list(events)]
    agg = agg.reset_index()
    agg.insert(len(keys), "stat", names[0] if names else "")
    return agg[keys + ["stat"] + list(events)]


def _present(df, names):
    available = set(df.columns) | set(derived_metrics(df))
    return [n for n in names if n in available]


def _select(df, spec):
    metrics = set(metric_columns(df))
    events = [n for n in spec if n in metrics or n not in df.columns]
    return [n for n in spec if n not in events], events


def _show_columns(columns, groupby, out, events):
    show = [c for c in columns if c in out.columns]
    show += [c for c in groupby if c in out.columns and c not in show]
    show += [c for c in ["stat"] + events if c in out.columns and c not in show]
    return show


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf view", description="view benchmark data (stdin or -- data paths)"
    )
    parser.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="columns/expressions to show, comma-separated or repeated, with `*` "
        f"expanding a pattern (e.g. -e 'data*') "
        f"(default: {','.join(_DEFAULT_EVENTS)}); "
        "every name given must exist in the data, e.g. cycles,cycles/instructions; "
        "'<group>'.<metric> uses another group's mean (speedup vs "
        "baseline), e.g. -e instructions/'memory@dcfd9f77'.cycles",
    )
    parser.add_argument(
        "-g",
        "--group-by",
        dest="groupby",
        default=",".join(_DEFAULT_GROUPBY),
        help="pandas groupby keys (default: file,name,mode,data.*; `data.*` expands "
        "to every data column; pass '' for raw rows)",
    )
    parser.add_argument(
        "-f",
        "--filter",
        dest="filter",
        default=None,
        help="pandas query filter for rows, e.g. --filter 'name == \"fizz_buzz\"'",
    )
    parser.add_argument(
        "-s",
        "--stat",
        dest="stat",
        default=",".join(_DEFAULT_STATS),
        help="how to aggregate (default: min,median,p10,p50,p90,p99,max; pass '' for "
        "raw rows)",
    )
    parser.add_argument(
        "-o",
        "--output",
        dest="output",
        action="append",
        nargs="?",
        const=True,
        default=None,
        metavar="FILE",
        help="write JSON records to FILE, or to stdout when no FILE is given; "
        "repeat --output to write several destinations; a directory (or a path "
        "ending in /) uses the output template (default "
        "{time}-{command}-{target}-{id}.json, override in .perfconfig)",
    )
    parser.add_argument("-i", "--interactive", action="store_true")
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args, _unknown = _parser.parse_known_args(apply_perfconfig(_parser, _options))
    if _unknown:
        _parser.error(f"unknown argument: {_unknown[0]}")
    _args.paths = _paths
    main(_args)
