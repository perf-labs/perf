import argparse
import math
import os
import shutil
import sys
from pathlib import Path

import perf
from perf.data import (
    _aliases as _data_aliases,
)
from perf.data import (
    _known as _data_known,
)
from perf.data import (
    apply_perfconfig as _data_apply,
)
from perf.data import (
    emit_output,
    has_output,
    loads_json,
    metadata,
    output_targets,
    perfconfig_entries,
    split_after_dashes,
)
from perf.opt import _PASSES, default_output, describe, merge_config, report_json

_COMMAND = "optimize"
_DOTTED_KEYS = ("config.",)


def apply_perfconfig(parser, argv, config_path=None):
    return _data_apply(
        parser,
        argv,
        _COMMAND,
        config_path,
        dotted_keys=_DOTTED_KEYS,
    )


def _config_entries(path=None):
    return perfconfig_entries(_COMMAND, path)


def _known(parser, key):
    return _data_known(parser, key, _DOTTED_KEYS)


def _aliases(parser, key):
    return _data_aliases(parser, key, _DOTTED_KEYS)


def _is_json_target(target):
    if target is True:
        return True
    text = str(target)
    if text.lower().endswith(".json"):
        return True
    if text.endswith(("/", os.sep)) or text in (".", ".."):
        return True
    try:
        return Path(text).is_dir()
    except OSError:
        return False


def _split_outputs(values):
    json_targets = []
    binary_targets = []
    for target in output_targets(values):
        if _is_json_target(target):
            json_targets.append(target)
        else:
            binary_targets.append(target)
    return json_targets, binary_targets


def _profiling_data(paths):
    sources = []
    for item in paths or []:
        try:
            text = str(item).strip()
        except Exception:
            text = ""
        if text:
            sources.append(item)
    if not sources:
        raise SystemExit(
            "profiling data is required (non-empty); pass DATA after '--', "
            "e.g. `perf optimize a.out -- data/`"
        )
    return sources


def parse_exec_args(parser, argv):
    args, unknown = parser.parse_known_args(argv)
    config = {}
    if getattr(args, "config", None):
        try:
            with open(args.config) as fh:
                loaded = loads_json(fh.read())
        except OSError as ex:
            parser.error(f"cannot read --config {args.config!r}: {ex}")
        except ValueError as ex:
            parser.error(f"invalid JSON in --config {args.config!r}: {ex}")
        if not isinstance(loaded, dict):
            parser.error("config file must contain a JSON object")
        config = loaded
    for arg in unknown:
        if not arg.startswith("--config.") or "=" not in arg:
            parser.error(f"unknown argument: {arg}")
        key, value = arg[len("--config.") :].split("=", 1)
        if not key:
            parser.error(f"unknown argument: {arg}")
        try:
            _set_config(config, key, _config_value(value))
        except ValueError as ex:
            parser.error(str(ex))
    try:
        args.config = merge_config(config)
    except ValueError as ex:
        parser.error(str(ex))
    return args


def format_report(df):
    if df is None or getattr(df, "empty", False):
        return "no functions optimized"
    cols = ["name", "address", "new_address", "size", "hotness", "moved"]
    have = [c for c in cols if c in df.columns]
    out = df[have].copy() if have else df.copy()
    try:
        import pandas as pd

        for col in ("address", "new_address"):
            if col in out.columns:
                vals = pd.to_numeric(out[col], errors="coerce")
                formatted = []
                for v in vals.tolist():
                    try:
                        if v != v or pd.isna(v):
                            formatted.append("")
                            continue
                        iv = int(v)
                        if iv < 0:
                            formatted.append("")
                        else:
                            formatted.append(f"0x{iv:x}")
                    except (TypeError, ValueError, OverflowError):
                        formatted.append("")
                out[col] = formatted
        if "hotness" in out.columns:
            vals = pd.to_numeric(out["hotness"], errors="coerce").tolist()
            formatted = []
            for v in vals:
                try:
                    if v != v or pd.isna(v):
                        formatted.append("")
                        continue
                    value = float(v)
                    formatted.append(f"{value:.3f}" if math.isfinite(value) else "")
                except (TypeError, ValueError, OverflowError):
                    formatted.append("")
            out["hotness"] = formatted
        if "moved" in out.columns:
            formatted = []
            for v in out["moved"].tolist():
                try:
                    if pd.isna(v):
                        formatted.append("")
                        continue
                except Exception:
                    pass
                formatted.append("moved" if v is True or v == 1 else "")
            out["moved"] = formatted
    except Exception:
        pass
    try:
        return out.to_string(index=False)
    except Exception:
        return str(out)


def main(args, data_paths):
    if getattr(args, "list_targets", False):
        from perf.opt import _match_hotness, collect_hotness, discover_functions

        target = getattr(args, "exec", None)
        if not target or not str(target).strip():
            raise SystemExit("a file is required, e.g. `perf optimize a.out --list`")
        file = str(target).strip()
        if not Path(file).is_file():
            raise SystemExit(f"file {file!r} does not exist")
        data_paths = _profiling_data(data_paths)
        try:
            funcs = discover_functions(file)
        except Exception as ex:
            raise SystemExit(str(ex))
        scores, _ = collect_hotness(data_paths)
        if not scores:
            raise SystemExit(
                "no usable profiling data found; pass benchmark/profile/analyze "
                "JSON, a pandas DataFrame, or perf.data after '--'"
            )
        rows = []
        for name, (start, end) in sorted(funcs.items(), key=lambda kv: kv[1]):
            try:
                hot = float(_match_hotness(name, scores))
            except Exception:
                hot = 0.0
            rows.append(
                {
                    "name": name,
                    "address": int(start),
                    "size": int(end - start),
                    "hotness": hot,
                }
            )
        if has_output(getattr(args, "output", None)):
            emit_output(
                args.output,
                rows,
                values=metadata(
                    {"file": file, "name": "list", "command": "optimize"},
                ),
                template=getattr(args, "_output_template", None),
            )
        else:
            print(f"{'name':40} {'address':12} {'size':6} hotness")
            for row in rows:
                print(
                    f"{row['name']:40} 0x{row['address']:x}  "
                    f"{row['size']:6d} {row['hotness']:.3f}"
                )
        return
    target = getattr(args, "exec", None)
    if not target or not str(target).strip():
        raise SystemExit(
            "an input binary is required, e.g. `perf optimize a.out -- data/`"
        )
    data_paths = _profiling_data(data_paths)
    json_targets, binary_targets = _split_outputs(getattr(args, "output", None))
    output = binary_targets[0] if binary_targets else None
    if output is None:
        output = default_output(str(target))
    else:
        output = str(output).strip()
        if not output:
            raise SystemExit("output path must not be empty")
    opts = _parse_opts(getattr(args, "opt", None))
    try:
        df = perf.optimize(
            exec=str(target),
            output=str(output),
            data=data_paths,
            opt=opts,
            config=getattr(args, "config", None),
            dry_run=bool(getattr(args, "dry_run", False)),
        )
    except (ValueError, OSError) as ex:
        raise SystemExit(str(ex))
    if binary_targets and not getattr(args, "dry_run", False):
        for extra in binary_targets[1:]:
            path = Path(str(extra))
            path.parent.mkdir(parents=True, exist_ok=True)
            try:
                shutil.copy2(str(output), str(path))
            except OSError as ex:
                raise SystemExit(f"cannot write --output {str(path)!r}: {ex}") from ex
    if json_targets:
        payload = report_json(df)
        emit_output(
            json_targets,
            payload,
            values=metadata(
                payload,
                name="optimize",
                command="optimize",
            ),
            template=getattr(args, "_output_template", None),
        )
    elif bool(getattr(args, "dry_run", False)):
        print(describe(df))
    else:
        print(format_report(df))
        try:
            layout = bool(df.attrs.get("layout", False))
            skipped = str(df.attrs.get("layout_skipped", "") or "")
            if layout:
                print("layout: applied", flush=True)
            elif skipped:
                print(f"layout: skipped ({skipped})", flush=True)
        except Exception:
            pass
        print(f"wrote {output}", flush=True)


def _config_value(value):
    text = str(value).strip()
    if text.startswith(("[", "{")):
        try:
            return loads_json(text)
        except ValueError:
            pass
    low = text.lower()
    if low in ("true", "false"):
        return low == "true"
    try:
        return int(text, 0)
    except ValueError:
        pass
    try:
        value = float(text)
        if math.isfinite(value):
            return value
    except ValueError:
        pass
    if "," in text:
        return [part.strip() for part in text.split(",") if part.strip()]
    return text


def _set_config(config, key, value):
    parts = [part for part in key.split(".") if part]
    if not parts:
        raise ValueError(f"invalid config key {key!r}")
    node = config
    for part in parts[:-1]:
        child = node.get(part)
        if not isinstance(child, dict):
            child = {}
            node[part] = child
        node = child
    node[parts[-1]] = value


def _parse_opts(value):
    if value is None:
        return None
    if isinstance(value, (list, tuple)):
        out = []
        for item in value:
            out.extend([p.strip() for p in str(item).split(",") if p.strip()])
        return out or None
    return [p.strip() for p in str(value).split(",") if p.strip()] or None


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf optimize",
        description=(
            "optimize a binary with measured-data-guided passes: peephole, "
            "branch folding, function layout; requires non-empty DATA after `--`"
        ),
    )
    parser.add_argument(
        "exec",
        nargs="?",
        default=None,
        help="input binary (e.g. `a.out`)",
    )
    parser.add_argument(
        "-o",
        "--output",
        dest="output",
        action="append",
        nargs="?",
        const=True,
        default=None,
        metavar="PATH",
        help="output binary path (default: EXEC.opt<EXT>, e.g. a.opt.out); a .json "
        "path writes the optimization report (and stdout when no path is given); "
        "repeat --output to write several binaries or reports",
    )
    parser.add_argument(
        "--opt",
        dest="opt",
        action="append",
        default=None,
        help=f"optimization passes, comma-separated or repeated "
        f"(default: {','.join(_PASSES)}); choices: {', '.join(_PASSES)}",
    )
    parser.add_argument(
        "--config",
        dest="config",
        default=None,
        help="config JSON file (merged over defaults) with `opt` and a "
        "`layout` object (`align`, `order`); dotted overrides win, e.g. "
        "--config.layout.align=64, --config.layout.order=as-is, "
        "--config.opt=peephole,branch",
    )
    parser.add_argument(
        "--dry-run",
        dest="dry_run",
        action="store_true",
        help="print the plan without writing the output",
    )
    parser.add_argument(
        "--list",
        dest="list_targets",
        action="store_true",
        help="list functions with hotness instead of optimizing: "
        "`perf optimize a.out --list -- data/` (DATA is required)",
    )
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args = parse_exec_args(_parser, apply_perfconfig(_parser, _options))
    main(_args, _paths)
