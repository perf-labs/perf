import argparse
import configparser
import json
import math
import os
import re
import shutil
import sys
from pathlib import Path

import pandas as pd

try:
    _SRC = Path(__file__).resolve().parent.parent / "src"
    if _SRC.is_dir() and str(_SRC) not in sys.path:
        sys.path.insert(0, str(_SRC))
except OSError:
    pass

import perf
from perf.core import _split_list, one_line

_COMMAND = "system"
_PERFCONFIG = ".perfconfig"
_PERFCONFIG_COMMENTS = ("#", ";")
_DOTTED_KEYS = ("profile.",)
_WILDCARDS = ("*", "?")


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.L1d
    %notebook session.ipynb""")

    import sys

    if not getattr(sys.stdin, "isatty", lambda: False)():
        try:
            sys.stdin = open("/dev/tty")
        except Exception:
            pass

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def split_spec(value):
    return _split_list(value, expand=False)


def expand_names(df, names):
    names = [str(n) for n in names or []]
    if not any(any(w in n for w in _WILDCARDS) for n in names):
        return names
    out = []
    for name in names:
        if any(w in name for w in _WILDCARDS):
            found = [c for c in df.columns if c not in out and _match(name, c)]
            if found:
                out.extend(found)
                continue
        if name not in out:
            out.append(name)
    return out


def is_numeric(df, column):
    try:
        if pd.api.types.is_bool_dtype(df[column]):
            return False
        return bool(pd.api.types.is_numeric_dtype(df[column]))
    except Exception:
        return False


def format_trace_table(df):
    if df is None or not len(df.columns):
        return ""
    columns = list(df.columns)
    cells = {c: [_cell(v) for v in df[c].tolist()] for c in columns}
    numeric = {c: is_numeric(df, c) for c in columns}
    widths = {c: max([len(str(c))] + [len(s) for s in cells[c]]) for c in columns}
    lines = [
        "  ".join(
            str(c).rjust(widths[c]) if numeric[c] else str(c).ljust(widths[c])
            for c in columns
        ).rstrip()
    ]
    for i in range(len(df)):
        lines.append(
            "  ".join(
                cells[c][i].rjust(widths[c])
                if numeric[c]
                else cells[c][i].ljust(widths[c])
                for c in columns
            ).rstrip()
        )
    return "\n".join(lines)


def json_target(args):
    v = getattr(args, "json", False)
    if v is False or v is None:
        return False, None
    if v is True:
        return True, None
    s = str(v).strip()
    if not s:
        return True, None
    low = s.lower()
    if low in ("-", "true", "1", "yes", "on"):
        return True, None
    if low in ("false", "0", "no", "off"):
        return False, None
    return True, s


def want_json(args):
    return bool(json_target(args)[0])


def json_path(args):
    return json_target(args)[1]


def emit_json_text(text, path):
    if path is None:
        print(text, flush=True)
        return
    dest = Path(str(path))
    try:
        parent = dest.parent
        if str(parent) not in ("", "."):
            parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(text + ("" if text.endswith("\n") else "\n"))
    except OSError as ex:
        raise SystemExit(f"cannot write --json file {path!r}: {ex}")


def profile_overrides(parser, argv):
    overrides = {}
    rest = []
    for arg in argv:
        if not arg.startswith("--profile."):
            rest.append(arg)
            continue
        if "=" not in arg:
            parser.error(f"unknown argument: {arg} (expected --profile.KEY=VALUE)")
        key, value = arg[len("--profile.") :].split("=", 1)
        if not key:
            parser.error(f"unknown argument: {arg}")
        overrides[key] = _profile_value(value)
    return overrides, rest


def apply_perfconfig(parser, argv, config_path=None):
    entries = _config_entries(config_path)
    if not entries:
        return list(argv)
    argv = list(argv)
    command = argv[0].strip() if argv and isinstance(argv[0], str) else None
    sub = _subparser(parser, command)
    if sub is None:
        return list(argv)
    given = _given(argv)
    pending = []
    for key, value in entries.items():
        if key.startswith("profile.") and command != "tune":
            continue
        if not _known(sub, key) or _aliases(sub, key) & given:
            continue
        if key == "json":
            on = _truthy(value)
            if on is True:
                pending.append("--json=true")
            elif on is False:
                continue
            else:
                pending.append(f"--json={value}")
            continue
        if _flag_only(sub, key):
            on = _truthy(value)
            if on is None:
                parser.error(
                    f"invalid [{_COMMAND}] {key} = {value!r}; expected a boolean "
                    "(true/false)"
                )
            if on:
                pending.append(f"--{_option_name(sub, key)}")
            continue
        pending.append(f"--{_option_name(sub, key)}={value}")
    if not pending:
        return list(argv)
    return [argv[0]] + pending + argv[1:]


def split_after_dashes(argv):
    if "--" in argv:
        sep = argv.index("--")
        return list(argv[:sep]), list(argv[sep + 1 :])
    return list(argv), []


def _perf_import_base():
    try:
        base = str(Path(perf.__file__).resolve().parent.parent)
    except Exception:
        return None
    if not base or not Path(base, "perf").is_dir():
        return base or None
    return base


def _sudo_pythonpath():
    seen = set()
    parts = []

    def _add(path):
        if not path:
            return
        entry = str(path).strip()
        if not entry or entry in seen:
            return
        if entry in ("", ".", ".."):
            return
        try:
            if not os.path.isdir(entry):
                return
            entry = os.path.normpath(entry)
        except Exception:
            return
        if entry in seen:
            return
        seen.add(entry)
        parts.append(entry)

    _add(_perf_import_base())
    try:
        for entry in list(sys.path):
            _add(entry)
    except Exception:
        pass
    try:
        import site as _site

        candidates = []
        for getter in ("getusersitepackages", "getsitepackages"):
            try:
                value = getattr(_site, getter)()
            except Exception:
                continue
            if isinstance(value, (list, tuple)):
                candidates.extend(value)
            elif value:
                candidates.append(value)
        for entry in candidates:
            _add(entry)
    except Exception:
        pass
    try:
        for entry in str(os.environ.get("PYTHONPATH", "")).split(os.pathsep):
            _add(entry)
    except Exception:
        pass
    return os.pathsep.join(parts)


def sudo_command(argv):
    if os.name != "posix" or not hasattr(os, "geteuid"):
        return None
    if os.geteuid() == 0:
        return None
    sudo = shutil.which("sudo")
    if sudo is None:
        return None
    script = str(Path(__file__).resolve())
    pythonpath = _sudo_pythonpath()
    if pythonpath:
        return [
            sudo,
            "env",
            f"PYTHONPATH={pythonpath}",
            sys.executable,
            script,
            *argv,
        ]
    return [sudo, sys.executable, script, *argv]


def main(args):
    cmd = (getattr(args, "command", None) or "").strip()
    if cmd == "info":
        _info(args)
        return
    if cmd == "tune":
        _tune(args)
        return
    if cmd == "reset":
        _reset(args)
        return
    raise SystemExit(
        "expected `perf system info` (e.g. `perf system info -e arch`), "
        "`perf system tune`, or `perf system reset`"
    )


def _match(pattern, text):
    return (
        re.fullmatch(
            "".join(
                ".*" if c == "*" else "." if c == "?" else re.escape(c)
                for c in str(pattern)
            ),
            str(text),
        )
        is not None
    )


def _cell(value):
    if value is None or (
        not isinstance(value, (list, tuple, dict, set)) and pd.isna(value)
    ):
        return ""
    return one_line(value)


def _perfconfig_path():
    try:
        current = Path.cwd().resolve()
        home = Path.home().resolve()
    except OSError:
        return None
    while True:
        candidate = current / _PERFCONFIG
        try:
            if candidate.is_file():
                return candidate
        except OSError:
            pass
        if current == home or current.parent == current:
            return None
        current = current.parent


def _config_entries(path=None):
    path = Path(path) if path is not None else _perfconfig_path()
    if path is None or not path.is_file():
        return {}
    parser = configparser.ConfigParser(
        interpolation=None,
        strict=False,
        comment_prefixes=_PERFCONFIG_COMMENTS,
        inline_comment_prefixes=_PERFCONFIG_COMMENTS,
    )
    try:
        with open(path, encoding="utf-8") as fh:
            parser.read_file(fh, source=str(path))
    except (configparser.Error, UnicodeDecodeError, OSError):
        return {}
    entries = {}
    for section in (_COMMAND,):
        if not parser.has_section(section):
            continue
        for key, value in parser.items(section):
            if key.strip() and value.strip():
                entries[key] = value.strip()
    return entries


def _subparser(parser, command):
    for action in getattr(parser, "_actions", []):
        if isinstance(action, argparse._SubParsersAction):
            return action.choices.get(command)
    return None


def _known(parser, key):
    if key.startswith(_DOTTED_KEYS):
        return True
    return any(
        action.dest == key or key in {o.lstrip("-") for o in action.option_strings}
        for action in parser._actions
    )


def _aliases(parser, key):
    if key.startswith(_DOTTED_KEYS):
        return {key}
    aliases = {key}
    for action in parser._actions:
        if action.dest == key:
            aliases |= {o.lstrip("-") for o in action.option_strings}
    return aliases


def _option_name(parser, key):
    for action in parser._actions:
        if action.dest == key or key in {o.lstrip("-") for o in action.option_strings}:
            for option in action.option_strings:
                if option.startswith("--"):
                    return option.lstrip("-")
            if action.option_strings:
                return action.option_strings[0].lstrip("-")
    return key


def _flag_only(parser, key):
    return any(
        (
            action.dest == key
            or _option_name(parser, key)
            in {o.lstrip("-") for o in action.option_strings}
        )
        and isinstance(action, (argparse._StoreTrueAction, argparse._StoreFalseAction))
        for action in parser._actions
    )


def _given(argv):
    given = set()
    for arg in argv:
        if arg == "--":
            break
        if arg.startswith("--"):
            given.add(arg[2:].split("=", 1)[0])
        elif arg.startswith("-") and len(arg) > 1:
            given.add(arg[:2].lstrip("-"))
    return given


def _truthy(value):
    text = str(value).strip().lower()
    if text in ("1", "true", "yes", "on"):
        return True
    if text in ("0", "false", "no", "off"):
        return False
    return None


def _profile_value(value):
    text = str(value).strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in ("'", '"'):
        text = text[1:-1]
    low = text.lower()
    if low in ("true", "yes", "on"):
        return True
    if low in ("false", "no", "off"):
        return False
    try:
        return int(text, 0)
    except ValueError:
        pass
    try:
        value = float(text)
        if math.isfinite(value):
            return value
    except ValueError:
        pass
    return text


def _resolve_columns(df, events):
    spec = expand_names(df, split_spec(events))
    unknown = [c for c in spec if c not in df.columns]
    if unknown:
        raise SystemExit(
            f"unknown columns: {', '.join(unknown)}; "
            f"available: {', '.join(str(c) for c in df.columns)}"
        )
    return df[spec] if spec else df


def _json_records(df):
    try:
        records = df.to_dict(orient="records")
    except Exception:
        records = []
    try:
        for row in records:
            for key, value in list(row.items()):
                try:
                    if pd.isna(value):
                        row[key] = None
                except (TypeError, ValueError):
                    continue
    except Exception:
        pass
    return records


def _info(args):
    try:
        df = perf.system.info()
    except SystemExit:
        raise
    except Exception as ex:
        raise SystemExit(str(ex).splitlines()[0] or "cannot inspect cpu")
    df = _resolve_columns(df, getattr(args, "event", None))
    if want_json(args):
        emit_json_text(
            json.dumps(_json_records(df), indent=4, default=str),
            json_path(args),
        )
    else:
        table = df
        if "freq" in table.columns:
            table = table.assign(freq=[perf.info.format_hz(v) for v in table["freq"]])
        print(format_trace_table(table))
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def _tune(args):
    profile = getattr(args, "profile", None)
    overrides = getattr(args, "profile_overrides", None)
    dry_run = bool(getattr(args, "dry_run", False))
    try:
        df = perf.system.tune(profile=profile, overrides=overrides, dry_run=dry_run)
    except SystemExit:
        raise
    except (ValueError, OSError) as ex:
        raise SystemExit(str(ex).splitlines()[0] or "cannot tune the system")
    _emit_tune_frame(args, df)


def _reset(args):
    dry_run = bool(getattr(args, "dry_run", False))
    try:
        df = perf.system.reset(dry_run=dry_run)
    except SystemExit:
        raise
    except (ValueError, OSError) as ex:
        raise SystemExit(str(ex).splitlines()[0] or "cannot reset the system")
    _emit_tune_frame(args, df)


def _emit_tune_frame(args, df):
    if want_json(args):
        emit_json_text(
            json.dumps(_json_records(df), indent=4, default=str),
            json_path(args),
        )
    else:
        print(format_trace_table(df))
    try:
        warnings = list(getattr(df, "attrs", {}).get("warnings", []) or [])
    except Exception:
        warnings = []
    for warning in warnings:
        print(f"warning: {warning}", file=sys.stderr)
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def require_tune_scope(parser, args):
    if (getattr(args, "command", None) or "").strip() != "tune":
        return
    if (getattr(args, "profile", None) or "") == "default":
        parser.error(
            "tune no longer accepts --profile=default; use `perf system reset` instead"
        )


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf system", description="show system info, tune it, or reset it"
    )
    sub = parser.add_subparsers(dest="command", metavar="info|tune|reset")
    info = sub.add_parser(
        "info",
        help="show CPU topology, frequency, and cache sizes",
        description="show CPU topology, frequency, and cache sizes",
    )
    info.add_argument(
        "--cpu",
        dest="cpu",
        action="store_true",
        help="show CPU topology, frequency, and cache sizes "
        "(default, kept for compatibility)",
    )
    info.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="columns to show, comma-separated or repeated, with `*` expanding a "
        "pattern, e.g. -e cpu,core,L1d (default: all)",
    )
    info.add_argument(
        "--json",
        dest="json",
        nargs="?",
        const=True,
        default=False,
        metavar="FILE",
        help="emit JSON records to stdout, or to FILE when a path is given "
        "(e.g. `--json out.json`)",
    )
    info.add_argument("-i", "--interactive", action="store_true")
    tune = sub.add_parser(
        "tune",
        help="apply a system tuning profile (default: performance)",
        description="apply a system tuning profile (default: performance)",
    )
    tune.add_argument(
        "--profile",
        dest="profile",
        default=None,
        metavar="NAME|FILE",
        help="tuning profile for `perf system tune`: a predefined profile "
        "(performance, latency, throughput) or a JSON file "
        "(e.g. latency.json); the default is performance",
    )
    tune.add_argument(
        "--dry-run",
        dest="dry_run",
        action="store_true",
        help="show what `perf system tune` would change without writing anything",
    )
    tune.add_argument(
        "--json",
        dest="json",
        nargs="?",
        const=True,
        default=False,
        metavar="FILE",
        help="emit JSON records to stdout, or to FILE when a path is given "
        "(e.g. `--json out.json`)",
    )
    tune.add_argument("-i", "--interactive", action="store_true")
    reset = sub.add_parser(
        "reset",
        help="restore stock settings (the `default` profile)",
        description="restore stock settings (the `default` profile)",
    )
    reset.add_argument(
        "--dry-run",
        dest="dry_run",
        action="store_true",
        help="show what `perf system reset` would change without writing anything",
    )
    reset.add_argument(
        "--json",
        dest="json",
        nargs="?",
        const=True,
        default=False,
        metavar="FILE",
        help="emit JSON records to stdout, or to FILE when a path is given "
        "(e.g. `--json out.json`)",
    )
    reset.add_argument("-i", "--interactive", action="store_true")
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args, _unknown = _parser.parse_known_args(apply_perfconfig(_parser, _options))
    if (getattr(_args, "command", None) or "").strip() == "tune":
        _overrides, _unknown = profile_overrides(_parser, _unknown)
    else:
        _overrides = None
    if _unknown or _paths:
        _parser.error(f"unknown argument: {(_unknown or _paths)[0]}")
    _args.profile_overrides = _overrides
    require_tune_scope(_parser, _args)
    _cmd = (getattr(_args, "command", None) or "").strip()
    if _cmd in ("tune", "reset") and not bool(getattr(_args, "dry_run", False)):
        _command = sudo_command(sys.argv[1:])
        if _command is not None:
            try:
                os.execv(_command[0], _command)
            except OSError:
                pass
    main(_args)
