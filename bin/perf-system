import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

try:
    _SRC = Path(__file__).resolve().parent.parent / "src"
    if _SRC.is_dir() and str(_SRC) not in sys.path:
        sys.path.insert(0, str(_SRC))
except OSError:
    pass

import perf
from perf.data import (
    _aliases as _data_aliases,
)
from perf.data import _flag_only as _flag_only
from perf.data import (
    _json_records,
    emit_output,
    expand_names,
    format_trace_table,
    has_output,
    metadata,
    show_table,
    split_after_dashes,
    split_spec,
)
from perf.data import (
    _known as _data_known,
)
from perf.data import (
    apply_perfconfig as _data_apply,
)
from perf.data import is_numeric as is_numeric
from perf.data import (
    parse_option_value as _profile_value,
)
from perf.tune import _system_test_script

_COMMAND = "system"
_DOTTED_KEYS = ("profile.",)


def apply_perfconfig(parser, argv, config_path=None):
    argv = list(argv)
    command = argv[0].strip() if argv and isinstance(argv[0], str) else None
    if command == "test":
        return list(argv)
    sub = _subparser(parser, command)
    if sub is None:
        return list(argv)

    def skip(key, _value, _command, given):
        if key in ("status", "reset"):
            return True
        if key.startswith("profile.") and command != "tune":
            return True
        if (
            command == "tune"
            and "reset" in given
            and (key == "profile" or key.startswith("profile."))
        ):
            return True
        return command == "tune" and "status" in given and key == "dry-run"

    return _data_apply(
        parser,
        argv,
        _COMMAND,
        config_path,
        options=sub,
        prepend=True,
        skip=skip,
        dotted_keys=_DOTTED_KEYS,
    )


def _known(parser, key):
    return _data_known(parser, key, _DOTTED_KEYS)


def _aliases(parser, key):
    return _data_aliases(parser, key, _DOTTED_KEYS)


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.L1d
    %notebook session.ipynb""")

    import sys

    if not getattr(sys.stdin, "isatty", lambda: False)():
        try:
            sys.stdin = open("/dev/tty")
        except Exception:
            pass

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def profile_overrides(parser, argv):
    overrides = {}
    rest = []
    for arg in argv:
        if not arg.startswith("--profile."):
            rest.append(arg)
            continue
        if "=" not in arg:
            parser.error(f"unknown argument: {arg} (expected --profile.KEY=VALUE)")
        key, value = arg[len("--profile.") :].split("=", 1)
        if not key:
            parser.error(f"unknown argument: {arg}")
        overrides[key] = _profile_value(value)
    return overrides, rest


def _perf_import_base():
    try:
        base = str(Path(perf.__file__).resolve().parent.parent)
    except Exception:
        return None
    if not base or not Path(base, "perf").is_dir():
        return base or None
    return base


def _sudo_pythonpath():
    seen = set()
    parts = []

    def _add(path):
        if not path:
            return
        entry = str(path).strip()
        if not entry or entry in seen:
            return
        if entry in ("", ".", ".."):
            return
        try:
            if not os.path.isdir(entry):
                return
            entry = os.path.normpath(entry)
        except Exception:
            return
        if entry in seen:
            return
        seen.add(entry)
        parts.append(entry)

    _add(_perf_import_base())
    try:
        for entry in list(sys.path):
            _add(entry)
    except Exception:
        pass
    try:
        import site as _site

        candidates = []
        for getter in ("getusersitepackages", "getsitepackages"):
            try:
                value = getattr(_site, getter)()
            except Exception:
                continue
            if isinstance(value, (list, tuple)):
                candidates.extend(value)
            elif value:
                candidates.append(value)
        for entry in candidates:
            _add(entry)
    except Exception:
        pass
    try:
        for entry in str(os.environ.get("PYTHONPATH", "")).split(os.pathsep):
            _add(entry)
    except Exception:
        pass
    return os.pathsep.join(parts)


def sudo_command(argv):
    if os.name != "posix" or not hasattr(os, "geteuid"):
        return None
    if os.geteuid() == 0:
        return None
    sudo = shutil.which("sudo")
    if sudo is None:
        return None
    script = str(Path(__file__).resolve())
    pythonpath = _sudo_pythonpath()
    if pythonpath:
        return [
            sudo,
            "env",
            f"PYTHONPATH={pythonpath}",
            sys.executable,
            script,
            *argv,
        ]
    return [sudo, sys.executable, script, *argv]


def main(args):
    cmd = (getattr(args, "command", None) or "").strip()
    if cmd == "info":
        _info(args)
        return
    if cmd == "tune":
        _tune(args)
        return
    if cmd == "test":
        _test(args)
        return
    raise SystemExit(
        "expected `perf system info` (e.g. `perf system info -e arch`), "
        "`perf system tune`, or `perf system test`"
    )


def _subparser(parser, command):
    for action in getattr(parser, "_actions", []):
        if isinstance(action, argparse._SubParsersAction):
            return action.choices.get(command)
    return None


def _resolve_columns(df, events):
    spec = expand_names(df, split_spec(events))
    unknown = [c for c in spec if c not in df.columns]
    if unknown:
        raise SystemExit(
            f"unknown columns: {', '.join(unknown)}; "
            f"available: {', '.join(str(c) for c in df.columns)}"
        )
    return df[spec] if spec else df


def _info(args):
    try:
        df = perf.system.info()
    except SystemExit:
        raise
    except Exception as ex:
        raise SystemExit(str(ex).splitlines()[0] or "cannot inspect cpu")
    df = _resolve_columns(df, getattr(args, "event", None))
    if has_output(getattr(args, "output", None)):
        payload = _json_records(df)
        emit_output(
            args.output,
            payload,
            values=metadata(
                {"file": "", "name": "info", "command": "system info"},
            ),
            template=getattr(args, "_output_template", None),
        )
    if show_table(
        getattr(args, "output", None),
        bool(getattr(args, "_output_from_config", False)),
    ):
        table = df
        if "freq" in table.columns:
            table = table.assign(freq=[perf.info.format_hz(v) for v in table["freq"]])
        print(format_trace_table(table))
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def _status(args):
    profile = getattr(args, "profile", None)
    overrides = getattr(args, "profile_overrides", None)
    try:
        df = perf.system.status(profile=profile, overrides=overrides)
    except SystemExit:
        raise
    except (ValueError, OSError) as ex:
        raise SystemExit(str(ex).splitlines()[0] or "cannot read the tuning status")
    _emit_tune_frame(args, df)


def _tune(args):
    if bool(getattr(args, "status", False)):
        _status(args)
        return
    if bool(getattr(args, "reset", False)):
        _reset(args)
        return
    profile = getattr(args, "profile", None)
    overrides = getattr(args, "profile_overrides", None)
    dry_run = bool(getattr(args, "dry_run", False))
    try:
        df = perf.system.tune(profile=profile, overrides=overrides, dry_run=dry_run)
    except SystemExit:
        raise
    except (ValueError, OSError) as ex:
        raise SystemExit(str(ex).splitlines()[0] or "cannot tune the system")
    _emit_tune_frame(args, df)


def _reset(args):
    dry_run = bool(getattr(args, "dry_run", False))
    try:
        df = perf.system.reset(dry_run=dry_run)
    except SystemExit:
        raise
    except (ValueError, OSError) as ex:
        raise SystemExit(str(ex).splitlines()[0] or "cannot reset the system")
    _emit_tune_frame(args, df)


def _test_path_options(argv):
    values = {}
    rest = []
    for arg in argv:
        if arg.startswith("--config."):
            body = arg[len("--config.") :]
            if "=" in body:
                key, value = body.split("=", 1)
                if key == "test" or key.startswith("test."):
                    values[key] = value
                    continue
        rest.append(arg)
    return values, rest


def _run_test(argv):
    values, forwarded = _test_path_options(argv)
    try:
        path = _system_test_script(values, base=Path(__file__).resolve().parent)
    except ValueError as ex:
        raise SystemExit(str(ex))
    try:
        completed = subprocess.run([str(path), *forwarded], check=False)
    except OSError as ex:
        raise SystemExit(f"cannot run {path}: {ex}")
    raise SystemExit(completed.returncode)


def _test(args):
    _run_test(list(getattr(args, "test_argv", []) or []))


def _emit_tune_frame(args, df):
    if has_output(getattr(args, "output", None)):
        payload = _json_records(df)
        emit_output(
            args.output,
            payload,
            values=metadata(
                {
                    "file": "",
                    "name": (getattr(args, "command", None) or "tune"),
                    "command": "system tune",
                },
            ),
            template=getattr(args, "_output_template", None),
        )
    if show_table(
        getattr(args, "output", None),
        bool(getattr(args, "_output_from_config", False)),
    ):
        print(format_trace_table(df))
    try:
        warnings = list(getattr(df, "attrs", {}).get("warnings", []) or [])
    except Exception:
        warnings = []
    for warning in warnings:
        print(f"warning: {warning}", file=sys.stderr)
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def require_tune_scope(parser, args):
    if (getattr(args, "command", None) or "").strip() != "tune":
        return
    status = bool(getattr(args, "status", False))
    reset = bool(getattr(args, "reset", False))
    if status and reset:
        parser.error("--status and --reset are mutually exclusive")
    if reset:
        if getattr(args, "profile", None) is not None:
            parser.error("--reset does not accept --profile")
        if getattr(args, "profile_overrides", None):
            parser.error("--reset does not accept --profile.KEY=VALUE")
    if status and bool(getattr(args, "dry_run", False)):
        parser.error("--status does not accept --dry-run")
    if not status and not reset and (getattr(args, "profile", None) or "") == "default":
        parser.error(
            "tune no longer accepts --profile=default; use "
            "`perf system tune --reset` instead"
        )


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf system",
        description="show system info, tune it (including status and restore), or "
        "run known-answer measurement checks",
    )
    sub = parser.add_subparsers(dest="command", metavar="info|tune|test")
    info = sub.add_parser(
        "info",
        help="show CPU topology, frequency, and cache sizes",
        description="show CPU topology, frequency, and cache sizes",
    )
    info.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="columns to show, comma-separated or repeated, with `*` expanding a "
        "pattern, e.g. -e cpu,core,L1d (default: all)",
    )
    info.add_argument(
        "-o",
        "--output",
        dest="output",
        action="append",
        nargs="?",
        const=True,
        default=None,
        metavar="FILE",
        help="write JSON records to FILE, or to stdout when no FILE is given; "
        "repeat --output to write several destinations; a directory (or a path "
        "ending in /) uses the output template (default "
        "{time}-{command}-{target}-{id}.json, override in .perfconfig)",
    )
    info.add_argument("-i", "--interactive", action="store_true")
    tune = sub.add_parser(
        "tune",
        help="apply a system tuning profile (default: performance)",
        description="apply a system tuning profile, show the current status, or "
        "restore the configuration saved before the last tune",
    )
    tune.add_argument(
        "--profile",
        dest="profile",
        default=None,
        metavar="NAME|FILE",
        help="tuning profile for `perf system tune` (and `--status`): a "
        "predefined profile (default, performance, latency, throughput) or a "
        "JSON file (e.g. latency.json); the default is performance",
    )
    tune.add_argument(
        "--status",
        dest="status",
        action="store_true",
        help="show the tuning values for `--profile` instead of applying them "
        "(read-only)",
    )
    tune.add_argument(
        "--reset",
        dest="reset",
        action="store_true",
        help="restore the configuration saved in .perftune before the last tune",
    )
    tune.add_argument(
        "--dry-run",
        dest="dry_run",
        action="store_true",
        help="show what `perf system tune` or `--reset` would change without "
        "writing anything",
    )
    tune.add_argument(
        "-o",
        "--output",
        dest="output",
        action="append",
        nargs="?",
        const=True,
        default=None,
        metavar="FILE",
        help="write JSON records to FILE, or to stdout when no FILE is given; "
        "repeat --output to write several destinations; a directory (or a path "
        "ending in /) uses the output template (default "
        "{time}-{command}-{target}-{id}.json, override in .perfconfig)",
    )
    tune.add_argument("-i", "--interactive", action="store_true")
    test = sub.add_parser(
        "test",
        help="run known-answer measurement checks against documented values",
        description="run the architecture-specific perf-system-test",
        add_help=False,
    )
    test.add_argument("test_argv", nargs=argparse.REMAINDER)
    return parser


if __name__ == "__main__":
    if sys.argv[1:2] == ["test"]:
        _run_test(sys.argv[2:])
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _args, _unknown = _parser.parse_known_args(apply_perfconfig(_parser, _options))
    if (getattr(_args, "command", None) or "").strip() == "tune":
        _overrides, _unknown = profile_overrides(_parser, _unknown)
    else:
        _overrides = None
    if _unknown or _paths:
        _parser.error(f"unknown argument: {(_unknown or _paths)[0]}")
    _args.profile_overrides = _overrides
    require_tune_scope(_parser, _args)
    _cmd = (getattr(_args, "command", None) or "").strip()
    _read_only = bool(
        getattr(_args, "status", False) or getattr(_args, "dry_run", False)
    )
    if _cmd == "tune" and not _read_only:
        _command = sudo_command(sys.argv[1:])
        if _command is not None:
            try:
                os.execv(_command[0], _command)
            except OSError:
                pass
    main(_args)
