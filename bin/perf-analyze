import argparse
import configparser
import io
import json
import math
import os
import re
import sys
from pathlib import Path

import pandas as pd

import perf
from perf.arch import arch as get_arch
from perf.bench import (
    _BACKEND_OPTION_KEYS,
    _BACKENDS,
    _BRANCH_CHOICES,
    _DEFAULT_BENCH,
    _LIST_TOPS,
    _VALID_TOP_KEYS,
    _branch_value,
    _canonical_data_reg_key,
    _deep_merge,
    _mem_entries,
    _merge_data,
    _normalize_spec,
    _order_bench_columns,
    normalize_container,
    parse_code,
    validate_spec,
)
from perf.mca import DEFAULT_EVENTS
from perf.core import _DURATION_TIME, _is_mem_addr_key, _split_list, one_line
from perf.data import _IDENTITY_COLUMNS, envelope_frame, is_record, parse

arch = get_arch()

_COMMAND = "analyze"
_PERFCONFIG = ".perfconfig"
_PERFCONFIG_COMMENTS = ("#", ";")
_DOTTED_KEYS = ("config.", "data.")
_DURATION_SCALE = {"ns": 1.0, "us": 1e3, "ms": 1e6, "s": 1e9}
_DURATION_RE = re.compile(r"^([-+]?(\d+(?:\.\d*)?|\.\d+))(ns|us|ms|s)$")
_TABLE_EMPTY = frozenset({"", "nan", "none", "nat", "null"})
_TABLE_EXTS = frozenset({".txt", ".tsv", ".csv"})
_PLAIN_COLUMNS = (
    "stat",
    "file",
    "name",
    "mode",
    "time",
    "iterations",
    "operations",
    "threads",
    "tid",
    "index",
    "address",
    "size",
)
_USAGE = (
    "expected `perf analyze a.out:fizz_buzz`, `perf analyze a.out:hot_begin..hot_end`, "
    "`perf analyze a.s:label` or `perf analyze 'mov eax, 42'`"
)


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.assembly
    df.groupby(["name", "mode"]).latency.describe()
    %notebook session.ipynb""")

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def to_float(value):
    try:
        if pd.isna(value):
            return None
    except (TypeError, ValueError):
        pass
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return number if math.isfinite(number) else None


def _blank(value):
    try:
        return bool(pd.isna(value))
    except (TypeError, ValueError):
        return False


def is_duration_col(column):
    text = str(column)
    return text == _DURATION_TIME or text.startswith(f"{_DURATION_TIME}/")


def format_duration(value):
    ns = to_float(value)
    if ns is None:
        try:
            float(value)
            return ""
        except (TypeError, ValueError):
            return "" if _blank(value) else str(value)
    if ns < 0:
        return f"{ns:.2f}"
    if ns < 1e3:
        return f"{ns:.2f}ns"
    if ns < 1e6:
        return f"{ns / 1e3:.2f}us"
    if ns < 1e9:
        return f"{ns / 1e6:.2f}ms"
    return f"{ns / 1e9:.2f}s"


def format_number(value):
    number = to_float(value)
    if number is None:
        try:
            float(value)
            return ""
        except (TypeError, ValueError):
            return "" if _blank(value) else str(value)
    return f"{number:.2f}"


def format_table(df):
    out = df.copy()
    for column in out.columns:
        if column in _PLAIN_COLUMNS:
            continue
        if is_duration_col(column):
            out[column] = [format_duration(v) for v in out[column]]
            continue
        try:
            if pd.api.types.is_numeric_dtype(out[column]):
                out[column] = [format_number(v) for v in out[column]]
        except Exception:
            pass
    try:
        out = out.where(pd.notna(out), "")
    except Exception:
        pass
    return out


def json_target(args):
    v = getattr(args, "json", False)
    if v is False or v is None:
        return False, None
    if v is True:
        return True, None
    s = str(v).strip()
    if not s:
        return True, None
    low = s.lower()
    if low in ("-", "true", "1", "yes", "on"):
        return True, None
    if low in ("false", "0", "no", "off"):
        return False, None
    return True, s


def want_json(args):
    return bool(json_target(args)[0])


def json_path(args):
    return json_target(args)[1]


def emit_json_text(text, path):
    if path is None:
        print(text, flush=True)
        return
    dest = Path(str(path))
    try:
        parent = dest.parent
        if str(parent) not in ("", "."):
            parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(text + ("" if text.endswith("\n") else "\n"))
    except OSError as ex:
        raise SystemExit(f"cannot write --json file {path!r}: {ex}")


def _looks_like_json_file(value):
    return str(value or "").strip().lower().endswith(".json")


def _fix_json_code_ambiguity(args):
    code = getattr(args, "code", None)
    v = getattr(args, "json", False)
    if code or not isinstance(v, str):
        return args
    if _looks_like_json_file(v):
        return args
    args.code = v
    args.json = True
    return args


def target_text(target):
    if isinstance(target, (list, tuple)):
        return "..".join(str(p) for p in target)
    return "" if target is None else str(target)


def bench_code(raw):
    try:
        return parse_code(raw)
    except ValueError as ex:
        raise SystemExit(str(ex))


def bench_snippet(raw, file=None, what="setup"):
    if raw is None:
        return None
    values = raw if isinstance(raw, (list, tuple)) else [raw]
    names = []
    for value in values:
        other, target, asm = bench_code(value)
        if other is not None:
            if file is None:
                raise SystemExit(
                    f"{what} {value!r} names a file, but the analysis is a snippet"
                )
            if other != file:
                raise SystemExit(f"{what} {value!r} must be a symbol of {file!r}")
        name = target if target is not None else asm
        if name is not None:
            names.append(name)
    return names or None


def _is_asm_source_file(path):
    return str(path or "").lower().endswith((".s", ".asm"))


def _list_patterns(target):
    if target is None:
        return []
    if isinstance(target, (list, tuple)):
        pats = []
        for part in target:
            text = "" if part is None else str(part).strip()
            if text:
                pats.append(text)
        return pats
    text = str(target).strip()
    return [text] if text else []


def _filter_list_df(df, pats):
    if not pats or df is None or "name" not in df.columns:
        return df
    names = df["name"].astype(str).tolist()
    keep = []
    for name in names:
        hit = False
        for pat in pats:
            try:
                if re.search(pat, name):
                    hit = True
                    break
            except re.error as ex:
                raise SystemExit(f"invalid --list pattern {pat!r}: {ex}")
        keep.append(hit)
    try:
        return df[keep].reset_index(drop=True)
    except Exception:
        return df


def _list_split_spec(value):
    return _split_list(value, expand=False)


def _list_match(pattern, text):
    return (
        re.fullmatch(
            "".join(
                ".*" if c == "*" else "." if c == "?" else re.escape(c)
                for c in str(pattern)
            ),
            str(text),
        )
        is not None
    )


def _list_expand_names(df, names):
    names = [str(n) for n in names or []]
    if not any(any(w in n for w in ("*", "?")) for n in names):
        return names
    out = []
    for name in names:
        if any(w in name for w in ("*", "?")):
            found = [c for c in df.columns if c not in out and _list_match(name, c)]
            if found:
                out.extend(found)
                continue
        if name not in out:
            out.append(name)
    return out


def _resolve_list_columns(df, events):
    spec = _list_expand_names(df, _list_split_spec(events))
    unknown = [c for c in spec if c not in df.columns]
    if unknown:
        raise SystemExit(
            f"unknown columns: {', '.join(unknown)}; "
            f"available: {', '.join(str(c) for c in df.columns)}"
        )
    return df[spec] if spec else df


def _list_cell(value):
    if value is None or (
        not isinstance(value, (list, tuple, dict, set)) and pd.isna(value)
    ):
        return ""
    return one_line(value)


def _list_is_numeric(df, column):
    try:
        if pd.api.types.is_bool_dtype(df[column]):
            return False
        return bool(pd.api.types.is_numeric_dtype(df[column]))
    except Exception:
        return False


def _format_list_table(df):
    if df is None or not len(df.columns):
        return ""
    columns = list(df.columns)
    cells = {c: [_list_cell(v) for v in df[c].tolist()] for c in columns}
    numeric = {c: _list_is_numeric(df, c) for c in columns}
    widths = {c: max([len(str(c))] + [len(s) for s in cells[c]]) for c in columns}
    lines = [
        "  ".join(
            str(c).rjust(widths[c]) if numeric[c] else str(c).ljust(widths[c])
            for c in columns
        ).rstrip()
    ]
    for i in range(len(df)):
        lines.append(
            "  ".join(
                cells[c][i].rjust(widths[c])
                if numeric[c]
                else cells[c][i].ljust(widths[c])
                for c in columns
            ).rstrip()
        )
    return "\n".join(lines)


def _list_targets(args):
    code = getattr(args, "code", None)
    file, target, asm = bench_code(code)
    if not file:
        raw = "" if code is None else str(code).strip()
        if raw and not (asm or "").strip():
            file = raw.partition(":")[0].strip() or None
        if not file:
            if (asm or "").strip():
                raise SystemExit(
                    "--list needs a file, e.g. `perf analyze a.out --list`; "
                    "snippets have no symbols to list"
                )
            raise SystemExit(
                "a file is required, e.g. `perf analyze a.out --list` or "
                "`perf analyze a.out:func --list`"
            )
    if _is_asm_source_file(file):
        if not Path(file).exists():
            raise SystemExit(f"file {file!r} does not exist")
        try:
            labels = perf.metadata.asm_labels(file)
        except FileNotFoundError:
            raise SystemExit(f"file {file!r} does not exist")
        except Exception as ex:
            raise SystemExit(str(ex).splitlines()[0] or f"cannot inspect {file!r}")
        df = pd.DataFrame(
            [{"name": n, "position": p, "size": s} for n, p, s in labels],
            columns=["name", "position", "size"],
        )
        df = _filter_list_df(df, _list_patterns(target))
        df = _resolve_list_columns(df, getattr(args, "event", None))
        if want_json(args):
            emit_json_text(
                json.dumps(df.to_dict(orient="records"), indent=4, default=str),
                json_path(args),
            )
        else:
            print(_format_list_table(df))
    else:
        if not Path(file).exists():
            raise SystemExit(f"file {file!r} does not exist")
        try:
            df = perf.metadata(file)
        except FileNotFoundError:
            raise SystemExit(f"file {file!r} does not exist")
        except SystemExit:
            raise
        except Exception as ex:
            raise SystemExit(str(ex).splitlines()[0] or f"cannot inspect {file!r}")
        df = _filter_list_df(df, _list_patterns(target))
        df = _resolve_list_columns(df, getattr(args, "event", None))
        if want_json(args):
            emit_json_text(
                json.dumps(df.to_dict(orient="records"), indent=4, default=str),
                json_path(args),
            )
        else:
            print(_format_list_table(perf.info.hex_addresses(df)))
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def _table_number(text, duration=False):
    if isinstance(text, str) and text.strip().lower() in _TABLE_EMPTY:
        return float("nan")
    if duration:
        match = _DURATION_RE.match(str(text).strip())
        if match:
            return float(match.group(1)) * _DURATION_SCALE[match.group(3)]
    try:
        return float(text)
    except (TypeError, ValueError):
        return text


def _token_spans(text):
    spans, start = [], None
    for i, c in enumerate(text):
        if c.isspace():
            if start is not None:
                spans.append((start, i))
                start = None
        elif start is None:
            start = i
    if start is not None:
        spans.append((start, len(text)))
    return spans


def table_to_df(text):
    lines = str(text).splitlines()
    while lines and not lines[0]:
        lines.pop(0)
    while lines and not lines[-1]:
        lines.pop()
    if not lines:
        return pd.DataFrame()
    header = lines[0]
    if "," in header or "\t" in header:
        sep = "\t" if "\t" in header else ","
        try:
            df = pd.read_csv(
                io.StringIO("\n".join(lines)), sep=sep, engine="python"
            )
        except Exception as ex:
            raise ValueError(f"unrecognized perf result table ({ex})")
    else:
        tokens = _token_spans(header)
        if not tokens:
            return pd.DataFrame()

        def _parse(spans):
            columns = [header[s:e].strip() for s, e in spans]
            if any(not c for c in columns):
                return None
            rows = [
                [
                    (line[s:e].strip() if e is not None else line[s:].strip())
                    if s < len(line)
                    else ""
                    for s, e in spans
                ]
                for line in lines[1:]
            ]
            if not rows:
                return None
            return pd.DataFrame(
                {c: [r[i] for r in rows] for i, c in enumerate(columns)}
            )

        def _numeric_score(frame):
            score = 0
            for column in frame.columns:
                values = [str(v).strip() for v in frame[column].tolist()]
                values = [v for v in values if v]
                if not values:
                    continue
                good = 0
                for value in values:
                    try:
                        float(value)
                        good += 1
                        continue
                    except ValueError:
                        pass
                    if re.fullmatch(
                        r"[-+]?\d*\.?\d+(?:[eE][-+]?\d+)?(?:ns|us|ms|s)", value
                    ):
                        good += 1
                score += good
            return score

        ends = [e for _, e in tokens]
        right_starts = [0] + [ends[i - 1] + 1 for i in range(1, len(ends))]
        right_spans = list(zip(right_starts, ends))
        right_spans[-1] = (right_spans[-1][0], None)
        left_starts = [0] + [s for s, _ in tokens[1:]]
        left_spans = list(zip(left_starts, [*left_starts[1:], None]))
        right = _parse(right_spans)
        left = _parse(left_spans)
        if left is not None and right is not None:
            score_left = _numeric_score(left)
            score_right = _numeric_score(right)
            if score_left != score_right:
                df = left if score_left > score_right else right
            else:
                first_row = lines[1] if len(lines) > 1 else ""
                df = left if first_row and not first_row[0].isspace() else right
        else:
            df = right if right is not None else left
        if df is None:
            raise ValueError("unrecognized perf result table")
    for column in df.columns:
        duration = is_duration_col(column)
        df[column] = [_table_number(v, duration) for v in df[column].tolist()]
    return df


def merge_envelope_data(payload, df):
    for key in (*_IDENTITY_COLUMNS, "time"):
        if key in payload and key not in df.columns:
            df[key] = payload[key]
    for key in ("data", "config", "info", "id"):
        if payload.get(key) is not None and key not in df.attrs:
            df.attrs[key] = payload[key]
    return _order_bench_columns(df)


def load_path(path, strict=True):
    try:
        is_record_file = is_record(path)
    except Exception:
        is_record_file = False
    if is_record_file:
        return parse([path])
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError as ex:
        if not strict:
            return None
        raise SystemExit(f"cannot read {path!r}: {ex}")
    try:
        payload = json.loads(text)
    except ValueError:
        payload = None
    if isinstance(payload, dict) and "output" in payload:
        return merge_envelope_data(payload, envelope_frame(payload))
    if str(text).lstrip()[:1] in ("{", "["):
        if not strict:
            return None
        raise SystemExit(
            f"invalid envelope JSON in {path!r}: missing 'output' "
            "(expected a perf envelope or a result table)"
        )
    try:
        df = table_to_df(text)
    except ValueError as ex:
        if not strict:
            return None
        raise SystemExit(f"cannot read {path!r} as a perf result table: {ex}")
    if df is None or df.empty:
        if not strict:
            return None
        raise SystemExit(f"no data rows in {path!r}")
    return df


def _read_result_paths(paths):
    data = []
    for p in map(Path, paths):
        if p.is_file():
            data.append((p, True))
            continue
        if not p.is_dir():
            continue
        for f in p.rglob("*"):
            try:
                if not f.is_file():
                    continue
            except OSError:
                continue
            name = f.name
            if (
                name.endswith(".json")
                or name.startswith("perf.data")
                or name.endswith(".data")
                or f.suffix.lower() in _TABLE_EXTS
            ):
                data.append((f, False))
    return data


def load_paths(paths):
    frames = []
    for path in paths:
        files = _read_result_paths([path])
        if not files:
            raise SystemExit(f"no data files found in {[str(path)]!r}")
        for f, explicit in files:
            frame = load_path(f, strict=explicit)
            if frame is None:
                print(
                    f"skipping {f}: not a perf envelope or result table",
                    file=sys.stderr,
                )
                continue
            frames.append(frame)
    if not frames:
        raise SystemExit(f"no readable data in {[str(p) for p in paths]!r}")
    return frames


def _perfconfig_path():
    try:
        current = Path.cwd().resolve()
        home = Path.home().resolve()
    except OSError:
        return None
    while True:
        candidate = current / _PERFCONFIG
        try:
            if candidate.is_file():
                return candidate
        except OSError:
            pass
        if current == home or current.parent == current:
            return None
        current = current.parent


def _config_entries(path=None):
    path = Path(path) if path is not None else _perfconfig_path()
    if path is None or not path.is_file():
        return {}
    parser = configparser.ConfigParser(
        interpolation=None,
        strict=False,
        comment_prefixes=_PERFCONFIG_COMMENTS,
        inline_comment_prefixes=_PERFCONFIG_COMMENTS,
    )
    try:
        with open(path, encoding="utf-8") as fh:
            parser.read_file(fh, source=str(path))
    except (configparser.Error, UnicodeDecodeError, OSError):
        return {}
    entries = {}
    for section in ("default", _COMMAND):
        if not parser.has_section(section):
            continue
        for key, value in parser.items(section):
            if key.strip() and value.strip():
                entries[key] = value.strip()
    return entries


def _known(parser, key):
    if key.startswith(_DOTTED_KEYS):
        return True
    return any(
        action.dest == key or key in {o.lstrip("-") for o in action.option_strings}
        for action in parser._actions
    )


def _aliases(parser, key):
    if key.startswith(_DOTTED_KEYS):
        return {key}
    aliases = {key}
    for action in parser._actions:
        if action.dest == key:
            aliases |= {o.lstrip("-") for o in action.option_strings}
    return aliases


def _option_name(parser, key):
    for action in parser._actions:
        if action.dest == key or key in {o.lstrip("-") for o in action.option_strings}:
            for option in action.option_strings:
                if option.startswith("--"):
                    return option.lstrip("-")
            if action.option_strings:
                return action.option_strings[0].lstrip("-")
    return key


def _flag_only(parser, key):
    return any(
        (action.dest == key or _option_name(parser, key) in {o.lstrip("-") for o in action.option_strings})
        and isinstance(action, (argparse._StoreTrueAction, argparse._StoreFalseAction))
        for action in parser._actions
    )


def _given(argv):
    given = set()
    for arg in argv:
        if arg == "--":
            break
        if arg.startswith("--"):
            given.add(arg[2:].split("=", 1)[0])
        elif arg.startswith("-") and len(arg) > 1:
            given.add(arg[:2].lstrip("-"))
    return given


def _truthy(value):
    text = str(value).strip().lower()
    if text in ("1", "true", "yes", "on"):
        return True
    if text in ("0", "false", "no", "off"):
        return False
    return None


def apply_perfconfig(parser, argv, config_path=None):
    entries = _config_entries(config_path)
    if not entries:
        return list(argv)
    given = _given(argv)
    pending = []
    for key, value in entries.items():
        if not _known(parser, key) or _aliases(parser, key) & given:
            continue
        if key == "json":
            on = _truthy(value)
            if on is True:
                pending.append("--json=true")
            elif on is False:
                continue
            else:
                pending.append(f"--json={value}")
            continue
        if _flag_only(parser, key):
            on = _truthy(value)
            if on is None:
                parser.error(
                    f"invalid [{_COMMAND}] {key} = {value!r}; expected a boolean "
                    "(true/false)"
                )
            if on:
                pending.append(f"--{_option_name(parser, key)}")
            continue
        pending.append(f"--{_option_name(parser, key)}={value}")
    return pending + list(argv)


def split_after_dashes(argv):
    if "--" in argv:
        sep = argv.index("--")
        return list(argv[:sep]), list(argv[sep + 1 :])
    return list(argv), []


def _split_seq(text):
    return [y for y in re.split(r"[,\s]+", text.strip()) if y.strip()]


def _unquote(text):
    s = str(text).strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
        return s[1:-1]
    return s


def _parse_scalar(text):
    s = _unquote(text)
    if s.lower() == "true":
        return True
    if s.lower() == "false":
        return False
    try:
        return int(s, 0)
    except ValueError:
        pass
    try:
        value = float(s)
        if math.isfinite(value):
            return value
    except ValueError:
        pass
    return s


def _parse_atom(text):
    text = text.strip()
    if text.startswith("{") and text.endswith("}"):
        return parse_value(text)
    if text.startswith("[") and text.endswith("]"):
        return [_parse_atom(y) for y in _split_seq(text[1:-1])]
    if "," in text:
        return [_parse_atom(y) for y in text.split(",") if y.strip()]
    return _parse_scalar(text)


def parse_value(text):
    v = text.strip()
    if v.startswith("{") and v.endswith("}"):
        body = v[1:-1].strip()
        if not body:
            return {}
        out = {}
        for item in body.split(","):
            if ":" not in item:
                raise ValueError(f"invalid dict item: {item!r}")
            key, value = item.split(":", 1)
            out[_unquote(key)] = parse_value(value.strip())
        return out
    if v.startswith("[") and v.endswith("]"):
        return [_parse_atom(x) for x in _split_seq(v[1:-1])]
    if "," in v:
        return [x.strip() for x in v.split(",") if x.strip()]
    if ":" in v and not v.startswith("["):
        key, value = v.split(":", 1)
        return {key.strip(): parse_value(value.strip())}
    return _parse_scalar(v)


def parse_target_args(parser, argv):
    args, unknown = parser.parse_known_args(argv)
    config = json.loads(json.dumps(_DEFAULT_BENCH))

    def _cli_value(value):
        try:
            return parse_value(value)
        except ValueError as ex:
            parser.error(str(ex))

    def _store_mem_range(base_str, value, rest_hint=""):
        entries = list(_mem_entries(base_str, value))
        if not entries:
            parser.error(f"unknown data key: --data{rest_hint or base_str}")
            return
        for k, v in entries:
            data["mem"][k] = v

    def _apply_data_override(rest, value):
        bracket = rest.find("[")
        if bracket != -1 and rest.endswith("]"):
            ns = rest[:bracket]
            inner = rest[bracket + 1 : -1]
            if ns:
                parser.error(
                    f"unknown data key: --data{rest} "
                    "(use --data.rdi=.., --data.0x1000=.., --data[0x1000]=..)"
                )
                return
            if _is_mem_addr_key(inner):
                _store_mem_range(inner, value, rest)
            else:
                data["regs"][_canonical_data_reg_key(inner)] = value
            return
        if "." in rest:
            parser.error(
                f"unknown data key: --data.{rest} "
                "(use --data.rdi=.., --data.0x1000=.., --data[0x1000]=..)"
            )
            return
        if _is_mem_addr_key(rest):
            _store_mem_range(rest, value, rest)
            return
        data["regs"][_canonical_data_reg_key(rest)] = value

    def _expand_intermediate(top, cur):
        if top in ("dcache", "icache", "dtlb", "itlb") and isinstance(cur, str):
            table = arch._MEMORY_SHORTCUTS if top == "dcache" else arch._TIER_SHORTCUTS
            shortcut = table.get(cur.strip().lower())
            if shortcut is None:
                parser.error(
                    f"unknown cache shortcut {cur!r}; expected one of "
                    "'hot', 'warm', 'cool', 'cold'"
                )
            if top == "dcache":
                return dict(shortcut)
            tier = {"icache": "L1i", "dtlb": "TLBd", "itlb": "TLBi"}[top]
            return {tier: shortcut[tier]}
        if top == "branch" and isinstance(cur, (str, bool)):
            if isinstance(cur, bool):
                prediction = "predictable" if cur else "unpredictable"
            else:
                prediction = _branch_value(cur)
                if prediction is None:
                    parser.error(
                        "branch prediction must be one of "
                        f"{', '.join(_BRANCH_CHOICES)}, got {cur!r}"
                    )
            return {"prediction": prediction}
        return {}

    def _pin_container(key):
        cur = config.get(key)
        if not isinstance(cur, list):
            return cur if isinstance(cur, dict) else {}
        first = cur[0] if cur else None
        while isinstance(first, list) and first:
            first = first[0]
        entry = dict(first) if isinstance(first, dict) else {}
        config[key] = [[entry]] if key == "thread" else [entry]
        return entry

    def _check_top(top):
        if top not in _VALID_TOP_KEYS:
            parser.error(
                f"unknown argument: --config.{top} "
                f"(expected one of {', '.join(sorted(_VALID_TOP_KEYS))})"
            )

    def _check_nested(top, leaf, parts=()):
        expected = {
            "thread": ("affinity", "priority", "numa"),
            "func": ("align", "order"),
            "code": ("align",),
            "stack": ("size", "align"),
            "iterations": ("min", "max", "count"),
            "external": ("lib", "stdout", "stderr"),
        }.get(top)
        if expected is not None and leaf not in expected:
            parser.error(
                f"unknown argument: --config.{top}.{leaf} "
                f"(expected {', '.join(repr(e) for e in expected)})"
            )
        if top == "backend":
            name = leaf
            if name not in _BACKENDS:
                parser.error(
                    f"unknown argument: --config.backend.{name} (expected "
                    f"{' or '.join(_BACKENDS)}, or one of "
                    f"{', '.join(sorted(_BACKEND_OPTION_KEYS))})"
                )
            if len(parts) >= 3 and parts[2] not in _BACKEND_OPTION_KEYS:
                parser.error(
                    f"unknown argument: --config.backend.{name}.{parts[2]} "
                    f"(expected one of {', '.join(sorted(_BACKEND_OPTION_KEYS))})"
                )
            if len(parts) > 3:
                parser.error(f"unknown argument: --config.{'.'.join(parts)}")

    def _apply_config_override(rest, value):
        bracket = rest.find("[")
        if bracket != -1 and rest.endswith("]"):
            key = rest[:bracket]
            addr = rest[bracket + 1 : -1]
            parts = [p for p in key.split(".") if p]
            if not parts:
                parser.error(f"unknown argument: --config.{rest}")
            _check_top(parts[0])
            if len(parts) >= 2:
                _check_nested(parts[0], parts[1], parts)
            top = parts[0]
            leaf = parts[-1]
            if top not in ("branch", "dcache", "icache", "dtlb", "itlb"):
                parser.error(
                    f"per-address overrides --config.{rest} are only supported "
                    "for branch and the cache/tlb keys "
                    "(e.g. --config.dcache.L1d[0x1000]=hot)"
                )
            node = config
            for p in parts[:-1]:
                nxt = node.get(p)
                if not isinstance(nxt, dict):
                    nxt = {} if nxt is None else _expand_intermediate(p, nxt)
                    if not isinstance(nxt, dict):
                        nxt = {}
                    node[p] = nxt
                node = nxt
            base = dict(node.get(leaf)) if isinstance(node.get(leaf), dict) else {}
            base[addr] = value
            node[leaf] = base
            return
        parts = [p for p in rest.split(".") if p]
        if not parts:
            parser.error(f"unknown argument: --config.{rest}")
        _check_top(parts[0])
        if len(parts) >= 2:
            _check_nested(parts[0], parts[1], parts)
        if parts[0] in (*_LIST_TOPS, "thread"):
            if len(parts) == 1:
                config[parts[0]] = normalize_container(parts[0], value)
                return
            node = _pin_container(parts[0])
            for p in parts[1:-1]:
                nxt = node.get(p)
                if not isinstance(nxt, dict):
                    nxt = {}
                    node[p] = nxt
                node = nxt
            if isinstance(value, list) and parts[0] in ("code", "stack", "func"):
                base = dict(node)
                leaf = parts[-1]
                config[parts[0]] = [{**base, leaf: v} for v in value] or [{**base}]
                return
            node[parts[-1]] = value
            return
        node = config
        for p in parts[:-1]:
            nxt = node.get(p)
            if not isinstance(nxt, dict):
                nxt = {} if nxt is None else _expand_intermediate(parts[0], nxt)
                node[p] = nxt
            node = nxt
        node[parts[-1]] = value

    data = {"regs": {}, "mem": {}}
    if getattr(args, "config", None):
        try:
            with open(args.config) as f:
                loaded = json.load(f)
        except OSError as ex:
            parser.error(f"cannot read --config {args.config!r}: {ex}")
        except json.JSONDecodeError as ex:
            parser.error(f"invalid JSON in --config {args.config!r}: {ex}")
        if not isinstance(loaded, dict):
            parser.error("config file must contain a JSON object")
        if "data" in loaded:
            parser.error(
                "config file must not contain 'data'; use --data instead (e.g. "
                "--data.rdi=15 or --data '{\"rdi\": 15}')"
            )
        config = _normalize_spec(_deep_merge(config, loaded))

    for arg in unknown:
        if "=" not in arg:
            parser.error(f"unknown argument: {arg}")
        if arg.startswith("--data["):
            key, value = arg[len("--data") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_data_override(key, _cli_value(value))
            continue
        if arg.startswith("--data."):
            key, value = arg[len("--data.") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_data_override(key, _cli_value(value))
            continue
        if arg.startswith("--config."):
            key, value = arg[len("--config.") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_config_override(key, _cli_value(value))
            continue
        parser.error(f"unknown argument: {arg}")

    flag_data = None
    if getattr(args, "data", None):
        raw_data = args.data
        if os.path.isfile(raw_data):
            try:
                with open(raw_data) as f:
                    flag_data = json.load(f)
            except OSError as ex:
                parser.error(f"cannot read --data {raw_data!r}: {ex}")
            except json.JSONDecodeError as ex:
                parser.error(f"invalid --data JSON in {raw_data!r}: {ex}")
        else:
            try:
                flag_data = json.loads(raw_data)
            except json.JSONDecodeError as ex:
                parser.error(f"invalid --data JSON: {ex}")
    try:
        validate_spec(config)
    except ValueError as ex:
        parser.error(str(ex))
    args.config = config
    has_data = bool((data.get("regs") or data.get("mem")) or flag_data)
    args.data = _merge_data(flag_data, data) if has_data else None
    return args


def _is_state_col(column):
    name = str(column)
    return name.startswith(("data.", "data[", "mem-"))


def _format_state(values):
    out = []
    for value in values:
        if value is None or (isinstance(value, float) and pd.isna(value)):
            out.append("")
            continue
        items = value if isinstance(value, (list, tuple)) else [value]
        cells = []
        for item in items:
            try:
                cells.append(str(int(item)) if float(item).is_integer() else str(item))
            except (TypeError, ValueError):
                cells.append(str(item))
        out.append(f"[{', '.join(cells)}]")
    return out


def _left_align(df, columns=("assembly", "encoding")):
    out = df.copy()
    for column in columns:
        if column not in out.columns:
            continue
        text = out[column].astype(str)
        width = text.str.len().max()
        out[column] = text.str.ljust(int(width) if pd.notna(width) else 0)
    return out


def _is_asm_script(table):
    return list(table.columns) == ["assembly"]


_DEBUG_CONTEXT = 3


def _debug_source_lines(path, cache):
    lines = cache.get(path)
    if lines is None:
        try:
            with open(path, encoding="utf-8", errors="ignore") as fh:
                lines = fh.read().splitlines()
        except Exception:
            lines = []
        cache[path] = lines
    return lines or []


def _debug_code(path, num, cache, fallback=""):
    if fallback:
        return str(fallback).rstrip()
    try:
        at = int(num)
    except Exception:
        return ""
    if at <= 0:
        return ""
    lines = _debug_source_lines(path, cache)
    try:
        return str(lines[at - 1]).rstrip()
    except Exception:
        return ""


def _emit_debug(out, text):
    if text is None:
        return
    if str(text).strip():
        out.append(str(text).rstrip())


def _with_debug(lines, debug, context=_DEBUG_CONTEXT):
    if not lines or not debug or len(lines) - 1 != len(debug):
        return lines
    out = [lines[0]]
    cache = {}
    shown_max = {}
    prev = None
    for row, entry in zip(lines[1:], debug):
        if entry is not None:
            try:
                src, num, code = entry
                src = str(src)
                num = int(num)
            except Exception:
                prev = None
                out.append(row)
                continue
            key = (src, num)
            if key != prev:
                current = _debug_code(src, num, cache, code)
                top = shown_max.get(src)
                if top is None:
                    try:
                        start = max(1, num - int(context))
                    except Exception:
                        start = num
                    for missing in range(start, num):
                        _emit_debug(out, _debug_code(src, missing, cache, ""))
                    _emit_debug(out, current)
                    shown_max[src] = num
                elif num > top + 1:
                    for missing in range(top + 1, num):
                        _emit_debug(out, _debug_code(src, missing, cache, ""))
                    _emit_debug(out, current)
                    shown_max[src] = num
                elif num > top:
                    _emit_debug(out, current)
                    shown_max[src] = num
                else:
                    _emit_debug(out, current)
                prev = key
        else:
            prev = None
        out.append(row)
    return out


def _fixed_width_table(df):
    columns = list(df.columns)
    try:
        rows = [[_list_cell(v) for v in df[c].tolist()] for c in columns]
    except Exception:
        return [str(df)]
    widths = [
        max([len(str(c))] + [len(values[i]) for i in range(len(df))])
        for c, values in zip(columns, rows)
    ]
    lines = [
        " ".join(
            str(c).ljust(width) for c, width in zip(columns, widths)
        ).rstrip()
    ]
    for i in range(len(df)):
        lines.append(
            " ".join(
                values[i].ljust(width)
                for values, width in zip(rows, widths)
            ).rstrip()
        )
    return lines


def format_analyze_table(df):
    out = df.copy()
    if out.empty:
        return str(out)
    for column in out.columns:
        if _is_state_col(column):
            out[column] = _format_state(out[column].tolist())
    table = perf.info.hex_addresses(format_table(out), columns=("address",))
    table = table.astype(str)
    lines = _fixed_width_table(table)
    script = _is_asm_script(table) and lines and lines[0].split() == ["assembly"]
    if script:
        lines[0] = ".intel_syntax"
    debug = getattr(df, "attrs", {}).get("debug") if hasattr(df, "attrs") else None
    if debug:
        lines = _with_debug(lines, debug)
    if script:
        return "\n".join(line.rstrip() for line in lines)
    return "\n".join(lines)


def main(args, paths):
    args = _fix_json_code_ambiguity(args)
    if getattr(args, "list_targets", False):
        _list_targets(args)
        return
    file, target, asm = bench_code(getattr(args, "code", None))
    args.setup = bench_snippet(getattr(args, "setup", None), file, "--setup")
    args.teardown = bench_snippet(getattr(args, "teardown", None), file, "--teardown")
    if not file:
        if not str(asm or "").strip():
            raise SystemExit(_USAGE)
    elif not target_text(target).strip():
        raise SystemExit(
            "a symbol or region is required, e.g. `perf analyze a.out:fizz_buzz` or "
            "`perf analyze a.out:hot_begin..hot_end`"
        )
    try:
        if file is None:
            df = perf.analyze(
                asm=asm,
                name=getattr(args, "analyze_name", None),
                config=args.config,
                data=getattr(args, "data", None),
                event=getattr(args, "event", None),
                results=load_paths(paths) if paths else None,
                setup=getattr(args, "setup", None),
                teardown=getattr(args, "teardown", None),
                filter=getattr(args, "filter", None),
                debug=bool(getattr(args, "debug", False)),
            )
        else:
            df = perf.analyze(
                symbol=None if isinstance(target, (list, tuple)) else args.code,
                region=args.code if isinstance(target, (list, tuple)) else None,
                name=getattr(args, "analyze_name", None),
                config=args.config,
                data=getattr(args, "data", None),
                event=getattr(args, "event", None),
                results=load_paths(paths) if paths else None,
                setup=getattr(args, "setup", None),
                teardown=getattr(args, "teardown", None),
                filter=getattr(args, "filter", None),
                debug=bool(getattr(args, "debug", False)),
            )
    except Exception as ex:
        raise SystemExit(str(ex) or f"cannot analyze {file!r}")
    if want_json(args):
        emit_json_text(perf.to_json(df), json_path(args))
    else:
        print(format_analyze_table(df))
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf analyze",
        description="analyze a snippet/symbol/region per instruction (data after `--`)",
    )
    parser.add_argument(
        "code",
        nargs="?",
        default=None,
        help="what to analyze: `FILE:SYMBOL` for a symbol or a `begin..end` region of "
        "a binary (e.g. `a.out:fizz_buzz`, `a.out:hot_begin..hot_end`, "
        "`a.out:0x401000..0x401020`), `FILE:LABEL` for an assembly source (e.g. "
        "`a.s:label`, `a.s:foo..bar`), or a raw snippet with no file (e.g. "
        "`perf analyze 'mov eax, 42'`)",
    )
    parser.add_argument(
        "-n",
        "--name",
        dest="analyze_name",
        default=None,
        help="label of the result 'name' column (default: symbol or snippet)",
    )
    parser.add_argument(
        "--setup",
        dest="setup",
        default=None,
        help="run before each symbol instruction: `FILE:SYMBOL` of the analyzed file "
        "(e.g. `a.out:init`), or an asm snippet for a snippet symbol",
    )
    parser.add_argument(
        "--teardown",
        dest="teardown",
        default=None,
        help="run after each symbol instruction, same forms as `--setup`",
    )
    parser.add_argument(
        "-f",
        "--filter",
        dest="filter",
        default=None,
        help="pandas query filter for instructions, e.g. --filter 'size > 4' or "
        "--filter '4 in `data.rdi`'",
    )
    parser.add_argument(
        "--config",
        dest="config",
        default=None,
        help="config JSON file (merged over defaults, e.g. --config.stack.size=...); "
        "--config.* overrides win (e.g. --config.dcache=hot)",
    )
    parser.add_argument(
        "--data",
        dest="data",
        default=None,
        help="input data as a JSON string or path to a JSON file, kept separate "
        "from config; --data.* overrides win (e.g. --data.rdi=15, --data.arg0=15, "
        "--data[0x1000]=1)",
    )
    parser.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="columns to show, comma-separated or repeatable, with `*` expanding a "
        f"pattern (e.g. -e 'data*') (default: {','.join(DEFAULT_EVENTS)} plus all "
        "joined counters); every name given must exist in the result, so any "
        "column of it can be picked: the instruction's own "
        "(assembly,encoding,size,latency,throughput), the identity "
        "(file,name), the state (data.rdi, data.0x42000000000 or its --data form "
        "data[0x42000000000]), a joined counter per ip (cycles, from -- perf.data) "
        "or an expression over them (instructions/cycles)",
    )
    parser.add_argument(
        "-g",
        "--debug",
        dest="debug",
        action="store_true",
        help="show source code before each instruction "
        "(DWARF via angr, like perf annotate)",
    )
    parser.add_argument(
        "--list",
        dest="list_targets",
        action="store_true",
        help="list available symbols instead of analyzing: `perf analyze a.out "
        "--list` lists all, `perf analyze a.out:foo --list` filters by regex `foo`",
    )
    parser.add_argument(
        "--json",
        dest="json",
        nargs="?",
        const=True,
        default=False,
        metavar="FILE",
        help="emit the JSON envelope (one record per instruction) to stdout, or "
        "to FILE when a path is given (e.g. `--json out.json`); otherwise a "
        "result table is printed",
    )
    parser.add_argument("-i", "--interactive", action="store_true")
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _parsed = parse_target_args(_parser, apply_perfconfig(_parser, _options))
    main(_fix_json_code_ambiguity(_parsed), _paths)
