    apply_perfconfig as _data_apply,
)
from perf.mca import _DEFAULT_DEBUG_CONTEXT, _DEFAULT_EVENTS, _debug_context

arch = get_arch()

_COMMAND = "analyze"
_DOTTED_KEYS = ("config.", "data.")


def apply_perfconfig(parser, argv, config_path=None):
    return _data_apply(
        parser,
        argv,
        _COMMAND,
        config_path,
        dotted_keys=_DOTTED_KEYS,
    )


def _config_entries(path=None):
    return perfconfig_entries(_COMMAND, path)


def _known(parser, key):
    return _data_known(parser, key, _DOTTED_KEYS)


def _aliases(parser, key):
    return _data_aliases(parser, key, _DOTTED_KEYS)


_ANALYZE_CONFIG_KEYS = frozenset({*_VALID_TOP_KEYS, "debug_context"})
_USAGE = (
    "expected `perf analyze a.out:fizz_buzz`, `perf analyze a.out:hot_begin..hot_end`, "
    "`perf analyze a.s:label` or `perf analyze 'mov eax, 42'`"
)


def embed(ns):
    def help(_line=None):
        print("""
    df
    df.assembly
    df.groupby(["name", "mode"]).latency.describe()
    %notebook session.ipynb""")

    import sys

    if not getattr(sys.stdin, "isatty", lambda: False)():
        try:
            sys.stdin = open("/dev/tty")
        except Exception:
            pass

    from IPython.terminal.embed import InteractiveShellEmbed

    ipshell = InteractiveShellEmbed(user_ns=ns, display_banner=False)
    ipshell.editing_mode = "vi"
    ipshell.register_magic_function(help, magic_kind="line", magic_name="help")
    ipshell()


def bench_snippet(raw, file=None, what="setup"):
    if raw is None:
        return None
    values = raw if isinstance(raw, (list, tuple)) else [raw]
    names = []
    for value in values:
        other, target, asm = bench_code(value)
        if other is not None:
            if file is None:
                raise SystemExit(
                    f"{what} {value!r} names a file, but the analysis is a snippet"
                )
            if other != file:
                raise SystemExit(f"{what} {value!r} must be a symbol of {file!r}")
        name = target if target is not None else asm
        if name is not None:
            names.append(name)
    return names or None


def load_path(path, strict=True):
    try:
        is_record_file = is_record(path)
    except Exception:
        is_record_file = False
    if is_record_file:
        return parse([path])
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError as ex:
        if not strict:
            return None
        raise SystemExit(f"cannot read {path!r}: {ex}")
    try:
        payload = loads_json(text)
    except ValueError:
        payload = None
    if isinstance(payload, dict) and isinstance(payload.get("output"), list):
        return merge_envelope_data(payload, envelope_frame(payload))
    if str(text).lstrip()[:1] in ("{", "["):
        frame = json_frame(payload)
        if frame is not None and not frame.empty:
            return frame
        if not strict:
            return None
        raise SystemExit(
            f"invalid envelope JSON in {path!r}: missing 'output' "
            "(expected a perf envelope or a result table)"
        )
    try:
        df = table_to_df(text)
    except ValueError as ex:
        if not strict:
            return None
        raise SystemExit(f"cannot read {path!r} as a perf result table: {ex}")
    if df is None or df.empty:
        if not strict:
            return None
        raise SystemExit(f"no data rows in {path!r}")
    return df


def load_paths(paths):
    frames = []
    for path in paths:
        files = _read_result_paths([path])
        if not files:
            raise SystemExit(f"no data files found in {[str(path)]!r}")
        for f, explicit in files:
            frame = load_path(f, strict=explicit)
            if frame is None:
                print(
                    f"skipping {f}: not a perf envelope or result table",
                    file=sys.stderr,
                )
                continue
            frames.append(frame)
    if not frames:
        raise SystemExit(f"no readable data in {[str(p) for p in paths]!r}")
    return frames


def parse_target_args(parser, argv):
    args, unknown = parser.parse_known_args(argv)
    config = copy.deepcopy(_DEFAULT_BENCH)
    explicit = set()

    def _cli_value(value):
        try:
            return parse_value(value)
        except ValueError as ex:
            parser.error(str(ex))

    def _store_mem_range(base_str, value, rest_hint=""):
        try:
            entries = list(_mem_entries(base_str, value))
        except ValueError as ex:
            parser.error(str(ex))
            return
        if not entries:
            parser.error(f"unknown data key: --data{rest_hint or base_str}")
            return
        for k, v in entries:
            data["mem"][k] = v

    def _apply_data_override(rest, value):
        bracket = rest.find("[")
        if bracket != -1 and rest.endswith("]"):
            ns = rest[:bracket]
            inner = rest[bracket + 1 : -1]
            if ns:
                parser.error(
                    f"unknown data key: --data{rest} "
                    "(use --data.rdi=.., --data.0x1000=.., --data[0x1000]=..)"
                )
                return
            if _is_mem_addr_key(inner):
                _store_mem_range(inner, value, rest)
            else:
                data["regs"][_canonical_data_reg_key(inner)] = value
            return
        if "." in rest:
            parser.error(
                f"unknown data key: --data.{rest} "
                "(use --data.rdi=.., --data.0x1000=.., --data[0x1000]=..)"
            )
            return
        if _is_mem_addr_key(rest):
            _store_mem_range(rest, value, rest)
            return
        data["regs"][_canonical_data_reg_key(rest)] = value

    def _expand_intermediate(top, cur):
        if top in _CACHE_KEYS:
            if isinstance(cur, (int, float)) and not isinstance(cur, bool):
                return {"hit_rate": int(cur)}
            if isinstance(cur, str):
                table = (
                    arch._MEMORY_SHORTCUTS if top == "dcache" else arch._TIER_SHORTCUTS
                )
                shortcut = table.get(cur.strip().lower())
                if shortcut is None:
                    parser.error(
                        f"unknown cache shortcut {cur!r}; expected one of "
                        "'hot', 'warm', 'cool', 'cold'"
                    )
                if top == "dcache":
                    return {
                        ("L1" if tier == "L1d" else tier): rate
                        for tier, rate in shortcut.items()
                    }
                tier = {"icache": "L1i", "dtlb": "TLBd", "itlb": "TLBi"}[top]
                return {"hit_rate": shortcut[tier]}
        if top == "branch" and isinstance(cur, (str, bool)):
            if isinstance(cur, bool):
                prediction = "predictable" if cur else "unpredictable"
            else:
                prediction = _branch_value(cur)
                if prediction is None:
                    parser.error(
                        "branch prediction must be one of "
                        f"{', '.join(_BRANCH_CHOICES)}, got {cur!r}"
                    )
            return {"prediction": prediction}
        return {}

    def _container_alternatives(key):
        entries = normalize_container(key, config.get(key))
        if not isinstance(entries, list):
            entries = [entries]
        return [
            copy.deepcopy(entry)
            if isinstance(entry, dict)
            else {"value": copy.deepcopy(entry)}
            for entry in entries
        ] or [{}]

    def _base_alternative(top, current):
        if isinstance(current, dict):
            return copy.deepcopy(current)
        if isinstance(current, (str, bool, int, float)):
            return dict(_expand_intermediate(top, current))
        return {}

    def _rate_dict(value):
        if isinstance(value, dict):
            return dict(value)
        if isinstance(value, (int, float)) and not isinstance(value, bool):
            return {"hit_rate": int(value)}
        return {}

    def _address_alternative(top, parts, current, addr, value):
        base = _base_alternative(top, current)
        if top == "branch" and len(parts) == 2:
            nest = base.get(parts[1])
            nest = dict(nest) if isinstance(nest, dict) else {}
            nest[addr] = value
            base[parts[1]] = nest
            return base
        if top == "dcache" and len(parts) == 2:
            inner = _rate_dict(base.get(parts[-1]))
            inner[addr] = value
            base[parts[-1]] = inner
            return base
        base[addr] = value
        return base

    def _apply_container_sweep(parts, value):
        key, leaf, path = parts[0], parts[-1], parts[1:-1]
        out = []
        seen = set()
        for base in _container_alternatives(key):
            node = base
            for part in path:
                nxt = node.get(part)
                if not isinstance(nxt, dict):
                    nxt = {}
                    node[part] = nxt
                node = nxt
            node.pop(leaf, None)
            signature = _stable(base)
            if signature in seen:
                continue
            seen.add(signature)
            for item in value:
                concrete = copy.deepcopy(base)
                target = concrete
                for part in path:
                    target = target[part]
                target[leaf] = item
                out.append(concrete)
        config[key] = out

    def _pin_container(key):
        cur = config.get(key)
        if not isinstance(cur, list):
            return cur if isinstance(cur, dict) else {}
        first = cur[0] if cur else None
        while isinstance(first, list) and first:
            first = first[0]
        entry = dict(first) if isinstance(first, dict) else {}
        config[key] = [[entry]] if key == "thread" else [entry]
        return entry

    def _check_top(top):
        if top not in _ANALYZE_CONFIG_KEYS:
            parser.error(
                f"unknown argument: --config.{top} "
                f"(expected one of {', '.join(sorted(_ANALYZE_CONFIG_KEYS))})"
            )

    def _check_nested(top, leaf, parts=()):
        expected = {
            "thread": ("affinity", "priority", "numa"),
            "func": ("align", "order"),
            "code": ("align",),
            "stack": ("size", "align", "mode"),
            "heap": ("size", "mode"),
            "iterations": ("min", "max"),
            "external": ("lib", "stdout", "stderr"),
        }.get(top)
        if expected is not None and leaf not in expected:
            parser.error(
                f"unknown argument: --config.{top}.{leaf} "
                f"(expected {', '.join(repr(e) for e in expected)})"
            )
        if top == "backend":
            name = leaf
            if name not in _BACKENDS:
                parser.error(
                    f"unknown argument: --config.backend.{name} (expected "
                    f"{' or '.join(_BACKENDS)}, or one of "
                    f"{', '.join(sorted(_BACKEND_OPTION_KEYS))})"
                )
            if len(parts) >= 3 and parts[2] not in _BACKEND_OPTION_KEYS:
                parser.error(
                    f"unknown argument: --config.backend.{name}.{parts[2]} "
                    f"(expected one of {', '.join(sorted(_BACKEND_OPTION_KEYS))})"
                )
            if len(parts) > 3:
                parser.error(f"unknown argument: --config.{'.'.join(parts)}")

    def _apply_config_override(rest, value):
        bracket = rest.find("[")
        if bracket != -1 and rest.endswith("]"):
            key = rest[:bracket]
            addr = rest[bracket + 1 : -1]
            parts = [p for p in key.split(".") if p]
            if not parts:
                parser.error(f"unknown argument: --config.{rest}")
            _check_top(parts[0])
            explicit.add(parts[0])
            if len(parts) >= 2:
                _check_nested(parts[0], parts[1], parts)
            top = parts[0]
            if top not in ("branch",) + _CACHE_KEYS:
                parser.error(
                    f"per-address overrides --config.{rest} are only supported "
                    "for branch and the cache/tlb keys "
                    "(e.g. --config.dcache.L1[0x1000]=hot)"
                )
            if top == "branch":
                if len(parts) > 2:
                    parser.error(f"unknown argument: --config.{rest}")
                if len(parts) == 2 and parts[1] not in ("mem", "regs"):
                    parser.error(
                        f"unknown argument: --config.branch.{parts[1]} "
                        "(expected 'mem' or 'regs')"
                    )
            elif top == "dcache":
                if len(parts) > 2:
                    parser.error(f"unknown argument: --config.{rest}")
                if len(parts) == 2 and parts[1] not in ("L1", "L2", "L3"):
                    parser.error(
                        f"unknown argument: --config.dcache.{parts[1]} "
                        "(expected 'L1', 'L2' or 'L3')"
                    )
            elif len(parts) > 1:
                parser.error(f"unknown argument: --config.{rest}")
            current = config.get(top)
            alternatives = current if isinstance(current, list) else [current]
            out = [
                _address_alternative(top, parts, alt, addr, value)
                for alt in alternatives
            ]
            config[top] = out if isinstance(current, list) else (out[0] if out else {})
            return
        parts = [p for p in rest.split(".") if p]
        if not parts:
            parser.error(f"unknown argument: --config.{rest}")
        _check_top(parts[0])
        explicit.add(parts[0])
        if len(parts) >= 2:
            _check_nested(parts[0], parts[1], parts)
        if parts[0] in (*_LIST_TOPS, "thread"):
            if len(parts) == 1:
                config[parts[0]] = normalize_container(parts[0], value)
                return
            if isinstance(value, list) and parts[0] in (
                "code",
                "stack",
                "heap",
                "func",
            ):
                _apply_container_sweep(parts, value)
                return
            node = _pin_container(parts[0])
            for p in parts[1:-1]:
                nxt = node.get(p)
                if not isinstance(nxt, dict):
                    nxt = {}
                    node[p] = nxt
                node = nxt
            node[parts[-1]] = value
            return
        node = config
        for p in parts[:-1]:
            nxt = node.get(p)
            if not isinstance(nxt, dict):
                nxt = {} if nxt is None else _expand_intermediate(parts[0], nxt)
                node[p] = nxt
            node = nxt
        if (
            parts[0] == "dcache"
            and len(parts) == 2
            and parts[-1] == "hit_rate"
            and isinstance(node, dict)
        ):
            for tier in ("L1", "L2", "L3"):
                node.pop(tier, None)
        node[parts[-1]] = value

    data = {"regs": {}, "mem": {}}
    if getattr(args, "config", None):
        try:
            with open(args.config) as f:
                loaded = loads_json(f.read())
        except OSError as ex:
            parser.error(f"cannot read --config {args.config!r}: {ex}")
        except ValueError as ex:
            parser.error(f"invalid JSON in --config {args.config!r}: {ex}")
        if not isinstance(loaded, dict):
            parser.error("config file must contain a JSON object")
        if "data" in loaded:
            parser.error(
                "config file must not contain 'data'; use --data instead (e.g. "
                "--data.rdi=15 or --data '{\"rdi\": 15}')"
            )
        explicit.update(loaded.keys())
        merged = _deep_merge(config, loaded)
        if _backend_mode_map(loaded.get("backend")):
            merged["backend"] = copy.deepcopy(loaded["backend"])
        config = _normalize_spec(merged)

    for arg in unknown:
        if "=" not in arg:
            parser.error(f"unknown argument: {arg}")
        if arg.startswith("--data["):
            key, value = arg[len("--data") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_data_override(key, _cli_value(value))
            continue
        if arg.startswith("--data."):
            key, value = arg[len("--data.") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_data_override(key, _cli_value(value))
            continue
        if arg.startswith("--config."):
            key, value = arg[len("--config.") :].split("=", 1)
            if not key:
                parser.error(f"unknown argument: {arg}")
            _apply_config_override(key, _cli_value(value))
            continue
        parser.error(f"unknown argument: {arg}")

    flag_data = None
    if getattr(args, "data", None):
        raw_data = args.data
        if os.path.isfile(raw_data):
            try:
                with open(raw_data) as f:
                    flag_data = loads_json(f.read())
            except OSError as ex:
                parser.error(f"cannot read --data {raw_data!r}: {ex}")
            except ValueError as ex:
                parser.error(f"invalid --data JSON in {raw_data!r}: {ex}")
        else:
            try:
                flag_data = loads_json(raw_data)
            except ValueError as ex:
                parser.error(f"invalid --data JSON: {ex}")
    try:
        debug_context = _debug_context(config.pop("debug_context", None))
        validate_spec(config)
    except ValueError as ex:
        parser.error(str(ex))
    args.config = config
    args.config_explicit = tuple(sorted(explicit))
    args.debug_context = debug_context
    has_data = bool((data.get("regs") or data.get("mem")) or flag_data)
    try:
        args.data = _merge_data(flag_data, data) if has_data else None
    except ValueError as ex:
        parser.error(str(ex))
    return args


def format_analyze_table(df):
    out = df.copy()
    if out.empty:
        return str(out)
    for column in out.columns:
        if _is_state_col(column):
            out[column] = _format_state(out[column].tolist())
    table = perf.info.hex_addresses(format_table(out), columns=("address",))
    table = table.astype(str)
    lines = _fixed_width_table(table)
    script = _is_asm_script(table) and lines and lines[0].split() == ["assembly"]
    if script:
        lines[0] = arch.asm_syntax()
    attrs = getattr(df, "attrs", {}) if hasattr(df, "attrs") else {}
    debug = attrs.get("debug")
    decompile = attrs.get("decompile") or attrs.get("decompiled")
    sources = {}
    if decompile:
        source = attrs.get("decompile_source")
        if source is None and debug:
            try:
                source = debug[0][0] if debug[0] is not None else None
            except Exception:
                source = None
        if source:
            sources[str(source)] = str(decompile).splitlines()
        if (
            source
            and debug
            and len(lines) - 1 == len(debug)
            and any(entry is not None for entry in debug)
        ):
            context = max(
                attrs.get("debug_context", _DEFAULT_DEBUG_CONTEXT),
                len(sources[str(source)]),
            )
            lines = _with_debug(
                lines,
                debug,
                context=context,
                sources=sources,
                complete=True,
            )
        else:
            lines = [lines[0], *str(decompile).splitlines(), *lines[1:]]
    elif debug:
        context = attrs.get("debug_context", _DEFAULT_DEBUG_CONTEXT)
        lines = _with_debug(lines, debug, context=context)
    if script:
        return "\n".join(line.rstrip() for line in lines)
    return "\n".join(lines)


def main(args, paths):
    args = _fix_output_code_ambiguity(args)
    if getattr(args, "list_targets", False):
        _list_targets(args)
        return
    file, target, asm = bench_code(getattr(args, "code", None))
    args.setup = bench_snippet(getattr(args, "setup", None), file, "--setup")
    args.teardown = bench_snippet(getattr(args, "teardown", None), file, "--teardown")
    if not file:
        if not str(asm or "").strip():
            raise SystemExit(_USAGE)
    elif not target_text(target).strip():
        raise SystemExit(
            "a symbol or region is required, e.g. `perf analyze a.out:fizz_buzz` or "
            "`perf analyze a.out:hot_begin..hot_end`"
        )
    try:
        df = perf.analyze(
            target=getattr(args, "code", None),
            name=getattr(args, "analyze_name", None),
            config=args.config,
            data=getattr(args, "data", None),
            event=getattr(args, "event", None),
            args=load_paths(paths) if paths else None,
            setup=getattr(args, "setup", None),
            teardown=getattr(args, "teardown", None),
            filter=getattr(args, "filter", None),
            debug=bool(getattr(args, "debug", False)),
            decompile=bool(getattr(args, "decompile", False)),
        )
    except Exception as ex:
        raise SystemExit(str(ex) or f"cannot analyze {file!r}")
    df.attrs["debug_context"] = getattr(args, "debug_context", _DEFAULT_DEBUG_CONTEXT)
    if has_output(getattr(args, "output", None)):
        payload = _record_envelope(df)
        emit_output(
            args.output,
            payload,
            values=metadata(payload, command="analyze"),
            template=getattr(args, "_output_template", None),
        )
    if show_table(
        getattr(args, "output", None),
        bool(getattr(args, "_output_from_config", False)),
    ):
        print(format_analyze_table(df))
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def _list_targets(args):
    code = getattr(args, "code", None)
    file, target, asm = bench_code(code)
    if not file:
        raw = "" if code is None else str(code).strip()
        if raw and not (asm or "").strip():
            file = raw.partition(":")[0].strip() or None
        if not file:
            if (asm or "").strip():
                raise SystemExit(
                    "--list needs a file, e.g. `perf analyze a.out --list`; "
                    "snippets have no symbols to list"
                )
            raise SystemExit(
                "a file is required, e.g. `perf analyze a.out --list` or "
                "`perf analyze a.out:func --list`"
            )
    if _is_asm_source_file(file):
        if not Path(file).exists():
            raise SystemExit(f"file {file!r} does not exist")
        try:
            labels = perf.info.asm_labels(file)
        except FileNotFoundError:
            raise SystemExit(f"file {file!r} does not exist")
        except Exception as ex:
            raise SystemExit(str(ex).splitlines()[0] or f"cannot inspect {file!r}")
        df = pd.DataFrame(
            [{"name": n, "position": p, "size": s} for n, p, s in labels],
            columns=["name", "position", "size"],
        )
        df = _filter_list_df(df, _list_patterns(target))
        df = _resolve_list_columns(df, getattr(args, "event", None))
        if has_output(getattr(args, "output", None)):
            emit_output(
                args.output,
                df.to_dict(orient="records"),
                values=metadata_from_frame(df, command="analyze"),
                template=getattr(args, "_output_template", None),
            )
        if show_table(
            getattr(args, "output", None),
            bool(getattr(args, "_output_from_config", False)),
        ):
            print(_format_list_table(df))
    else:
        if not Path(file).exists():
            raise SystemExit(f"file {file!r} does not exist")
        try:
            df = perf.info.metadata(file)
        except FileNotFoundError:
            raise SystemExit(f"file {file!r} does not exist")
        except SystemExit:
            raise
        except Exception as ex:
            raise SystemExit(str(ex).splitlines()[0] or f"cannot inspect {file!r}")
        df = _filter_list_df(df, _list_patterns(target))
        df = _resolve_list_columns(df, getattr(args, "event", None))
        if has_output(getattr(args, "output", None)):
            emit_output(
                args.output,
                df.to_dict(orient="records"),
                values=metadata_from_frame(df, command="analyze"),
                template=getattr(args, "_output_template", None),
            )
        if show_table(
            getattr(args, "output", None),
            bool(getattr(args, "_output_from_config", False)),
        ):
            print(_format_list_table(perf.info.hex_addresses(df)))
    if getattr(args, "interactive", False):
        embed({"perf": perf, "df": df})


def _is_state_col(column):
    name = str(column)
    return name.startswith(("data.", "data[", "mem-"))


def _format_state(values):
    out = []
    for value in values:
        if value is None or (isinstance(value, float) and pd.isna(value)):
            out.append("")
            continue
        items = value if isinstance(value, (list, tuple)) else [value]
        cells = []
        for item in items:
            try:
                cells.append(str(int(item)) if float(item).is_integer() else str(item))
            except (TypeError, ValueError):
                cells.append(str(item))
        out.append(f"[{', '.join(cells)}]")
    return out


def _is_asm_script(table):
    return list(table.columns) == ["assembly"]


def _debug_source_lines(path, cache):
    lines = cache.get(path)
    if lines is None:
        try:
            with open(path, encoding="utf-8", errors="ignore") as fh:
                lines = fh.read().splitlines()
        except Exception:
            lines = []
        cache[path] = lines
    return lines or []


def _debug_code(path, num, cache, fallback="", sources=None):
    if fallback:
        return str(fallback).rstrip()
    try:
        at = int(num)
    except Exception:
        return ""
    if at <= 0:
        return ""
    lines = (sources or {}).get(path)
    if lines is None:
        lines = _debug_source_lines(path, cache)
    try:
        return str(lines[at - 1]).rstrip()
    except Exception:
        return ""


def _emit_debug(out, text):
    if text is None:
        return
    if str(text).strip():
        out.append(str(text).rstrip())


def _with_debug(
    lines, debug, context=_DEFAULT_DEBUG_CONTEXT, sources=None, complete=False
):
    if not lines or not debug or len(lines) - 1 != len(debug):
        return lines
    out = [lines[0]]
    cache = {}
    shown_max = {}
    prev = None
    for row, entry in zip(lines[1:], debug):
        if entry is not None:
            try:
                src, num, code = entry
                src = str(src)
                num = int(num)
            except Exception:
                prev = None
                out.append(row)
                continue
            key = (src, num)
            if key != prev:
                current = _debug_code(src, num, cache, code, sources)
                top = shown_max.get(src)
                if top is None:
                    try:
                        start = max(1, num - int(context))
                    except Exception:
                        start = num
                    for missing in range(start, num):
                        _emit_debug(out, _debug_code(src, missing, cache, "", sources))
                    _emit_debug(out, current)
                    shown_max[src] = num
                elif num > top + 1:
                    for missing in range(top + 1, num):
                        _emit_debug(out, _debug_code(src, missing, cache, "", sources))
                    _emit_debug(out, current)
                    shown_max[src] = num
                elif num > top:
                    _emit_debug(out, current)
                    shown_max[src] = num
                else:
                    _emit_debug(out, current)
                prev = key
        else:
            prev = None
        out.append(row)
    if complete:
        for src, top in shown_max.items():
            lines_in = (sources or {}).get(src)
            if lines_in is None:
                lines_in = _debug_source_lines(src, cache)
            for missing in range(top + 1, len(lines_in) + 1):
                _emit_debug(out, _debug_code(src, missing, cache, "", sources))
    return out


def _fixed_width_table(df):
    columns = list(df.columns)
    try:
        rows = [[_list_cell(v) for v in df[c].tolist()] for c in columns]
    except Exception:
        return [str(df)]
    widths = [
        max([len(str(c))] + [len(values[i]) for i in range(len(df))])
        for c, values in zip(columns, rows)
    ]
    lines = [
        " ".join(str(c).ljust(width) for c, width in zip(columns, widths)).rstrip()
    ]
    for i in range(len(df)):
        lines.append(
            " ".join(
                values[i].ljust(width) for values, width in zip(rows, widths)
            ).rstrip()
        )
    return lines


def _build_parser():
    parser = argparse.ArgumentParser(
        prog="perf analyze",
        description="analyze a snippet/symbol/region per instruction (data after `--`)",
    )
    parser.add_argument(
        "code",
        nargs="?",
        default=None,
        help="what to analyze: `FILE:SYMBOL` for a symbol or a `begin..end` region of "
        "a binary (e.g. `a.out:fizz_buzz`, `a.out:hot_begin..hot_end`, "
        "`a.out:0x401000..0x401020`), `FILE:LABEL` for an assembly source (e.g. "
        "`a.s:label`, `a.s:foo..bar`), or a raw snippet with no file (e.g. "
        "`perf analyze 'mov eax, 42'`)",
    )
    parser.add_argument(
        "-n",
        "--name",
        dest="analyze_name",
        default=None,
        help="label of the result 'name' column (default: symbol or snippet)",
    )
    parser.add_argument(
        "--setup",
        dest="setup",
        default=None,
        help="run before the symbol during exploration: `FILE:SYMBOL` of the "
        "analyzed file (e.g. `a.out:init`), or an asm snippet for a snippet symbol",
    )
    parser.add_argument(
        "--teardown",
        dest="teardown",
        default=None,
        help="run after the symbol during exploration, same forms as `--setup`",
    )
    parser.add_argument(
        "-f",
        "--filter",
        dest="filter",
        default=None,
        help="pandas query filter for instructions, e.g. --filter 'size > 4' or "
        "--filter '4 in `data.rdi`'",
    )
    parser.add_argument(
        "--config",
        dest="config",
        default=None,
        help="config JSON file (merged over defaults, e.g. --config.stack.size=...); "
        "--config.* overrides win (e.g. --config.dcache=hot)",
    )
    parser.add_argument(
        "--data",
        dest="data",
        default=None,
        help="input data as a JSON string or path to a JSON file, kept separate "
        "from config; --data.* overrides win (e.g. --data.rdi=15, --data.arg0=15, "
        "--data[0x1000]=1)",
    )
    parser.add_argument(
        "-e",
        "--event",
        dest="event",
        action="append",
        default=None,
        help="columns to show, comma-separated or repeatable, with `*` expanding a "
        f"pattern (e.g. -e 'data*') (default: {','.join(_DEFAULT_EVENTS)} plus all "
        "joined counters); every name given must exist in the result, so any "
        "column of it can be picked: the instruction's own "
        "(assembly,encoding,size,latency,throughput), the identity "
        "(file,name), the state (data.rdi, data.0x42000000000 or its --data form "
        "data[0x42000000000]), a joined counter per ip (cycles, from -- perf.data) "
        "or an expression over them (instructions/cycles)",
    )
    parser.add_argument(
        "-g",
        "--debug",
        dest="debug",
        action="store_true",
        help="show source code before each instruction "
        "(DWARF via angr, like perf annotate)",
    )
    parser.add_argument(
        "-d",
        "--decompile",
        dest="decompile",
        action="store_true",
        help="show decompiled pseudocode before each instruction "
        "(angr; binary targets)",
    )
    parser.add_argument(
        "--list",
        dest="list_targets",
        action="store_true",
        help="list available symbols instead of analyzing: `perf analyze a.out "
        "--list` lists all, `perf analyze a.out:foo --list` filters by regex `foo`",
    )
    parser.add_argument(
        "-o",
        "--output",
        dest="output",
        action="append",
        nargs="?",
        const=True,
        default=None,
        metavar="FILE",
        help="write the JSON envelope (one record per instruction) to FILE, or to "
        "stdout when no FILE is given; repeat --output to write several "
        "destinations; a directory (or a path ending in /) uses the output "
        "template (default {time}-{command}-{target}-{id}.json, override in "
        ".perfconfig)",
    )
    parser.add_argument("-i", "--interactive", action="store_true")
    return parser


if __name__ == "__main__":
    _parser = _build_parser()
    _options, _paths = split_after_dashes(sys.argv[1:])
    _parsed = parse_target_args(_parser, apply_perfconfig(_parser, _options))
    main(_fix_output_code_ambiguity(_parsed), _paths)
