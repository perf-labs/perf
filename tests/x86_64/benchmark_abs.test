# Real libc abs measured with a concrete input: rdi is the integer value.
# abs is the measured name and data.rdi the input column.
# REQUIRES: x86_64, system-libc
# RUN: perf benchmark /lib/x86_64-linux-gnu/libc.so.6:abs -m latency -e duration_time --data.rdi=5 --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: data.rdi
# CHECK: iterations samples operations threads duration_time
# CHECK-NEXT: abs latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal 5.00 10 0 1 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
