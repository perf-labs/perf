# Register state prints as a value list, never a float: [15] is the
# data.rdi column and 15.00 must not appear.
# REQUIRES: x86_64
# RUN: perf analyze 'mov rax, rdi; add rax, 1; ret' --data.rdi=15 -e assembly,data.rdi 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly data.rdi
# CHECK-NEXT: mov rax, rdi [15]
# CHECK: add rax, 1 [15]
# CHECK: ret [15]
# CHECK-NOT: 15.00
# CHECK-NOT: Traceback
