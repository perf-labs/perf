# REQUIRES: x86_64
# RUN: perf analyze 'paddq xmm0, xmm1; ptest xmm0, xmm1' -e assembly,latency,throughput > %t.log 2> %t.err
# RUN: perf analyze 'movdqa xmm0, xmm1; movdqu xmm0, xmm1' -e assembly,latency,throughput >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: paddq xmm0, xmm1 1.00 0.33
# CHECK-NEXT: ptest xmm0, xmm1 4.00 1.00
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: movdqa xmm0, xmm1 1.00 0.20
# CHECK-NEXT: movdqu xmm0, xmm1 1.00 0.20
# CHECK-NOT: Traceback
