# A C branch measured with concrete inputs: rdi pins the taken direction.
# data.rdi is the input column and predictable the branch column for the run.
# REQUIRES: x86_64, gcc
# RUN: gcc -O2 -fPIE -pie -o %t %S/benchmark_c_branch.c && perf benchmark %t:branchy -m latency -e duration_time --data.rdi=1 --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: data.rdi
# CHECK: operations duration_time
# CHECK-NEXT: branchy latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal 1.00 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
