# REQUIRES: x86_64
# RUN: perf analyze 'vxorps xmm0, xmm0, xmm1; vpor xmm0, xmm0, xmm1; vpxor xmm0, xmm0, xmm1; vpshufd xmm0, xmm1, 0' -e assembly,latency,throughput 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: vxorps xmm0, xmm0, xmm1 1.00 0.20
# CHECK-NEXT: vpor xmm0, xmm0, xmm1 1.00 0.33
# CHECK-NEXT: vpxor xmm0, xmm0, xmm1 1.00 0.33
# CHECK-NEXT: vpshufd xmm0, xmm1, 0 1.00 1.00
# CHECK-NOT: Traceback
