# REQUIRES: x86_64, gcc
# RUN: gcc -O2 -fPIE -pie -fcf-protection=full -o %t %S/benchmark_entry.c && perf benchmark %t:main -m latency -e duration_time --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 > %t.log 2> %t.err
# RUN: perf analyze %t:main -e index,assembly >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: data.rdi
# CHECK: operations duration_time
# CHECK-NEXT: main latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal
# CHECK: 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: index assembly
# CHECK-NEXT: endbr64
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
