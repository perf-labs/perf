# Loop backend measures one call per iteration: config.backend.loop columns appear.
# duration_time is the measured event; loop probes/runs/target are the backend columns.
# REQUIRES: x86_64
# RUN: perf benchmark 'mov eax, 42' -m latency -e duration_time --backend loop --config.backend.loop.runs=20 --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: iterations samples operations threads duration_time
# CHECK-NEXT: mov eax, 42 latency 3.00 20.00
# CHECK: predictable 16.00 hot hot
# CHECK: normal 10 0 1 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
