# REQUIRES: x86_64, gcc
# RUN: gcc -shared -fPIC -o %t.lib.so %S/profile_errors_lib.c
# RUN: not perf profile > %t.log 2> %t.err
# RUN: not perf profile --buffer-size 0 -- /bin/true >> %t.log 2>> %t.err
# RUN: not perf profile --buffer-size bogus -- /bin/true >> %t.log 2>> %t.err
# RUN: not perf profile -f nomatch -- /bin/true >> %t.log 2>> %t.err
# RUN: not perf profile -- /bin/true >> %t.log 2>> %t.err
# RUN: not perf profile -f main -- %t.lib.so >> %t.log 2>> %t.err
# RUN: not perf profile --list >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: needs a command
# CHECK-NOT: Traceback
# CHECK: --buffer-size must be > 0
# CHECK-NOT: Traceback
# CHECK: invalid int value: 'bogus'
# CHECK-NOT: Traceback
# CHECK: no track points left after applying --filter
# CHECK-NOT: Traceback
# CHECK: requires --filter
# CHECK-NOT: Traceback
# CHECK: shared library
# CHECK-NOT: Traceback
# CHECK: needs a command
# CHECK-NOT: Traceback
