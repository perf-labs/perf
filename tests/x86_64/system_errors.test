# CLI usage and validation errors: unknown columns, removed flags, and a
# missing file fail with a one-line message and never a traceback.
# REQUIRES: x86_64
# RUN: not perf system info --cpu -e nope > %t.log 2> %t.err
# RUN: not perf system info --cpu -e 'zzz*' >> %t.log 2>> %t.err
# RUN: not perf system info --cpu --column cpu >> %t.log 2>> %t.err
# RUN: not perf benchmark /nope/x --list >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: unknown columns: nope
# CHECK-NOT: Traceback
# CHECK: unknown columns: zzz*
# CHECK-NOT: Traceback
# CHECK: unknown argument: --column
# CHECK-NOT: Traceback
# CHECK: file '/nope/x' does not exist
# CHECK-NOT: Traceback
