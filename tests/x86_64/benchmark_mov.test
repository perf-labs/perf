# Measuring a snippet reports one latency row with a duration_time counter.
# duration_time is the measured event column; latency/mode/iterations/samples
# are the stable harness identity columns around it.
# REQUIRES: x86_64
# RUN: perf benchmark 'mov eax, 42' -m latency -e duration_time --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.unroll.count
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: iterations samples operations threads duration_time
# CHECK-NEXT: mov eax, 42 latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal 10 0 1 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
