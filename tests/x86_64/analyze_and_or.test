# and/or run on the same ALU ports as add: 1 cycle latency, 0.20 throughput.
# The 1.00 below is the latency column and the 0.20 is the throughput column.
# REQUIRES: x86_64
# RUN: perf analyze 'and eax, 1' -e assembly,latency,throughput > %t.log 2> %t.err
# RUN: perf analyze 'or eax, 1' -e assembly,latency,throughput >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: and eax, 1 1.00 0.20
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: or eax, 1 1.00 0.20
# CHECK-NOT: Traceback
