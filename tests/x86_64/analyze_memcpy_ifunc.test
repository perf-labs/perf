# REQUIRES: x86_64, system-libc
# RUN: perf analyze /lib/x86_64-linux-gnu/libc.so.6:memcpy -e index,assembly,latency 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: index assembly latency
# CHECK-NEXT: endbr64
# CHECK: mov {{r[a-z0-9]+}}, qword ptr [rip
# CHECK: lea {{r[a-z0-9]+}}, [rip
# CHECK: ret 0.00
# CHECK-NOT: Traceback
