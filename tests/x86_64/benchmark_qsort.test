# Real libc qsort entry measured on an empty call: the entry block runs alone.
# qsort is the measured name and duration_time the measured event.
# REQUIRES: x86_64, system-libc
# RUN: perf benchmark /lib/x86_64-linux-gnu/libc.so.6:qsort -m latency -e duration_time --data.rdi=0 --data.rsi=0 --data.rdx=0 --data.rcx=0 --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: data.rdi
# CHECK: iterations samples operations threads duration_time
# CHECK-NEXT: qsort latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal 0.00 0.00 0.00 0.00 10 0 1 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
