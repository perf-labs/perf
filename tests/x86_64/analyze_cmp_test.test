# REQUIRES: x86_64
# RUN: perf analyze 'cmp eax, 1' -e assembly,latency,throughput > %t.log 2> %t.err
# RUN: perf analyze 'test eax, eax' -e assembly,latency,throughput >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: cmp eax, 1 1.00 0.20
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: test eax, eax 1.00 0.20
# CHECK-NOT: Traceback
