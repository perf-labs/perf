# RUN: perf benchmark %t:hot -m latency -e duration_time --config.samples=1 --config.iterations=4 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 --config.func.order=random --config.seed=12 >> %t.log 2>> %t.err
