# JSON envelope carries one record per instruction with its latency model.
# assembly is the instruction column and latency the model column in the record.
# REQUIRES: x86_64
# RUN: perf analyze 'add eax, 1' -e assembly,latency --json > %t.log 2> %t.err
# RUN: perf analyze 'mov eax, 42' -e assembly,latency -n custom --json >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: "assembly": "add eax, 1"
# CHECK: "latency": 1.0
# CHECK-NOT: Traceback
# CHECK: "name": "custom-{{[0-9a-f]+}}"
# CHECK: "assembly": "mov eax, 0x2a"
# CHECK-NOT: Traceback
