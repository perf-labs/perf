# REQUIRES: x86_64
# RUN: perf system tune --dry-run > %t.performance.out 2> %t.performance.err
# RUN: %FileCheck %s --check-prefix=PERFORMANCE < %t.performance.out
# RUN: perf system tune --dry-run --profile=performance --json > %t.performance.json 2> %t.performance_json.err
# RUN: %FileCheck %s --check-prefix=PERFORMANCE-JSON < %t.performance.json
# RUN: perf system tune --dry-run --profile=latency > %t.latency.out 2> %t.latency.err
# RUN: %FileCheck %s --check-prefix=LATENCY < %t.latency.out
# RUN: perf system tune --dry-run --profile=latency --profile.aslr=true --profile.smt=true --json > %t.override.out 2> %t.override.err
# RUN: %FileCheck %s --check-prefix=OVERRIDE < %t.override.out
# RUN: echo '{"aslr": true}' > %t.json
# RUN: perf system tune --dry-run --profile=%t.json --json > %t.file.out 2> %t.file.err
# RUN: %FileCheck %s --check-prefix=FILE < %t.file.out
# RUN: perf system tune --dry-run --profile=throughput --json > %t.throughput.out 2> %t.throughput.err
# RUN: %FileCheck %s --check-prefix=THROUGHPUT < %t.throughput.out
# RUN: perf system tune --reset --dry-run --json > %t.reset.out 2> %t.reset.err
# RUN: %FileCheck %s --check-prefix=RESET < %t.reset.out
# RUN: not perf system tune --dry-run --profile=nope > %t.nope.out 2> %t.nope.err
# RUN: not perf system tune --profile=default > %t.default.out 2> %t.default.err
# RUN: cat %t.performance.err %t.performance_json.err %t.latency.err %t.override.err %t.file.err %t.throughput.err %t.nope.err %t.reset.err %t.default.err | %FileCheck %s --check-prefix=ERR
# PERFORMANCE: setting
# PERFORMANCE: path
# PERFORMANCE: before
# PERFORMANCE: after
# PERFORMANCE-NOT: status
# PERFORMANCE: aslr
# PERFORMANCE: off
# PERFORMANCE: governor
# PERFORMANCE: performance
# PERFORMANCE: cpu_frequency
# PERFORMANCE: max
# PERFORMANCE: rdpmc
# PERFORMANCE: on
# PERFORMANCE-JSON: "setting": "governor",
# PERFORMANCE-JSON: "after": "performance"
# PERFORMANCE-JSON: "setting": "rdpmc"
# PERFORMANCE-JSON: "after": "on"
# LATENCY: setting
# LATENCY: before
# LATENCY: after
# LATENCY: aslr
# LATENCY: off
# LATENCY: governor
# LATENCY: performance
# LATENCY: cpu_frequency
# LATENCY: max
# LATENCY: rdpmc
# LATENCY: on
# LATENCY: smt
# LATENCY: off
# OVERRIDE: "setting": "aslr"
# OVERRIDE: "before":
# OVERRIDE: "after": "on"
# OVERRIDE: "setting": "smt"
# OVERRIDE: "after": "on"
# FILE: "setting": "aslr"
# FILE: "after": "on"
# THROUGHPUT: "setting": "turbo",
# THROUGHPUT: "after": "on"
# THROUGHPUT: "setting": "rdpmc"
# THROUGHPUT: "after": "on"
# THROUGHPUT: "setting": "smt"
# THROUGHPUT: "after": "on"
# RESET: "setting": "governor",
# RESET: "after": "powersave"
# ERR-NOT: Traceback
# ERR: unknown profile 'nope'
# ERR-NOT: Traceback
# ERR: use --reset instead
# ERR-NOT: Traceback
