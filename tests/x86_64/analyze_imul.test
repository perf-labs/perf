# imul r32,r32 costs 3 cycles of latency and 1 cycle of throughput on x86_64.
# The 3.00 below is the latency column and the 1.00 is the throughput column.
# REQUIRES: x86_64
# RUN: perf analyze 'imul eax, ebx' -e assembly,latency,throughput 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: imul eax, ebx 3.00 1.00
# CHECK-NOT: Traceback
