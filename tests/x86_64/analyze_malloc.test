# REQUIRES: x86_64, system-libc
# RUN: perf analyze /lib/x86_64-linux-gnu/libc.so.6:malloc -e index,assembly,latency 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: index assembly latency
# CHECK-NEXT: endbr64
# CHECK: test {{r[a-z0-9]+}}, {{r[a-z0-9]+}} 1.00
# CHECK: js
# CHECK: lea {{r[a-z0-9]+}}, [{{r[a-z0-9]+}} + 0x17] 1.00
# CHECK: and {{r[a-z0-9]+}}, 0xfffffffffffffff0 1.00
# CHECK: ret 0.00
# CHECK-NOT: Traceback
