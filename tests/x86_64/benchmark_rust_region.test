# A Rust labeled region measured on its own: only the loop runs.
# loop_begin..loop_end names the region inside work_rs.
# REQUIRES: x86_64, rustc
# RUN: rustc --edition 2021 -C opt-level=2 -C strip=debuginfo -o %t %S/benchmark_rust_region.rs && perf benchmark %t:loop_begin..loop_end -m latency -e duration_time --data.rdi=10 --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: data.rdi
# CHECK: iterations samples operations threads duration_time
# CHECK-NEXT: loop_begin..loop_end latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal 10.00 10 0 1 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
