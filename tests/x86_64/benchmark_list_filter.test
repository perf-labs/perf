# --list filters by regex on the target name: a.out --list shows all,
# a.out:hot --list shows only matching rows.
# REQUIRES: x86_64, gcc
# RUN: gcc -O2 -fPIE -pie -I%S/../../lib -o %t %S/benchmark_list_c_labels.c && perf benchmark %t --list -e kind,name 2>&1 | %FileCheck %s --check-prefix=ALL
# RUN: perf benchmark %t:hot --list -e kind,name 2>&1 | %FileCheck %s --check-prefix=FILTER
# RUN: perf analyze %t:hot --list -e kind,name 2>&1 | %FileCheck %s --check-prefix=FILTER
# RUN: perf profile -t hot --list -e kind,name -- %t 2>&1 | %FileCheck %s --check-prefix=FILTER
# ALL-NOT: Traceback
# ALL: kind name
# ALL: label hot_begin
# ALL: label hot_end
# ALL-NOT: Traceback
# FILTER-NOT: Traceback
# FILTER: kind name
# FILTER: label hot_begin
# FILTER: label hot_end
# FILTER-NOT: Traceback
