# RUN: paste -d@ %t.insns %t.bench > %t.bench.lat
# RUN: awk 'NR > 1 && $NF ~ /^[0-9.]+$/ { lat = $NF; $NF = ""; sub(/[ \t]+$/, ""); print $0 "@" lat }' %t.perf > %t.perf.lat
# RUN: awk '/Instructions:[[:space:]]*$/ { if (seen) exit; seen = 1; in_table = 1; next } in_table && /^[[:space:]]*$/ { in_table = 0; next } in_table && $2 ~ /^[0-9]+$/ { lat = $2; $1 = $2 = $3 = ""; sub(/^[ \t]+/, ""); print $0 "@" lat }' %t.mca > %t.mca.lat
# RUN: awk -F"@" 'FILENAME == ARGV[1] { perf[$1] = $2; next } FILENAME == ARGV[2] { insn = $1; if (insn ~ /^(shl|shr|sar) / && insn !~ /,/) insn = insn ", 1"; mca[insn] = $2; next } { bench[$1] = $2 } END { n = 0; bad = 0; for (insn in perf) { n++; if (!(insn in mca)) { print "missing mca latency: " insn; bad++; continue } p = perf[insn] + 0; m = mca[insn] + 0; if (p != m) { print "perf/mca mismatch: " insn " perf=" perf[insn] " mca=" mca[insn]; bad++ } if (!(insn in bench)) { print "missing benchmark latency: " insn; bad++; continue } if (bench[insn] !~ /^[0-9]+([.][0-9]+)?$/) { print "bad benchmark latency: " insn " " bench[insn]; bad++; continue } b = bench[insn] + 0; d = b - m; if (d < 0) d = -d; if (d > 0.25) { print "benchmark mismatch: " insn " benchmark=" bench[insn] " mca=" mca[insn]; bad++ } } if (n != 25) { print "expected 25 instructions, saw " n; bad++ } if (bad) exit 1; print "all " n " latencies match" }' %t.perf.lat %t.mca.lat %t.bench.lat | %FileCheck %s --check-prefix=COMPARE
# COMPARE-NOT: mismatch
# COMPARE: all 25 latencies match
# COMPARE-NOT: mismatch
# PERF-NOT: Traceback
# PERF: assembly latency
# PERF-NOT: Traceback
# MCA-NOT: error:
# MCA: Instructions:
# MCA-NOT: error:
