# shl r32,imm8 costs 1 cycle of latency and 0.50 cycles of throughput.
# The 1.00 below is the latency column and the 0.50 is the throughput column.
# REQUIRES: x86_64
# RUN: perf analyze 'shl eax, 1' -e assembly,latency,throughput 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: shl eax, 1 1.00 0.50
# CHECK-NOT: Traceback
