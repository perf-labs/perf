# The same snippet under both branch steer modes: each mode is a separate run.
# predictable and unpredictable are the config.branch values for the two runs.
# REQUIRES: x86_64
# RUN: perf benchmark 'mov eax, 42' -m latency -e duration_time --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 > %t.log 2> %t.err
# RUN: perf benchmark 'mov eax, 42' -m latency -e duration_time --config.samples=1 --config.iterations=10 --config.branch=unpredictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.unroll.count
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: operations duration_time
# CHECK-NEXT: mov eax, 42 latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.unroll.count
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: operations duration_time
# CHECK-NEXT: mov eax, 42 latency
# CHECK: unpredictable 16.00 hot hot
# CHECK: normal 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
