# REQUIRES: x86_64
# RUN: python3 -c "import json; json.dump({'file': {str(i): 'a.out@x' for i in range(40)}, 'name': {str(i): 'func' for i in range(40)}, 'mode': {str(i): 'latency' for i in range(40)}, 'operations': {str(i): 1 for i in range(40)}, 'data.rdi': {str(i): i % 4 for i in range(40)}, 'cycles': {str(i): float(10 + (i % 7)) for i in range(40)}}, open('%t.json', 'w'))"
# RUN: perf plot -e cycles -o %t.ecdf.png -- %t.json 2>&1 | %FileCheck %s --allow-empty --check-prefix=PLOT
