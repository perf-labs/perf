# Function layout config is honored and reported: order random shuffles
# functions, align 32 pads them, and both show up as config columns.
# REQUIRES: x86_64, gcc
# RUN: gcc -O2 -fPIE -pie -o %t %S/benchmark_func_config.c && perf benchmark %t:fadd -m latency -e duration_time --data.rdi=1 --data.rsi=2 --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 --config.func.order=random --config.func.align=32 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: config.func.align
# CHECK: config.func.order
# CHECK: data.rdi data.rsi
# CHECK: operations duration_time
# CHECK-NEXT: fadd latency
# CHECK: predictable 16.00 hot hot
# CHECK: 32.00 random
# CHECK: normal 1.00 2.00 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
