// REQUIRES: x86_64, gcc
// RUN: mkdir -p %t.dir
// RUN: gcc -O2 -fPIE -pie -o %t.dir/a.out %S/optimize_layout.c
// RUN: echo '{"file":"a.out","name":"track","id":"x","time":"t","info":{},"output":[{"name":"cold","iteration":0,"operations":1,"cycles":1000},{"name":"hot","iteration":0,"operations":1,"cycles":10}]}' > %t.dir/data.json
// RUN: cd %t.dir && perf optimize a.out --filter hot --output b.out --opt peephole,layout -- data.json 2>&1 | %FileCheck %s
// RUN: %t.dir/b.out
// RUN: python3 -c "import json; import subprocess; p = subprocess.run(['perf', 'optimize', '%t.dir/a.out', '--filter', 'hot', '--output', '%t.dir/c.out', '--opt', 'layout', '--json', '%t.dir/report.json', '--', '%t.dir/data.json']); assert p.returncode == 0; d = json.load(open('%t.dir/report.json')); assert d['layout']; names = [f['name'] for f in d['functions']]; assert names == ['hot'], names; print('FILTER')" 2>&1 | %FileCheck %s --check-prefix=FILTER
// CHECK-NOT: Traceback
// CHECK: name address new_address
// CHECK-NOT: cold
// CHECK: hot
// CHECK: layout: applied
// FILTER: FILTER
