# Filter on the tree entry keeps only wide-latency prologue instructions.
# The prologue register order moves with the tree build (push rbp first on
# some releases, push r15 first on others), so the kept pushes are matched
# as an unordered set.
# REQUIRES: x86_64, tree
# RUN: perf analyze /usr/bin/tree:main -e index,assembly,latency -f 'latency > 10' 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: index assembly latency
# CHECK-DAG: push r15 12.00
# CHECK-DAG: push r14 12.00
# CHECK-DAG: push rbp 12.00
# CHECK-NOT: Traceback
