# ret costs no latency itself (0.00) with 0.50 throughput in the model.
# The 0.00 below is the latency column and the 0.50 is the throughput column.
# REQUIRES: x86_64
# RUN: perf analyze 'ret' -e assembly,latency,throughput 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: ret 0.00 0.50
# CHECK-NOT: Traceback
