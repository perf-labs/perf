// RUN: echo '{"file":"a.out","name":"track","id":"x","time":"t","info":{},"output":[{"name":"cold","iteration":0,"operations":1,"cycles":1000},{"name":"hot","iteration":0,"operations":1,"cycles":10}]}' > %t.data.json
// RUN: perf optimize %t --output %t.opt --opt layout -- %t.data.json 2>&1 | %FileCheck %s
