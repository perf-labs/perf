# mov r32,imm32 costs 1 cycle of latency and 0.20 cycles of throughput.
# The 1.00 below is the latency column and the 0.20 is the throughput column.
# REQUIRES: x86_64
# RUN: perf analyze 'mov eax, 42' -e assembly,latency,throughput 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: mov eax, 0x2a 1.00 0.20
# CHECK-NOT: Traceback
