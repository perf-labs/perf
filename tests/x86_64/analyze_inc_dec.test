# REQUIRES: x86_64
# RUN: perf analyze 'inc eax' -e assembly,latency,throughput > %t.log 2> %t.err
# RUN: perf analyze 'dec eax' -e assembly,latency,throughput >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: inc eax 1.00 0.20
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: dec eax 1.00 0.20
# CHECK-NOT: Traceback
