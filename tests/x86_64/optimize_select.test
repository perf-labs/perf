// REQUIRES: x86_64, gcc
// RUN: mkdir -p %t.dir
// RUN: gcc -O2 -fPIE -pie -o %t.dir/a.out %S/optimize_layout.c
// RUN: echo '{"file":"a.out","name":"track","id":"x","time":"t","info":{},"output":[{"name":"cold","iteration":0,"operations":1,"cycles":1000},{"name":"hot","iteration":0,"operations":1,"cycles":10}]}' > %t.dir/data.json
// RUN: cd %t.dir && perf optimize a.out --output b.out --opt peephole,layout -- data.json 2>&1 | %FileCheck %s --check-prefix=TABLE
// RUN: %t.dir/b.out
// RUN: cd %t.dir && perf optimize a.out --output c.out --opt layout --json report.json -- data.json
// RUN: python3 -c "import json; d = json.load(open('%t.dir/report.json')); assert d['layout']; names = [f['name'] for f in d['functions']]; assert {'hot', 'cold', 'main'} <= set(names), names; print('NOFILTER')" 2>&1 | %FileCheck %s --check-prefix=JSON
// RUN: cd %t.dir && not perf optimize a.out --select hot --output d.out -- data.json 2>&1 | %FileCheck %s --check-prefix=NOSELECT
// TABLE-NOT: Traceback
// TABLE: name address new_address
// TABLE-DAG: hot
// TABLE-DAG: cold
// TABLE: layout: applied
// TABLE-NOT: Traceback
// JSON: NOFILTER
// NOSELECT-NOT: Traceback
// NOSELECT: unknown argument: --select
