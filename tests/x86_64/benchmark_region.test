# A labeled region measured on its own: only the instructions between the
# labels run, so hot_begin..hot_end below names the add without the call.
# data.rdi and data.rsi below pin the region inputs for the run.
# REQUIRES: x86_64, gcc
# RUN: gcc -O2 -fPIE -pie -I%S/../../lib -o %t %S/benchmark_region.c && perf benchmark %t:hot_begin..hot_end -m latency -e duration_time --data.rdi=1 --data.rsi=2 --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: data.rdi
# CHECK: data.rsi
# CHECK: operations duration_time
# CHECK-NEXT: hot_begin..hot_end latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal 1.00 2.00 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
