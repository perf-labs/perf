# Cache misses count real L1 misses on a cold load. The value itself
# depends on live counters, so this pins the plumbing: the event column is
# recorded in the envelope whether or not this run could read it.
# REQUIRES: x86_64, pmu
# RUN: perf benchmark 'mov eax, [rdi]' -m latency -e cache-misses --data.rdi=0x41000000000 --data[0x41000000000]=42 --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=cold --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 --json %t.misses.json && cat %t.misses.json 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: "cache-misses"
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
