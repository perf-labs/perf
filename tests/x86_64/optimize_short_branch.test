// REQUIRES: x86_64, gcc
// RUN: gcc -O2 -fPIE -pie -o %t %S/optimize_short_branch.s
// RUN: echo '{"file":"a.out","name":"track","id":"x","time":"t","info":{},"output":[{"name":"h","iteration":0,"operations":1,"cycles":100}]}' > %t.data.json
// RUN: perf optimize %t --output %t.opt --opt layout --json %t.report.json -- %t.data.json
// RUN: %t
// RUN: %t.opt
// RUN: python3 -c "import json; d = json.load(open('%t.report.json')); assert not d['layout'], d; assert 'safe fallback' in d['layout_skipped'], d['layout_skipped']; assert all(v == 0 for v in d['fixups'].values()), d['fixups']; print('SAFE')" 2>&1 | %FileCheck %s
// CHECK-NOT: Traceback
// CHECK: SAFE
