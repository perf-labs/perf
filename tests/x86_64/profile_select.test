# REQUIRES: x86_64, gcc, pmu
# RUN: gcc -O2 -fno-inline -fPIE -pie -I%S/../../lib -o %t %S/profile_labels.c
# RUN: perf profile -s loop_begin..loop_end -e cycles -o %t.json -- %t > %t.log 2> %t.err
# RUN: perf profile -s loop_begin..loop_end -e cycles -o none -- %t >> %t.log 2>> %t.err
# RUN: cat %t.json %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: "name": "loop_begin..loop_end"
# CHECK: "address":
# CHECK: name iteration operations cycles address tid threads file mode
# CHECK-NEXT: loop_begin..loop_end
# CHECK: tracked {{[0-9]+}} samples
# CHECK-NOT: Traceback
