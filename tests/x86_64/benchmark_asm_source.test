# REQUIRES: x86_64
# RUN: perf benchmark %S/benchmark_asm_source.s:asm_bench -m latency -e duration_time --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: operations duration_time
# CHECK-NEXT: asm_bench latency
# CHECK: predictable 16.00 hot hot
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
