# REQUIRES: x86_64
# RUN: perf benchmark 'idiv ecx' --backend loop --data.eax=100 --data.edx=0 --data.ecx=42 -m latency -e duration_time --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: data.eax
# CHECK: operations duration_time
# CHECK-NEXT: idiv ecx latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal 100.00 42.00 0.00 100.00 42.00 0.00 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
