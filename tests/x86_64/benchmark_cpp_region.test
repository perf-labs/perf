# A C++ labeled region measured on its own: only the add runs, not the call.
# hot_begin..hot_end names the region; data columns pin the region inputs.
# REQUIRES: x86_64, g++
# RUN: g++ -O2 -fPIE -pie -I%S/../../lib -o %t %S/benchmark_cpp_region.cpp && perf benchmark %t:hot_begin..hot_end -m latency -e duration_time --data.rdi=1 --data.rsi=2 --config.samples=1 --config.iterations=10 --config.branch=predictable --config.dcache=hot --config.dtlb=hot --config.icache=hot --config.itlb=hot --config.code.align=16 2>&1 | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
# CHECK: file name mode
# CHECK: config.backend.loop.probes
# CHECK: config.branch
# CHECK: config.dcache
# CHECK: data.rdi
# CHECK: data.rsi
# CHECK: operations duration_time
# CHECK-NEXT: hot_begin..hot_end latency
# CHECK: predictable 16.00 hot hot
# CHECK: normal 1.00 2.00 1 {{[0-9.]+(ns|us|ms|s)}}
# CHECK-NOT: Traceback
# CHECK-NOT: faulted
