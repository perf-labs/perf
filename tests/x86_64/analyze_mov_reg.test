# REQUIRES: x86_64
# RUN: perf analyze 'mov eax, ebx' -e assembly,latency,throughput > %t.log 2> %t.err
# RUN: perf analyze 'movsxd rax, ebx' -e assembly,latency,throughput >> %t.log 2>> %t.err
# RUN: cat %t.log %t.err | %FileCheck %s
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: mov eax, ebx 1.00 0.20
# CHECK-NOT: Traceback
# CHECK: assembly latency throughput
# CHECK-NEXT: movsxd rax, ebx 1.00 0.20
# CHECK-NOT: Traceback
